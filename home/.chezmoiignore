run_once_49-install-dev-tools.sh.tmpl
{{ end }}
{{/* A gaming PC gets the shell, git, prompt, SSH and Claude Code layer and
     nothing that builds, deploys or runs agents unattended. Scripts are
     listed by *target* name (the source name minus run_*_ attributes and
     .tmpl), because that is what chezmoi matches ignore patterns against: a
     source-name entry matches nothing and the script still runs.
     work-identity is ignored because it is the only encrypted_ target, and a
     fresh gaming machine has no age identity to decrypt it with — leaving it
     managed would fail the bootstrap apply. */}}
