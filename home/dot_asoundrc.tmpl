{{ if or (eq .chezmoi.os "linux") .isWSL -}}
# Redirects the ALSA default device to PulseAudio, so SoX (and anything else
# using ALSA directly, e.g. Claude Code voice mode) picks up audio from
# whatever PULSE_SERVER points at — including a reverse-tunnelled remote
# server (see docs/voice-mode-ssh.md). No-op if PulseAudio isn't running.
pcm.!default {
    type pulse
}
ctl.!default {
    type pulse
}
{{- end -}}
