# shellcheck disable=SC1090,SC1091  # rc file: all sourced paths are runtime-dynamic by design
# Not running interactively? Stop here.
case $- in
    *i*) ;;
    *) return ;;
esac

# Elevated launchers (a Windows Terminal profile with "elevate", runas, an admin
# shortcut) hand the shell C:\Windows\System32 as its cwd. Starship rescans cwd
# for its detection-gated modules on every prompt, and a cold scan of System32's
# ~5000 entries takes ~16s — past any scan_timeout worth setting, so the prompt
# warns and silently drops those modules. Runs before the rest of init because
# zoxide caches pwd at load time.
case "${PWD,,}" in
    /?/windows/system32) cd "$HOME" || : ;;
esac

# Shared config; local.sh is unmanaged machine-local config and stays last
# so its definitions override the managed files.
for f in "$HOME/.config/shell/exports.sh" "$HOME/.config/shell/aliases.sh" "$HOME/.config/shell/functions.sh" "$HOME/.config/shell/local.sh"; do
    [ -r "$f" ] && source "$f"
done

# Worktree helpers (gwt/gwta/wtd/wtclean). Bash-only — the script uses mapfile
# and 0-indexed arrays, so .zshrc deliberately leaves it out.
[ -r "$HOME/.claude/scripts/worktree-helpers.sh" ] && source "$HOME/.claude/scripts/worktree-helpers.sh"

# History
HISTSIZE=10000
HISTFILESIZE=20000
HISTCONTROL=ignoredups:ignorespace
shopt -s histappend
shopt -s checkwinsize

# Prompt — starship supersedes PS1 when present; the literal stays as the fallback
# so a machine without it still gets a readable prompt.
PS1='\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '
if command -v starship &>/dev/null; then eval "$(starship init bash)"; fi

# Windows Terminal reads cwd from OSC 9;9 so duplicate tab/pane opens here;
# cygpath guard keeps this a no-op outside Git Bash (Linux, WSL).
if [ -n "$WT_SESSION" ] && command -v cygpath >/dev/null 2>&1; then
    PROMPT_COMMAND=${PROMPT_COMMAND:+"$PROMPT_COMMAND; "}'printf "\e]9;9;%s\e\\" "$(cygpath -w "$PWD")"'
fi

# zoxide (provides `z`) hooks PROMPT_COMMAND, so it initialises after the block above
if command -v zoxide &>/dev/null; then
    eval "$(zoxide init bash)"
    # zoxide 0.10.0 emits `cygpath -w "\builtin pwd -L"` in its Windows init: the
    # command substitution is missing, so the hook feeds cygpath a literal and
    # every directory change errors with `not a directory: F:\builtin pwd -L`.
    # Redefining restores the substitution and reseeds the poisoned cached pwd.
    if command -v cygpath >/dev/null 2>&1; then
        __zoxide_pwd() { \command cygpath -w "$(\builtin pwd -L)"; }
        __zoxide_oldpwd="$(__zoxide_pwd)"
    fi
fi

# nvm
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ]          && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# pyenv
if command -v pyenv &>/dev/null; then eval "$(pyenv init -)"; fi

# sdkman (must stay near bottom)
export SDKMAN_DIR="$HOME/.sdkman"
[[ -s "$SDKMAN_DIR/bin/sdkman-init.sh" ]] && source "$SDKMAN_DIR/bin/sdkman-init.sh"

# cargo
[ -s "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"
