{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "gpu-stack": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "gpu-stack (LAN)",
      "options": {
        "baseURL": "http://192.168.1.50:8000/v1",
        "apiKey": "dummy"
      },
      "models": {
        "qwen/qwen3-coder-30b-a3b": {
          "name": "Qwen3 Coder 30B A3B",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    },
    "nvidia": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NVIDIA NIM",
      "options": {
        "baseURL": "https://integrate.api.nvidia.com/v1",
        "apiKey": "{env:PLATFORMCTL_JDWLABS_NVIDIA_API_KEY}"
      },
      "models": {
        "deepseek-ai/deepseek-v4-pro": { "name": "DeepSeek V4 Pro" },
        "deepseek-ai/deepseek-v4-flash": { "name": "DeepSeek V4 Flash" },
        "qwen/qwen3.5-397b-a17b": { "name": "Qwen3.5 397B A17B" },
        "qwen/qwen3-coder-480b-a35b-instruct": { "name": "Qwen3 Coder 480B A35B" },
        "z-ai/glm-5.2": { "name": "GLM 5.2" },
        "minimaxai/minimax-m3": { "name": "MiniMax M3" },
        "moonshotai/kimi-k2.6": { "name": "Kimi K2.6" },
        "nvidia/nemotron-3-ultra-550b-a55b": { "name": "Nemotron 3 Ultra 550B" },
        "mistralai/mistral-nemotron": { "name": "Mistral Nemotron" }
      }
    }
  }
}
