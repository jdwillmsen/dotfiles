{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/glm-5.3-flash-free",
  "provider": {
    "gpu-stack": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "gpu-stack (LAN)",
      "options": {
        "baseURL": "http://192.168.1.50:8000/v1",
        "apiKey": "dummy"
      },
      "models": {
        "local-chat": {
          "name": "Qwen3 Coder 30B A3B (local)",
          "tool_call": true,
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    },
