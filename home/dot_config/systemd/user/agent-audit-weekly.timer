[Unit]
Description=Weekly agent usage audit

[Timer]
OnCalendar=Mon *-*-* 08:00:00
Unit=agent-audit@weekly.service
# A box that was off at the scheduled time runs the missed audit at next boot
# instead of silently skipping a window.
Persistent=true
RandomizedDelaySec=5min

[Install]
WantedBy=timers.target
