[Unit]
Description=Agent usage audit (%i window)
Documentation=file://%h/.local/share/chezmoi/docs/agent-audit.md

[Service]
Type=oneshot
ExecStart=%h/.local/bin/agent-audit --window %i
# A user manager starts with a bare PATH; claude lives in ~/.local/bin, and gh
# and kubectl in /usr/bin.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Bounds the whole run: a quarterly transcript scan, two GitHub searches per
# window, the insights call (itself capped at 240s) and the Jira calls.
TimeoutStartSec=20min
NoNewPrivileges=yes
PrivateTmp=yes
Nice=10
IOSchedulingClass=idle
