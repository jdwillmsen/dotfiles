[Unit]
Description=Agent session labelling
Documentation=file://%h/.local/share/chezmoi/docs/agent-label.md

[Service]
Type=oneshot
ExecStart=%h/.local/bin/agent-label run
# A user manager starts with a bare PATH; git lives in /usr/bin.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# The run stops labelling after 20 minutes of its own clock and publishes in
# batches; the rest of this allows up to ten minutes waiting on another store
# writer's lock, a last push, and a call still in flight.
TimeoutStartSec=45min
NoNewPrivileges=yes
PrivateTmp=yes
Nice=10
IOSchedulingClass=idle
