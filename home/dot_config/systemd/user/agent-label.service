[Unit]
Description=Agent session labelling
Documentation=file://%h/.local/share/chezmoi/docs/agent-label.md

[Service]
Type=oneshot
ExecStart=%h/.local/bin/agent-label run
# A user manager starts with a bare PATH; git lives in /usr/bin.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Bounds the whole run: up to ten minutes waiting on another store writer's
# lock, then at most 200 labeller calls and one push.
TimeoutStartSec=45min
NoNewPrivileges=yes
PrivateTmp=yes
Nice=10
IOSchedulingClass=idle
