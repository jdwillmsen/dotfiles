[Unit]
Description=Agent metrics daily collect
Documentation=file://%h/.local/share/chezmoi/docs/agent-metrics.md

[Service]
Type=oneshot
ExecStart=%h/.local/bin/agent-metrics collect
# A user manager starts with a bare PATH; git lives in /usr/bin.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Bounds the whole run: up to ten minutes waiting on another collect's lock,
# then the transcript scan and one push.
TimeoutStartSec=20min
NoNewPrivileges=yes
PrivateTmp=yes
Nice=10
IOSchedulingClass=idle
