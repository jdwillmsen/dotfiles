[Unit]
Description=Weekly agent metrics digest

[Timer]
# After the Monday 08:40 weekly report has written the report the digest reads.
# Same zone as that timer (box-local): pinned to UTC, a box behind UTC would
# post before the report and announce it a week late.
OnCalendar=Mon *-*-* 09:10:00
Unit=agent-notify-digest.service
# A box that was off on Monday sends at next boot; the service orders itself
# after the weekly report queued by the same catch-up, so the digest reads
# that week's report rather than re-finding last week's.
Persistent=true

[Install]
WantedBy=timers.target
