[Unit]
Description=Every-other-week agent metrics report

[Timer]
# After the 06:30 collect, so the window is already in the store, and after the
# audit timer whose config inventory the longer reports embed.
OnCalendar=Mon *-*-* 08:50:00
Unit=agent-report@biweekly.service
# OnCalendar has no "every other week", so this fires every Monday. The tool
# targets the last complete fortnight on a fixed grid, so an off-week firing
# rewrites that report with identical numbers.
# A box that was off at the scheduled time runs the missed report at next boot
# instead of silently skipping a window.
Persistent=true

[Install]
WantedBy=timers.target
