[Unit]
Description=Agent metrics trends page
Documentation=file://%h/.local/share/chezmoi/docs/agent-trends.md

[Service]
Type=oneshot
ExecStart=%h/.local/bin/agent-trends build
# A user manager starts with a bare PATH; git lives in /usr/bin.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Bounds the page build, up to ten minutes waiting on a collect's lock, and
# one push.
TimeoutStartSec=20min
NoNewPrivileges=yes
PrivateTmp=yes
Nice=10
IOSchedulingClass=idle
