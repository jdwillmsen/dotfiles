[Unit]
Description=Probe the Claude Code Router every minute and restart it if dead

[Timer]
# Covers the cold-boot case: with linger on, this is what starts the router on
# a headless box nobody has logged into yet.
OnBootSec=30s
OnUnitActiveSec=1min
# No Persistent=: systemd only honours it for OnCalendar= timers, so on a
# monotonic timer it buys nothing. OnBootSec covers the machine-was-off case
# this would otherwise be reached for.
AccuracySec=5s

[Install]
WantedBy=timers.target
