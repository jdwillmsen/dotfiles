{{- /* `include` resolves paths relative to the source dir, not the applied
       destination — it can't read the plaintext target this decrypts to.
       Decrypt the source .age file directly instead. */ -}}
{{- $workIdentity := dict -}}
{{- if eq .machineRole "work" -}}
{{-   $workIdentity = include "dot_config/private_git/encrypted_work-identity.age" | decrypt | fromYaml -}}
{{- end -}}
{{- /* Only the base layer: ~/.gitconfig -> ~/.gitconfig.local -> ~/.gitconfig-<profile>,
       the latter two unmanaged and selected per gitdir. Defaults here are what a repo
       gets when no machine-local layer claims it, so they use the GitHub noreply
       address — a real address reaching public history is not recoverable. */ -}}
[user]
    name = Jake Willmsen
{{- if eq .machineRole "work" }}
    email = {{ $workIdentity.email | default "42048994+jdwillmsen@users.noreply.github.com" }}
    signingkey = {{ $workIdentity.signingkey | default "949C342C7907CC24" }}
{{- else }}
    email = 42048994+jdwillmsen@users.noreply.github.com
    signingkey = 949C342C7907CC24
{{- end }}

[commit]
    gpgsign = {{ if .isEphemeral }}false{{ else }}true{{ end }}

[tag]
    gpgsign = {{ if .isEphemeral }}false{{ else }}true{{ end }}

[core]
    editor = nano
    autocrlf = input
    excludesfile = ~/.gitignore_global
    whitespace = fix,trailing-space,cr-at-eol
{{- if lookPath "delta" }}
    pager = delta

{{/* Guarded on delta resolving at apply time: naming a pager that is not on PATH
     breaks every paging command, so an un-provisioned machine gets no delta config
     at all. Installed after a first apply, it takes effect on the next one. */ -}}
[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    line-numbers = true

[merge]
    conflictstyle = zdiff3
{{- end }}

[init]
    defaultBranch = main

[pull]
    rebase = false

[push]
    default = current
    autoSetupRemote = true

[fetch]
    prune = true

[diff]
    colorMoved = zebra

[merge]
    conflictstyle = diff3

[alias]
    st  = status
    co  = checkout
    br  = branch
    sw  = switch
    swc = switch -c
    lg  = log --oneline --graph --decorate --all
    last = log -1 HEAD --stat
    undo = reset HEAD~1 --mixed
    aliases = config --get-regexp alias

[color]
    ui = auto

[credential]
{{- if .isEphemeral }}
    helper =
{{- else if or .isWSL (eq .chezmoi.os "windows") }}
    helper = manager
{{- else }}
    helper = libsecret
{{- end }}

{{- /* Must stay the last section: git applies later values over earlier
       ones, so machine-local overrides only win from the bottom. */}}
[include]
    path = ~/.gitconfig.local
