#!/usr/bin/env bash
# agent-browser: a persistent, logged-in Chrome that agents drive over CDP
# while the human does every login through a noVNC viewer.
#
# Security model:
# - Agents never handle credentials or cookies; the human signs in through
#   the viewer and the session persists in the profile.
# - CDP grants full control of every logged-in session, so it binds to
#   127.0.0.1 only. Anyone with a shell as this user can still use it.
# - VNC binds to localhost; only websockify is reachable, on the tailnet
#   address only, never 0.0.0.0, and the last lease's stop closes it.
#
# Concurrency: several agents share the browser through leases. Each lease
# owns one tab; the browser stays up until the last live lease is released.
# A slot is an isolated browser (own display, ports, viewer and profile) for
# agents that must not share cookies or a site with another agent.
#
# See docs/agent-browser.md.
set -uo pipefail

PROFILE_BASE="${AGENT_BROWSER_PROFILE:-$HOME/.cache/agent-browser}"
RUN_BASE="${AGENT_BROWSER_RUN:-${XDG_RUNTIME_DIR:-/tmp/agent-browser-$UID}/agent-browser}"
LIB_DIR="${AGENT_BROWSER_LIB:-$HOME/.local/share/agent-browser}"
NOVNC_DIR="${AGENT_BROWSER_NOVNC_DIR:-/usr/share/novnc}"
MAX_SLOTS="${AGENT_BROWSER_MAX_SLOTS:-4}"
LEASE_TTL="${AGENT_BROWSER_LEASE_TTL:-7200}"  # seconds without use before a lease is stale
LEASES="$RUN_BASE/leases"
COMPONENTS="xvfb chrome vnc web"

err() {  # err CODE MESSAGE [HINT]
    printf 'error: %s\nmessage: %s\n' "$1" "$2"
    [ $# -lt 3 ] || printf 'help[1]:\n  %s\n' "$3"
    exit 1
}

# Slot 0 keeps the original paths and ports, so existing logins and tools
# that hardcode 9222 keep working; slot N shifts every port by N.
canon_slot() {  # canonical non-negative decimal slot, no leading zeros; fails on non-numeric
    case "${1:-}" in ''|*[!0-9]*) return 1 ;; esac
    [ "${#1}" -le 9 ] || return 1
    printf '%s' "$((10#$1))"
}

# Shared slot-flag parser for every subcommand: --slot N and --slot=N;
# sets SLOT_VALUE + SLOT_SHIFT and returns 0 on a slot flag, else returns 1.
slot_flag() {
    case "${1:-}" in
        --slot)
            [ $# -ge 2 ] || err usage "--slot needs a value" "agent-browser <command> --slot N"
            SLOT_VALUE="${2:-}"; SLOT_SHIFT=2; return 0 ;;
        --slot=*) SLOT_VALUE="${1#*=}"; SLOT_SHIFT=1; return 0 ;;
        *) return 1 ;;
    esac
}

use_slot() {
    local raw="${1:-}"
    case "$raw" in ''|*[!0-9]*) err usage "slot must be a number or auto" "agent-browser start --slot auto" ;; esac
    [ "${#raw}" -le 9 ] || err usage "slot $raw is beyond AGENT_BROWSER_MAX_SLOTS=$MAX_SLOTS"
    SLOT=$((10#$raw))
    [ "$SLOT" -lt "$MAX_SLOTS" ] || err usage "slot $SLOT is beyond AGENT_BROWSER_MAX_SLOTS=$MAX_SLOTS"
    DISPLAY_NUM=$(( ${AGENT_BROWSER_DISPLAY:-99} + SLOT ))
    CDP_PORT=$(( ${AGENT_BROWSER_CDP_PORT:-9222} + SLOT ))
    VNC_PORT=$(( ${AGENT_BROWSER_VNC_PORT:-5900} + SLOT ))
    WEB_PORT=$(( ${AGENT_BROWSER_WEB_PORT:-6080} + SLOT ))
    if [ "$SLOT" -eq 0 ]; then
        PROFILE="$PROFILE_BASE"; RUN="$RUN_BASE"
    else
        PROFILE="$PROFILE_BASE-slot$SLOT"; RUN="$RUN_BASE/slot$SLOT"
    fi
}

alive() { [ -f "$RUN/$1.pid" ] && kill -0 "$(cat "$RUN/$1.pid")" 2>/dev/null; }

up_count() {
    local c n=0
    for c in $COMPONENTS; do alive "$c" && n=$((n + 1)); done
    echo "$n"
}

lock() {  # serialise start/stop so two agents never launch or kill a slot at once
    mkdir -p "$RUN_BASE"; chmod 700 "$RUN_BASE"
    exec 9>"$RUN_BASE/.lock"
    flock -w 120 9 || err busy "another agent-browser start/stop held the lock for 2 minutes" "agent-browser"
}

lease_get() { sed -n "s/^$2=//p" "$LEASES/$1" 2>/dev/null | tail -n1; }

lease_live() {  # a lease is live while it exists, has a numeric slot, and was used within LEASE_TTL
    local f="$LEASES/$1" age slot
    [ -f "$f" ] || return 1
    slot="$(lease_get "$1" slot)"
    case "$slot" in ''|*[!0-9]*) return 1 ;; esac
    age=$(( $(date +%s) - $(stat -c %Y "$f") ))
    [ "$age" -le "$LEASE_TTL" ]
}

live_leases() {  # live_leases SLOT -> lease ids, one per line; canonical slot match
    local want="$1" f id have
    want="$(canon_slot "$want" 2>/dev/null || true)"
    [ -n "$want" ] || return 0
    for f in "$LEASES"/*; do
        [ -f "$f" ] || continue
        id="${f##*/}"
        lease_live "$id" || continue
        have="$(canon_slot "$(lease_get "$id" slot)" 2>/dev/null || true)"
        [ "$have" = "$want" ] && echo "$id"
    done
    return 0
}

prune_leases() {  # drop stale leases and close their tabs, which nothing else would reach; caller must hold lock
    local f id port slot target
    for f in "$LEASES"/*; do
        [ -f "$f" ] || continue
        id="${f##*/}"
        lease_live "$id" && continue
        slot="$(lease_get "$id" slot)"
        target="$(lease_get "$id" target)"
        case "$slot" in ''|*[!0-9]*) slot="" ;; esac
        [ "${#slot}" -le 9 ] || slot=""
        if [ -n "$slot" ] && [ -n "$target" ]; then
            port=$(( ${AGENT_BROWSER_CDP_PORT:-9222} + 10#$slot ))
            curl -fsS --max-time 5 "http://127.0.0.1:$port/json/close/$target" >/dev/null 2>&1 || true
        fi
        rm -f "$f"
    done
}

need_lease() {  # need_lease ID -> selects its slot, refreshes it
    local id="${1:-}"
    [ -n "$id" ] || err usage "a lease id is required" "agent-browser start   # prints lease:"
    lease_live "$id" || err unknown_lease "lease $id does not exist or expired" "agent-browser start [URL]   # take a new lease"
    use_slot "$(lease_get "$id" slot)"
    lease_live "$id" || err unknown_lease "lease $id does not exist or expired" "agent-browser start [URL]   # take a new lease"
    touch -c "$LEASES/$id"
}

cdp() {  # cdp METHOD PATH [curl args...]
    curl -fsS --max-time 10 -X "$1" "http://127.0.0.1:$CDP_PORT$2" "${@:3}"
}

new_tab() {  # new_tab URL -> target id
    cdp PUT /json/new -G --data-urlencode "=$1" | sed -n 's/.*"id": *"\([^"]*\)".*/\1/p' | head -n1
}

tailnet_ip() {
    [ -n "${AGENT_BROWSER_BIND:-}" ] && { echo "$AGENT_BROWSER_BIND"; return; }
    command -v tailscale >/dev/null 2>&1 || return 1
    tailscale ip -4 2>/dev/null | head -n1
}

launch() {  # launch NAME CMD... ; detached, pid recorded
    # 9>&-: a daemon that inherits the lock fd would hold the lock forever.
    "${@:2}" >"$RUN/$1.log" 2>&1 9>&- &
    echo $! >"$RUN/$1.pid"
}

auto_slot() {  # first isolated slot no live lease holds, preferring one whose profile has logins
    local s free=""
    # Slot 0 is the shared slot every plain start joins, so it never isolates.
    for ((s = 1; s < MAX_SLOTS; s++)); do
        [ -z "$(live_leases "$s")" ] || continue
        use_slot "$s"
        [ -d "$PROFILE" ] && { echo "$s"; return; }
        [ -n "$free" ] || free="$s"
    done
    [ -n "$free" ] || err no_free_slot "all $((MAX_SLOTS - 1)) isolated slots hold live leases" "agent-browser start [URL]   # share slot 0 in its own tab instead"
    echo "$free"
}

bring_up() {
    local ip
    for bin in Xvfb google-chrome x11vnc websockify curl flock; do
        command -v "$bin" >/dev/null 2>&1 || err missing_dependency "$bin not found" "see docs/agent-browser.md for the packages"
    done
    ip="$(tailnet_ip)" || true
    [ -n "$ip" ] || err no_tailnet "no tailnet IPv4 address; the viewer never binds anywhere else" "tailscale up"
    mkdir -p "$RUN" "$PROFILE"; chmod 700 "$RUN" "$PROFILE"

    alive xvfb || { launch xvfb Xvfb ":$DISPLAY_NUM" -screen 0 1440x900x24 -nolisten tcp; sleep 1; }
    alive chrome || {
        # Background tabs must keep running at full speed: every lease but the
        # one in front is a background tab.
        DISPLAY=":$DISPLAY_NUM" launch chrome google-chrome --user-data-dir="$PROFILE" \
            --remote-debugging-address=127.0.0.1 --remote-debugging-port="$CDP_PORT" \
            --no-first-run --no-default-browser-check --window-size=1440,900 --start-maximized \
            --disable-background-timer-throttling --disable-renderer-backgrounding \
            --disable-backgrounding-occluded-windows about:blank
    }
    alive vnc || { launch vnc x11vnc -display ":$DISPLAY_NUM" -localhost -rfbport "$VNC_PORT" -forever -shared -nopw -quiet; sleep 1; }
    alive web || launch web websockify --web "$NOVNC_DIR" "$ip:$WEB_PORT" "localhost:$VNC_PORT"
    echo "$ip" >"$RUN/bind"
    local i
    for ((i = 0; i < 30; i++)); do cdp GET /json/version >/dev/null 2>&1 && return; sleep 1; done
    err cdp_unreachable "chrome did not open CDP on 127.0.0.1:$CDP_PORT" "agent-browser stop --force --slot $SLOT && agent-browser start --slot $SLOT"
}

shut_down() {
    local c n=0
    for c in web vnc chrome xvfb; do
        if alive "$c"; then kill "$(cat "$RUN/$c.pid")" 2>/dev/null && n=$((n + 1)); fi
        rm -f "$RUN/$c.pid"
    done
    rm -f "$RUN/bind"
    local id
    for id in $(live_leases "$SLOT"); do rm -f "$LEASES/$id"; done
    echo "$n"
}

print_lease() {  # print_lease ID
    local ip
    ip="$(cat "$RUN/bind" 2>/dev/null)"
    printf 'lease: %s\nslot: %s\ntarget: %s\ncdp: http://127.0.0.1:%s\nviewer: http://%s:%s/vnc.html\nprofile: %s\n' \
        "$1" "$SLOT" "$(lease_get "$1" target)" "$CDP_PORT" "$ip" "$WEB_PORT" "$PROFILE"
    printf 'help[4]:\n  agent-browser py %s script.py   # script: from agent_browser import page\n' "$1"
    printf '  agent-browser check <github|linkedin|URL> --lease %s\n' "$1"
    printf '  agent-browser show %s   # bring this tab to the front of the viewer\n' "$1"
    printf '  agent-browser stop %s   # at task end; closes only this tab\n' "$1"
}

cmd_start() {
    local url="about:blank" slot="0" id target
    while [ $# -gt 0 ]; do
        if slot_flag "$@"; then slot="$SLOT_VALUE"; shift "$SLOT_SHIFT"; continue; fi
        case "$1" in
            -*) err usage "unknown option $1" "agent-browser start [--slot N|auto] [URL]" ;;
            *) url="$1"; shift ;;
        esac
    done
    lock
    mkdir -p "$LEASES"; chmod 700 "$LEASES"
    prune_leases
    if [ "$slot" = auto ]; then
        slot="$(auto_slot)" || { printf '%s\n' "$slot"; exit 1; }
    fi
    use_slot "$slot"
    bring_up
    target="$(new_tab "$url")"
    [ -n "$target" ] || err cdp_failed "could not open a tab over CDP on port $CDP_PORT" "agent-browser status --slot $SLOT"
    id="s$SLOT-$(od -An -N3 -tx1 /dev/urandom | tr -d ' \n')"
    printf 'slot=%s\ntarget=%s\ncreated=%s\n' "$SLOT" "$target" "$(date +%s)" >"$LEASES/$id"
    print_lease "$id"
}

cmd_stop() {
    local id="" force=0 slot="0" others n
    local id_known=0 id_live=0 id_expired=0 id_slot="" id_on_slot=0
    while [ $# -gt 0 ]; do
        if slot_flag "$@"; then slot="$SLOT_VALUE"; shift "$SLOT_SHIFT"; continue; fi
        case "$1" in
            --force) force=1; shift ;;
            -*) err usage "unknown option $1" "agent-browser stop <lease> | stop --force [--slot N]" ;;
            *) id="$1"; shift ;;
        esac
    done
    lock
    if [ -n "$id" ]; then
        if [ -f "$LEASES/$id" ]; then
            id_slot="$(lease_get "$id" slot)"
            case "$id_slot" in ''|*[!0-9]*) id_slot="" ;; *) id_known=1 ;; esac
        fi
        if lease_live "$id"; then
            id_live=1
        elif [ "$id_known" -eq 1 ]; then
            id_expired=1
        fi
    fi
    prune_leases
    if [ -n "$id" ] && [ "$id_live" -eq 0 ]; then
        use_slot "$slot"
        printf 'released: none (lease %s already gone)\n' "$id"
        if [ "$id_known" -eq 0 ]; then
            err unknown_lease "lease $id does not exist or expired" "agent-browser start [URL]   # take a new lease"
        fi
        others="$(live_leases "$SLOT" | wc -l)"
        if [ "$id_expired" -eq 1 ] && [ "$(canon_slot "$id_slot" 2>/dev/null || true)" = "$SLOT" ]; then
            id_on_slot=1
        fi
        if [ "$others" -eq 0 ] && { [ "$id_on_slot" -eq 1 ] || [ "$force" -eq 1 ]; }; then
            n="$(shut_down)"
            printf 'slot: %s\nstopped: %d\nprofile: %s (kept; sessions persist)\n' "$SLOT" "$n" "$PROFILE"
        else
            printf 'slot: %s\nstate: kept (in use by %d other lease(s))\nprofile: %s\n' "$SLOT" "$others" "$PROFILE"
            printf 'help[1]:\n  agent-browser stop <lease>   # release only your own lease\n'
        fi
        return
    fi
    if [ -n "$id" ]; then
        use_slot "$(lease_get "$id" slot)"
        cdp GET "/json/close/$(lease_get "$id" target)" >/dev/null 2>&1 || true
        rm -f "$LEASES/$id"
        printf 'released: %s\n' "$id"
    else
        use_slot "$slot"
    fi
    others="$(live_leases "$SLOT" | wc -l)"
    if [ "$force" -eq 0 ] && [ "$others" -gt 0 ]; then
        printf 'slot: %s\nstate: kept (in use by %d other lease(s))\nprofile: %s\n' "$SLOT" "$others" "$PROFILE"
        printf 'help[1]:\n  agent-browser stop <lease>   # release only your own lease\n'
        return
    fi
    n="$(shut_down)"
    printf 'slot: %s\nstopped: %d\nprofile: %s (kept; sessions persist)\n' "$SLOT" "$n" "$PROFILE"
}

slot_line() {  # slot_line N -> "N,state,leases,viewer"
    local up ip state viewer=-
    use_slot "$1"
    up="$(up_count)"
    case "$up" in 4) state=running ;; 0) state=stopped ;; *) state="partial($up/4)" ;; esac
    if [ "$up" -eq 4 ]; then ip="$(cat "$RUN/bind" 2>/dev/null)"; viewer="http://$ip:$WEB_PORT/vnc.html"; fi
    printf '  %s,%s,%s,%s\n' "$SLOT" "$state" "$(live_leases "$SLOT" | wc -l)" "$viewer"
}

cmd_status() {
    local slot="0" c up ip s
    while [ $# -gt 0 ]; do
        if slot_flag "$@"; then slot="$SLOT_VALUE"; shift "$SLOT_SHIFT"; continue; fi
        case "$1" in
            -*) err usage "unknown option $1" "agent-browser status [--slot N]" ;;
            *) err usage "unknown argument $1" "agent-browser status [--slot N]" ;;
        esac
    done
    use_slot "$slot"
    printf 'slot: %s\ncomponents[4]{name,state}:\n' "$SLOT"
    up=0
    for c in $COMPONENTS; do
        if alive "$c"; then printf '  %s,up\n' "$c"; up=$((up + 1)); else printf '  %s,down\n' "$c"; fi
    done
    printf 'profile: %s\n' "$PROFILE"
    if [ "$up" -eq 4 ]; then
        ip="$(cat "$RUN/bind" 2>/dev/null)"
        printf 'state: running\nviewer: http://%s:%s/vnc.html\ncdp: http://127.0.0.1:%s\nleases: %s\n' \
            "$ip" "$WEB_PORT" "$CDP_PORT" "$(live_leases "$SLOT" | wc -l)"
        printf 'help[2]:\n  agent-browser start [URL]   # take your own lease and tab\n  agent-browser stop <lease>\n'
    elif [ "$up" -eq 0 ]; then
        printf 'state: stopped\nhelp[1]:\n  agent-browser start [URL]\n'
    else
        printf 'state: partial (%d/4 up)\nhelp[1]:\n  agent-browser stop --force --slot %s && agent-browser start --slot %s\n' "$up" "$SLOT" "$SLOT"
    fi
    printf 'slots[%d]{slot,state,leases,viewer}:\n' "$MAX_SLOTS"
    for ((s = 0; s < MAX_SLOTS; s++)); do slot_line "$s"; done
}

cmd_show() {
    case "${1:-}" in
        -*) err usage "unknown option $1" "agent-browser show <lease>" ;;
    esac
    [ $# -le 1 ] || err usage "unknown argument $2" "agent-browser show <lease>"
    need_lease "${1:-}"
    cdp GET "/json/activate/$(lease_get "$1" target)" >/dev/null 2>&1 \
        || err tab_gone "this lease's tab is closed" "agent-browser py $1 script.py   # reopens it"
    printf 'shown: %s\nviewer: http://%s:%s/vnc.html\n' "$1" "$(cat "$RUN/bind" 2>/dev/null)" "$WEB_PORT"
}

cmd_py() {
    local id="${1:-}"
    [ $# -ge 2 ] || err usage "py needs a lease and a script" "agent-browser py <lease> script.py [args...]"
    case "$id" in
        -*) err usage "unknown option $id" "agent-browser py <lease> script.py [args...]" ;;
    esac
    need_lease "$id"
    command -v uv >/dev/null 2>&1 || err missing_dependency "uv not found" "install uv"
    alive chrome || err not_running "slot $SLOT browser is not running" "agent-browser start --slot $SLOT"
    shift
    # A script may outlive LEASE_TTL; keep its lease live only while it runs, so
    # an abandoned lease still expires.
    local hb rc
    (while sleep 60; do [ -f "$LEASES/$id" ] || exit; touch -c "$LEASES/$id" 2>/dev/null || exit; done) &
    hb=$!
    AGENT_BROWSER_LEASE="$id" AGENT_BROWSER_LEASE_FILE="$LEASES/$id" \
        AGENT_BROWSER_CDP="http://127.0.0.1:$CDP_PORT" AGENT_BROWSER_TARGET="$(lease_get "$id" target)" \
        PYTHONPATH="$LIB_DIR${PYTHONPATH:+:$PYTHONPATH}" \
        uv run -q --with playwright python "$@"
    rc=$?
    kill "$hb" 2>/dev/null
    return "$rc"
}

cmd_check() {
    local site="" slot="0"
    while [ $# -gt 0 ]; do
        if slot_flag "$@"; then slot="$SLOT_VALUE"; shift "$SLOT_SHIFT"; continue; fi
        case "$1" in
            --lease) [ $# -ge 2 ] || err usage "--lease needs a value"; need_lease "${2:-}"; slot="$SLOT"; shift 2 ;;
            -*) err usage "unknown option $1" "agent-browser check <github|linkedin|URL> [--lease ID] [--slot N]" ;;
            *) site="$1"; shift ;;
        esac
    done
    [ -n "$site" ] || err usage "check needs a site" "agent-browser check <github|linkedin|URL> [--lease ID]"
    use_slot "$slot"
    alive chrome || err not_running "slot $SLOT browser is not running" "agent-browser start --slot $SLOT"
    command -v uv >/dev/null 2>&1 || err missing_dependency "uv not found" "install uv"
    # Decides from what the page renders, never from cookies or field values.
    uv run -q --with playwright python - "$site" "$CDP_PORT" <<'PY'
import sys
from urllib.parse import urlparse
from playwright.sync_api import sync_playwright
site, port = sys.argv[1], sys.argv[2]
known = {
    "github": ("https://github.com/", "github.com/login"),
    "linkedin": ("https://www.linkedin.com/feed/", "linkedin.com/login"),
}
url, login_marker = known.get(site, (site, "/login"))
LOGIN_HOSTS = ("account.", "accounts.", "login.", "auth.", "sso.", "signin.", "id.")
LOGIN_WORDS = ("login", "signin", "sign_in", "sign-in", "checkpoint")
LOGIN_SEGMENTS = {"auth", "sso"}


def looks_logged_out(asked, landed, marker):
    # Logged-out sites often redirect to a separate account host, which the
    # path markers alone never see.
    a, l = urlparse(asked), urlparse(landed)
    path = l.path.lower()
    if marker in (l.hostname or "") + path or any(w in path for w in LOGIN_WORDS) or LOGIN_SEGMENTS & set(path.split("/")):
        return True
    return l.hostname != a.hostname and (l.hostname or "").startswith(LOGIN_HOSTS)


with sync_playwright() as p:
    ctx = p.chromium.connect_over_cdp(f"http://127.0.0.1:{port}").contexts[0]
    page = ctx.new_page()
    try:
        page.goto(url, wait_until="domcontentloaded", timeout=30000)
        page.wait_for_timeout(1500)
        user = ""
        if site == "github":
            user = page.locator('meta[name="user-login"]').get_attribute("content") or ""
            ok = bool(user)
        else:
            ok = not looks_logged_out(url, page.url, login_marker) and not page.locator("input[type=password]:visible").count()
        print(f"site: {site}\nlogged_in: {'yes' if ok else 'no'}")
        if user:
            print(f"user: {user}")
        if not ok:
            print("help[1]:\n  agent-browser show <lease>, have the human sign in through the viewer, then re-run this check")
    finally:
        page.close()
PY
}

cmd_wipe() {
    local yes=0 slot="0"
    while [ $# -gt 0 ]; do
        if slot_flag "$@"; then slot="$SLOT_VALUE"; shift "$SLOT_SHIFT"; continue; fi
        case "$1" in
            --yes) yes=1; shift ;;
            -*) err usage "unknown option $1" "agent-browser wipe --yes [--slot N]" ;;
            *) err usage "unknown argument $1" "agent-browser wipe --yes [--slot N]" ;;
        esac
    done
    use_slot "$slot"
    [ "$yes" -eq 1 ] || err confirmation_required "wipe deletes every saved login in $PROFILE" "agent-browser wipe --yes --slot $SLOT"
    alive chrome && err running "stop the browser first" "agent-browser stop --force --slot $SLOT"
    rm -rf "$PROFILE"
    printf 'wiped: %s\n' "$PROFILE"
}

usage() {
    cat <<EOF
agent-browser: logged-in browser for agents; the human does every login.
usage:
  agent-browser [status [--slot N]]
  agent-browser start [--slot N|auto|--slot=N] [URL]   # takes a lease: your own tab
  agent-browser py <lease> script.py [args]   # Playwright attached to your tab
  agent-browser show <lease>                  # bring your tab to the viewer's front
  agent-browser check <github|linkedin|URL> [--lease ID] [--slot N|--slot=N]
  agent-browser stop <lease>                  # browser stops when the last lease goes
  agent-browser stop --force [--slot N|--slot=N]   # kill a slot regardless of leases
  agent-browser wipe --yes [--slot N|--slot=N]
EOF
}

case "${1:-status}" in
    status) shift; cmd_status "$@" ;;
    start) shift; cmd_start "$@" ;;
    stop) shift; cmd_stop "$@" ;;
    show) shift; cmd_show "$@" ;;
    py) shift; cmd_py "$@" ;;
    check) shift; cmd_check "$@" ;;
    wipe) shift; cmd_wipe "$@" ;;
    -h|--help|help) usage ;;
    *) err unknown_command "unknown command: $1" "agent-browser --help" ;;
esac
