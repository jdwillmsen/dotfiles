#!/usr/bin/env python3
"""agent-metrics — per-session metrics store for this box's coding agents.

Reads Claude Code transcripts and writes one row of numbers per session into
a git repo, rolls up the plan-quota log the status line keeps, and answers
whether a model spend fits the audit's budget. Calls no model itself.
Agent-facing: stdout is TOON, diagnostics go to stderr.
"""
import argparse
import datetime as dt
import fcntl
import hashlib
import json
import math
import os
import re
import subprocess
import sys
import time
from collections import Counter
from pathlib import Path

VERSION = "1.0.0"

# Fast path before any real work: harnesses probe --version constantly. Only
# as a command: sibling tools load this file as a library for the store helpers.
if __name__ == "__main__" and len(sys.argv) == 2 and sys.argv[1] in ("-v", "-V", "--version"):
    print(VERSION)
    sys.exit(0)

EXIT_FAIL, EXIT_USAGE, EXIT_DENIED = 1, 2, 3

HOME = Path.home()
CLAUDE_DIR = Path(os.environ.get("CLAUDE_CONFIG_DIR", HOME / ".claude"))
STORE = Path(os.environ.get("AGENT_METRICS_STORE",
                            Path(os.environ.get("XDG_DATA_HOME", HOME / ".local/share")) / "agent-metrics/store"))
STATE = Path(os.environ.get("AGENT_METRICS_STATE",
                            Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state")) / "agent-metrics"))
CONFIG = Path(os.environ.get("AGENT_METRICS_CONFIG",
                             Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config")) / "agent-metrics"))

# Children get the environment minus anything credential-shaped; git reaches
# its remote through the ssh agent or a credential helper, not through these.
CRED_ENV = re.compile(r"TOKEN|SECRET|PASSW|API_KEY|PRIVATE_KEY|CREDENTIAL", re.I)

SCHEMA = 1
# A gap longer than this between two records is time nobody was working.
IDLE_GAP_S = 300
ID_MAX = 64
ID_UNSAFE = re.compile(r"[^A-Za-z0-9:_.@/-]")
# Shapes of common credentials, which are otherwise valid identifier
# characters. Anchored to a token start, or `sk-` would match inside `task-`.
ID_CREDENTIAL = re.compile(r"(?<![A-Za-z0-9])(?:gh[pousr]_|github_pat_|sk-|xox[baprs]-|AKIA|ASIA|AIza|eyJ)[A-Za-z0-9_-]{16,}")
# A person is typing in these: the terminal, and T3 Code, which drives its
# sessions through the TypeScript SDK. Everything else is pipeline-launched.
INTERACTIVE_ENTRYPOINTS = ("cli", "sdk-ts")
TIMED_TYPES = ("user", "assistant", "system", "attachment")
INTERRUPTED = "[Request interrupted by user"
# Matched against Bash commands to count outcomes; the command is never stored.
OUTPUT_CMDS = (("commits", re.compile(r"\bgit\b[^|;&\n]*\bcommit\b")),
               ("pushes", re.compile(r"\bgit\b[^|;&\n]*\bpush\b")),
               ("prs_created", re.compile(r"\bgh\s+pr\s+create\b")))
USAGE_FIELDS = ("input", "output", "cache_read", "cache_write_5m", "cache_write_1h")

BASELINE_DAYS = 30
WEEKLY_WINDOW_S = 7 * 86400
# The only paths in the store this tool and its siblings write (reports,
# labels, the trends page, findings); anything else is someone else's.
OWN_DIRS = ("sessions", "quota", "ledger", "reports", "labels", "site", "findings")
QUOTA_LOCAL_KEEP_S = 35 * 86400
QUOTA_WINDOWS = ("five_hour", "seven_day")
LOCK_WAIT_S = int(os.environ.get("AGENT_METRICS_LOCK_WAIT", "600"))

README = """# agent-metrics store

Machine-written by `agent-metrics collect`; do not edit by hand.

- `sessions/YYYY-MM.jsonl`: one row per Claude Code session, filed by the UTC
  month it started in, sorted by start time. Numbers and identifiers only.
- `quota/YYYY-MM.jsonl`: plan-quota readings, at most one per hour.
- `ledger/YYYY-MM.jsonl`: the audit's own model spend.

Costs are estimates at API list prices, an index of relative use and not a
bill. Forked or resumed sessions are not de-duplicated, and a session resumed
across months stays in the month it started. Field reference: the dotfiles
repo, `docs/agent-metrics.md`.
"""

USAGE_SHORT = "agent-metrics [init | collect | budget [check|record]] [--help]"


def log(msg):
    print(f"agent-metrics: {msg}", file=sys.stderr)


def now():
    fixed = os.environ.get("AGENT_METRICS_NOW")
    if fixed:
        return dt.datetime.fromisoformat(fixed).astimezone(dt.timezone.utc)
    return dt.datetime.now(dt.timezone.utc)


def tilde(p):
    return str(p).replace(str(HOME), "~", 1)


# ── TOON output ──────────────────────────────────────────────────────────────

def toon_scalar(v):
    if v is None:
        return "null"
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, (int, float)):
        return str(v)
    s = str(v)
    if s == "" or s != s.strip() or re.search(r'[,:"\\\n\[\]{}]', s) or s in ("true", "false", "null") \
            or re.fullmatch(r"-?\d+(\.\d+)?", s):
        return json.dumps(s, ensure_ascii=False)
    return s


def toon(obj, indent=0):
    pad = "  " * indent
    out = []
    for k, v in obj.items():
        if isinstance(v, dict):
            out.append(f"{pad}{k}:")
            out.append(toon(v, indent + 1))
        elif isinstance(v, list) and v and all(isinstance(x, dict) for x in v):
            keys = list(v[0].keys())
            out.append(f"{pad}{k}[{len(v)}]{{{','.join(keys)}}}:")
            for row in v:
                out.append(pad + "  " + ",".join(toon_scalar(row.get(c)) for c in keys))
        elif isinstance(v, list):
            out.append(f"{pad}{k}[{len(v)}]:")
            for x in v:
                out.append(pad + "  " + toon_scalar(x))
        else:
            out.append(f"{pad}{k}: {toon_scalar(v)}")
    return "\n".join(out)


def emit(obj):
    print(toon(obj))


def die(code, msg, help_line=None):
    out = {"error": msg}
    if help_line:
        out["help"] = help_line
    emit(out)
    sys.exit(code)


def usage_error(msg, help_line=None):
    die(EXIT_USAGE, msg, help_line or USAGE_SHORT)


# ── Config and pricing ───────────────────────────────────────────────────────

def load_config(name):
    """Read one config file; unreadable config is a setup error, never a default."""
    path = CONFIG / name
    try:
        data = json.loads(path.read_text())
    except OSError as e:
        die(EXIT_USAGE, f"cannot read {tilde(path)}: {e.strerror}", "Run `chezmoi apply` to deploy the config")
    except ValueError as e:
        die(EXIT_USAGE, f"{tilde(path)} is not valid JSON: {e}")
    if not isinstance(data, dict):
        die(EXIT_USAGE, f"{tilde(path)} must hold a JSON object")
    return data


_pricing = None


def pricing():
    global _pricing
    if _pricing is None:
        p = load_config("pricing.json")
        try:
            models = {k: tuple(float(x) for x in v) for k, v in p["models"].items()}
            if any(len(v) != 3 for v in models.values()):
                raise ValueError("each model needs [input, output, cache_read]")
            _pricing = {"models": models,
                        # Longest prefix first, so a dated id resolves to its own family.
                        "keys": sorted(models, key=len, reverse=True),
                        "w5m": float(p["cache_write_5m"]), "w1h": float(p["cache_write_1h"]),
                        "as_of": str(p["as_of"])}
        except (KeyError, TypeError, ValueError, AttributeError) as e:
            die(EXIT_USAGE, f"{tilde(CONFIG / 'pricing.json')} is malformed: {e!r}")
    return _pricing


def price_for(model):
    p = pricing()
    for k in p["keys"]:
        if model.startswith(k):
            return p["models"][k]
    return None


def cost_of(model, u):
    """USD at list prices, or None for a model the pricing file does not know."""
    rates = price_for(model)
    if not rates:
        return None
    i, o, cr = rates
    p = pricing()
    return (u["input"] * i + u["output"] * o + u["cache_read"] * cr
            + u["cache_write_5m"] * i * p["w5m"] + u["cache_write_1h"] * i * p["w1h"]) / 1e6


# ── Session rows ─────────────────────────────────────────────────────────────

def clean_id(s):
    """Identifier fields are the only strings a row stores. A value that is
    not identifier-shaped is replaced whole: cleaning it character by
    character would leave a prompt fragment readable."""
    s = str(s)
    if not s or ID_UNSAFE.search(s):
        return "_invalid"
    if ID_CREDENTIAL.search(s):
        return "_redacted"
    return s[:ID_MAX]


def parse_ts(s):
    try:
        return dt.datetime.fromisoformat(str(s).replace("Z", "+00:00")).timestamp()
    except ValueError:
        return None


def iso(t):
    return dt.datetime.fromtimestamp(t, dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def subagent_files(main_path):
    d = Path(main_path).with_suffix("") / "subagents"
    return sorted(str(p) for p in d.rglob("*.jsonl")) if d.is_dir() else []


def find_sessions(since_days):
    """Main transcripts where the file or any of its subagent files changed
    inside the window; a subagent can finish after its parent's last write."""
    cutoff = now().timestamp() - since_days * 86400
    found = []
    for main in sorted((CLAUDE_DIR / "projects").glob("*/*.jsonl")):
        subs = subagent_files(main)
        try:
            newest = max(os.path.getmtime(p) for p in [main, *subs])
        except OSError:
            continue
        if newest >= cutoff:
            found.append((str(main), subs))
    return found


def read_usage(u):
    u = u if isinstance(u, dict) else {}

    def tokens(d, k):
        # json.loads accepts NaN and Infinity; one of those in a count would
        # make every cost and budget comparison downstream meaningless.
        v = d.get(k)
        return v if isinstance(v, int) and not isinstance(v, bool) and v >= 0 else 0

    n = lambda k: tokens(u, k)
    split = u.get("cache_creation") if isinstance(u.get("cache_creation"), dict) else None
    if split:
        w5, w1 = tokens(split, "ephemeral_5m_input_tokens"), tokens(split, "ephemeral_1h_input_tokens")
    else:
        w5, w1 = n("cache_creation_input_tokens"), 0
    return {"input": n("input_tokens"), "output": n("output_tokens"), "cache_read": n("cache_read_input_tokens"),
            "cache_write_5m": w5, "cache_write_1h": w1}


def text_of(content):
    if isinstance(content, str):
        return content
    if isinstance(content, list) and content and all(isinstance(b, dict) and b.get("type") == "text" for b in content):
        return " ".join(b["text"] for b in content if isinstance(b.get("text"), str))
    return None


def locate(cwd):
    """(repo, pipeline) from a working directory, by this box's layout."""
    try:
        path = Path(cwd)
    except TypeError:
        return None, None
    pipeline = None
    if path.is_relative_to(HOME / ".no-mistakes"):
        pipeline = "no-mistakes"
    elif any(part.startswith("agent-audit-insights-") for part in path.parts):
        pipeline = "agent-audit"
    for root in (HOME / "projects", HOME / "worktrees"):
        if path.is_relative_to(root):
            parts = path.relative_to(root).parts
            if len(parts) >= 2:
                return clean_id(f"{parts[0]}/{parts[1]}"), pipeline
    return None, pipeline


def build_row(main_path, sub_paths):
    """One schema-1 row for a main session and its subagents, or None when
    the files hold no timestamped record."""
    ident = {}
    times, prompt_times = [], set()
    msgs, order = {}, []           # message id -> usage; main-session ids in first-seen order
    counts = Counter()
    tools, skills, sub_types = Counter(), Counter(), Counter()
    pending, seen_tools = {}, set()
    pr_links = []

    for path, is_sub in [(main_path, False)] + [(p, True) for p in sub_paths]:
        try:
            fh = open(path, errors="replace")
        except OSError:
            continue
        with fh:
            for line in fh:
                try:
                    d = json.loads(line)
                except ValueError:
                    counts["bad_lines"] += 1
                    continue
                if not isinstance(d, dict):
                    continue
                t = d.get("type")
                ts = parse_ts(d["timestamp"]) if d.get("timestamp") else None
                if not is_sub and t in TIMED_TYPES:
                    if ts is not None:
                        times.append(ts)
                    for key, field in (("entrypoint", "entrypoint"), ("cli_version", "version"), ("cwd", "cwd")):
                        if key not in ident and d.get(field):
                            ident[key] = d[field]
                m = d.get("message") if isinstance(d.get("message"), dict) else {}
                content = m.get("content")
                if t == "assistant":
                    if d.get("isApiErrorMessage"):
                        counts["api_errors"] += 1
                        if d.get("apiErrorStatus") == 429 or d.get("error") == "rate_limit":
                            counts["rate_limits"] += 1
                    model, mid = m.get("model"), m.get("id")
                    # Error and placeholder turns carry a bracketed pseudo-model.
                    if isinstance(model, str) and isinstance(mid, str) and model and mid and not model.startswith("<"):
                        u = read_usage(m.get("usage"))
                        if mid not in msgs:
                            msgs[mid] = {"model": clean_id(model), "where": "subagent" if is_sub else "main", **u}
                            if not is_sub:
                                order.append(mid)
                        else:
                            # One message is written as several records with growing usage.
                            for k in USAGE_FIELDS:
                                msgs[mid][k] = max(msgs[mid][k], u[k])
                    for b in content if isinstance(content, list) else []:
                        if not isinstance(b, dict) or b.get("type") != "tool_use":
                            continue
                        tid = b.get("id") if isinstance(b.get("id"), str) else None
                        if tid in seen_tools:
                            continue
                        if tid:
                            seen_tools.add(tid)
                        name, inp = str(b.get("name") or "unknown"), b.get("input") if isinstance(b.get("input"), dict) else {}
                        tools[clean_id(name)] += 1
                        if name == "Skill":
                            skills[clean_id(inp.get("skill") or "unknown")] += 1
                        elif name in ("Agent", "Task"):
                            sub_types[clean_id(inp.get("subagent_type") or "general-purpose")] += 1
                        elif name == "Bash":
                            cmd = str(inp.get("command") or "")
                            kinds = [k for k, rx in OUTPUT_CMDS if rx.search(cmd)]
                            if kinds and tid:
                                pending[tid] = kinds
                elif t == "user":
                    if d.get("toolDenialKind"):
                        counts["denials"] += 1
                    for b in content if isinstance(content, list) else []:
                        if isinstance(b, dict) and b.get("type") == "tool_result":
                            failed = b.get("is_error") is True
                            counts["tool_errors"] += failed
                            ref = b.get("tool_use_id")
                            for k in pending.pop(ref, []) if isinstance(ref, str) else []:
                                counts[k] += not failed
                    text = text_of(content)
                    if is_sub or text is None or d.get("isMeta") or d.get("isCompactSummary"):
                        continue
                    stripped = text.lstrip()
                    if stripped.startswith(INTERRUPTED):
                        counts["interrupts"] += 1
                    elif "<command-name>" in text or not stripped.startswith("<"):
                        counts["prompts"] += 1
                        if ts is not None:
                            prompt_times.add(ts)
                elif t == "system" and d.get("subtype") == "compact_boundary":
                    counts["compactions"] += 1
                elif t == "pr-link" and d.get("prRepository") and isinstance(d.get("prNumber"), int):
                    link = {"repo": clean_id(d["prRepository"]), "number": d["prNumber"]}
                    if link not in pr_links:
                        pr_links.append(link)

    if not times:
        return None
    times.sort()
    active = idle = wait = 0.0
    for prev, cur in zip(times, times[1:]):
        gap = cur - prev
        if gap > IDLE_GAP_S:
            idle += gap
            if cur in prompt_times:
                wait += gap
        else:
            active += gap

    models = {"main": {}, "subagent": {}}
    for u in msgs.values():
        agg = models[u["where"]].setdefault(u["model"], {"calls": 0, **dict.fromkeys(USAGE_FIELDS, 0)})
        agg["calls"] += 1
        for k in USAGE_FIELDS:
            agg[k] += u[k]
    total, unpriced, tok = 0.0, set(), Counter()
    for group in models.values():
        for model, agg in group.items():
            cost = cost_of(model, agg)
            agg["cost_usd"] = None if cost is None else round(cost, 6)
            if cost is None:
                unpriced.add(model)
            else:
                total += cost
            for k in USAGE_FIELDS:
                tok[k] += agg[k]
    seq = [msgs[mid]["model"] for mid in order]
    denom = tok["cache_read"] + tok["cache_write_5m"] + tok["cache_write_1h"] + tok["input"]
    repo, pipeline = locate(ident.get("cwd"))
    entry = ident.get("entrypoint")
    mcp = Counter()
    for name, n in tools.items():
        if name.startswith("mcp__") and name.count("__") >= 2:
            mcp[name.split("__")[1]] += n

    return {
        "schema": SCHEMA,
        # The file name, not the first record's sessionId: it is unique per
        # transcript, so two files can never collapse into one row.
        "session_id": clean_id(Path(main_path).stem),
        "entrypoint": clean_id(entry) if entry else None,
        "cli_version": clean_id(ident["cli_version"]) if ident.get("cli_version") else None,
        "started_at": iso(times[0]), "ended_at": iso(times[-1]),
        "population": "interactive" if entry in INTERACTIVE_ENTRYPOINTS else "scripted",
        "pipeline": pipeline, "repo": repo,
        "cwd_hash": hashlib.sha256(str(ident.get("cwd") or "").encode()).hexdigest()[:12],
        "wall_s": round(times[-1] - times[0]), "active_s": round(active), "idle_s": round(idle),
        "wait_human_s": round(wait),
        "prompts": counts["prompts"], "interrupts": counts["interrupts"],
        "models": models, "cost_usd": round(total, 6), "unpriced_models": sorted(unpriced),
        "subagent_runs": len(sub_paths), "subagent_types": dict(sub_types), "skills": dict(skills),
        "tools": dict(tools), "mcp": dict(mcp),
        "cache_read_share": round(tok["cache_read"] / denom, 4) if denom else None,
        "model_switches": sum(1 for a, b in zip(seq, seq[1:]) if a != b),
        "compactions": counts["compactions"],
        "tool_errors": counts["tool_errors"], "denials": counts["denials"],
        "rate_limits": counts["rate_limits"], "api_errors": counts["api_errors"],
        "commits": counts["commits"], "pushes": counts["pushes"], "prs_created": counts["prs_created"],
        "pr_links": pr_links, "bad_lines": counts["bad_lines"],
    }


# ── Store ────────────────────────────────────────────────────────────────────

def child_env():
    return {k: v for k, v in os.environ.items() if not CRED_ENV.search(k)}


def git(*args, check=True):
    r = subprocess.run(["git", "-C", str(STORE), *args], capture_output=True, text=True, env=child_env())
    if check and r.returncode != 0:
        raise RuntimeError(f"git {' '.join(args)}: {(r.stderr or r.stdout).strip()}")
    return r


def store_exists():
    return (STORE / ".git").exists()


def require_store():
    if not store_exists():
        die(EXIT_USAGE, f"no store at {tilde(STORE)}", "Run `agent-metrics init` to clone it")


def has_upstream():
    return git("rev-parse", "--abbrev-ref", "@{u}", check=False).returncode == 0


def month_file(kind, stamp):
    return STORE / kind / f"{stamp[:7]}.jsonl"


def read_month(path):
    """Rows of one month file by session id. A line that is not a row is a
    setup error naming the file: guessing around it would rewrite history."""
    rows = {}
    if not path.is_file():
        return rows
    for n, line in enumerate(path.read_text().splitlines(), 1):
        if not line.strip():
            continue
        try:
            r = json.loads(line)
            if not (isinstance(r, dict) and isinstance(r["session_id"], str) and isinstance(r["started_at"], str)):
                raise ValueError
        except (ValueError, KeyError):
            die(EXIT_USAGE, f"{tilde(path)} line {n} is not a session row",
                f"Fix or remove the line in {tilde(STORE)}/sessions/{path.name}")
        rows[r["session_id"]] = r
    return rows


def write_lines(path, objs):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".tmp")
    # Sorted keys keep a one-row change a one-line diff; allow_nan=False keeps
    # a non-finite number from ever being stored.
    tmp.write_text("".join(json.dumps(o, sort_keys=True, separators=(",", ":"), allow_nan=False) + "\n" for o in objs))
    os.replace(tmp, path)


def write_month(path, rows):
    write_lines(path, sorted(rows.values(), key=lambda r: (r["started_at"], r["session_id"])))


def upsert(rows, write=True):
    """Merge rows into their month files; rows for other sessions are kept,
    which is how history outlives the transcripts."""
    by_month = {}
    for r in rows:
        by_month.setdefault(month_file("sessions", r["started_at"]), []).append(r)
    written = unchanged = 0
    for path, new in by_month.items():
        have = read_month(path)
        changed = 0
        for r in new:
            if have.get(r["session_id"]) == r:
                unchanged += 1
            else:
                have[r["session_id"]] = r
                changed += 1
        written += changed
        if changed and write:
            write_month(path, have)
    return written, unchanged


def publish(message, push=True, dirs=None):
    """Commit whatever changed in the tool's own directories and push. Call
    with the Lock held. `pushed` is True, False (the commit is kept and the
    next publish delivers it) or a string saying why nothing was sent. `dirs`
    narrows what is staged, so one tool does not commit another's work in progress."""
    own = [d for d in (OWN_DIRS if dirs is None else dirs) if (STORE / d).is_dir()]
    out = {"committed": False}
    if own and git("status", "--porcelain", "--", *own).stdout.strip():
        git("add", "-A", "--", *own)
        git("commit", "--quiet", "-m", message)
        out["committed"] = True
    ahead = not has_upstream() or git("rev-list", "--count", "@{u}..HEAD").stdout.strip() != "0"
    if not push or not ahead:
        out["pushed"] = "skipped" if ahead else "nothing to push"
        return out
    result = git("push", "--quiet", "-u", "origin", "HEAD", check=False)
    out["pushed"] = result.returncode == 0
    if result.returncode != 0:
        out["error"] = f"git push failed: {(result.stderr or result.stdout).strip().splitlines()[-1]}"
    return out


class Lock:
    """One collect at a time: a timer firing during a manual run waits."""

    def __enter__(self):
        STATE.mkdir(parents=True, exist_ok=True)
        self.fh = open(STATE / "collect.lock", "w")
        deadline = time.monotonic() + LOCK_WAIT_S
        while True:
            try:
                fcntl.flock(self.fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return self
            except OSError:
                if time.monotonic() >= deadline:
                    self.fh.close()
                    die(EXIT_FAIL, f"another collect still holds the lock after {LOCK_WAIT_S}s")
                time.sleep(min(2, LOCK_WAIT_S))

    def __exit__(self, *_exc):
        self.fh.close()


# ── Quota ────────────────────────────────────────────────────────────────────

def is_amount(v):
    """A finite, non-negative number: the only kind a budget may be built on."""
    return isinstance(v, (int, float)) and not isinstance(v, bool) and math.isfinite(v) and v >= 0


def read_jsonl(path):
    """Parsed object lines of a file; anything else on a line is skipped."""
    rows = []
    try:
        lines = Path(path).read_text(errors="replace").splitlines()
    except OSError:
        return rows
    for line in lines:
        try:
            d = json.loads(line)
        except ValueError:
            continue
        if isinstance(d, dict):
            rows.append(d)
    return rows


def local_quota():
    return [r for r in read_jsonl(STATE / "quota.jsonl") if is_amount(r.get("at"))]


def rollup_quota(write=True):
    """Fold finished hours of the status line's quota log into the store and
    return how many hours were added. The hour in progress waits, so a stored
    hour never needs rewriting."""
    readings = local_quota()
    current_hour = int(now().timestamp()) // 3600
    hours = {}
    for r in readings:
        h = int(r["at"]) // 3600
        if h >= current_hour:
            continue
        agg = hours.setdefault(h, {"hour": iso(h * 3600), "readings": 0})
        agg["readings"] += 1
        for w in QUOTA_WINDOWS:
            pct = r.get(f"{w}_pct")
            if is_amount(pct) and pct >= agg.get(f"{w}_pct", -1):
                agg[f"{w}_pct"], agg[f"{w}_resets_at"] = pct, r.get(f"{w}_resets_at")
    added = 0
    by_file = {}
    for agg in hours.values():
        by_file.setdefault(month_file("quota", agg["hour"]), []).append(agg)
    for path, new in by_file.items():
        have = {r.get("hour"): r for r in read_jsonl(path)}
        fresh = [a for a in new if a["hour"] not in have]
        added += len(fresh)
        if fresh and write:
            have.update((a["hour"], a) for a in fresh)
            write_lines(path, [have[h] for h in sorted(have)])
    cutoff = now().timestamp() - QUOTA_LOCAL_KEEP_S
    # Rewriting races the status line's appends, so only do it when there is
    # something to drop; at worst one reading in a month is lost.
    if write and any(r["at"] < cutoff for r in readings):
        tmp = STATE / "quota.jsonl.tmp"
        tmp.write_text("".join(json.dumps(r, separators=(",", ":")) + "\n" for r in readings if r["at"] >= cutoff))
        os.replace(tmp, STATE / "quota.jsonl")
    return added


def quota_readings():
    """Every reading still at hand: the local log plus the store's newest month."""
    readings = local_quota()
    if store_exists():
        files = sorted((STORE / "quota").glob("*.jsonl"))
        for r in read_jsonl(files[-1]) if files else []:
            at = parse_ts(r.get("hour"))
            if at is not None:
                readings.append({**r, "at": at})
    return readings


def latest_quota():
    readings = quota_readings()
    return max(readings, key=lambda r: r["at"]) if readings else None


def weekly_quota():
    """The newest reading that carries a usable weekly percentage. A newer
    reading without one says nothing about the weekly window."""
    readings = [r for r in quota_readings() if is_amount(r.get("seven_day_pct"))]
    return max(readings, key=lambda r: r["at"]) if readings else None


def quota_view():
    q = latest_quota()
    if not q:
        return "no readings yet (logged by the status line during interactive sessions)"
    age_h = max(0, now().timestamp() - q["at"]) / 3600
    return {"seven_day_pct": q.get("seven_day_pct"), "five_hour_pct": q.get("five_hour_pct"),
            "age_hours": round(age_h, 1)}


# ── Commands ─────────────────────────────────────────────────────────────────

def cmd_home(_args):
    out = {"bin": tilde(Path(sys.argv[0]).resolve()),
           "description": "Per-session agent metrics store: collect rows from transcripts, log plan quota, gate model spend",
           "store": tilde(STORE), "quota": quota_view()}
    if store_exists():
        last = git("log", "-1", "--format=%cs %s", check=False).stdout.strip()
        out["last_commit"] = last or "none yet"
        out["help"] = ["Run `agent-metrics collect --dry-run` to see what a run would write",
                       "Run `agent-metrics budget` for the spend the audit is allowed",
                       "Run `agent-metrics --help` for all commands"]
    else:
        out["status"] = "store not cloned"
        out["help"] = ["Run `agent-metrics init` to clone the store",
                       "Run `agent-metrics --help` for all commands"]
    emit(out)
    return 0


def cmd_init(_args):
    if store_exists():
        emit({"store": tilde(STORE), "status": "already cloned"})
        return 0
    remote = load_config("config.json").get("store_remote")
    if not remote:
        die(EXIT_USAGE, f"{tilde(CONFIG / 'config.json')} has no store_remote")
    STORE.parent.mkdir(parents=True, exist_ok=True)
    r = subprocess.run(["git", "clone", "--quiet", str(remote), str(STORE)], capture_output=True, text=True,
                       env=child_env())
    if r.returncode != 0:
        die(EXIT_FAIL, f"git clone failed: {r.stderr.strip()}",
            "Create the private repo first: `gh repo create jdwillmsen/agent-metrics --private`")
    seeded = False
    if not (STORE / "README.md").exists():
        (STORE / "README.md").write_text(README)
        try:
            git("add", "README.md")
            git("commit", "--quiet", "-m", "init: describe the store")
            git("push", "--quiet", "-u", "origin", "HEAD")
        except RuntimeError as e:
            die(EXIT_FAIL, str(e))
        seeded = True
    emit({"store": tilde(STORE), "status": "cloned", "readme_written": seeded,
          "help": ["Run `agent-metrics collect --since 90` for the one-time backfill"]})
    return 0


def cmd_collect(args):
    require_store()
    if args.since < 1:
        usage_error("--since needs a whole number of days, 1 or more")
    with Lock():
        try:
            return collect(args)
        except RuntimeError as e:
            die(EXIT_FAIL, str(e), f"Inspect with `git -C {tilde(STORE)} status`")


def collect(args):
    # A run that died after writing leaves rows uncommitted in the tool's own
    # directories; those are picked up again here, so only changes outside
    # them count as someone else's.
    foreign = [l for l in git("status", "--porcelain").stdout.splitlines()
               if not l[3:].startswith(tuple(d + "/" for d in OWN_DIRS))]
    if foreign:
        die(EXIT_FAIL, f"the store has changes this run did not make: {foreign[0].strip()}",
            f"Inspect with `git -C {tilde(STORE)} status`")
    if has_upstream():
        pull = git("pull", "--quiet", "--ff-only", check=False)
        if pull.returncode != 0:
            die(EXIT_FAIL, f"git pull --ff-only failed: {(pull.stderr or pull.stdout).strip()}",
                f"Reconcile by hand in {tilde(STORE)}")
    if not args.dry_run:
        for d in OWN_DIRS:
            for stale in (STORE / d).glob("*.tmp"):
                stale.unlink()

    sessions = find_sessions(args.since)
    rows, skipped = [], 0
    for main, subs in sessions:
        try:
            row = build_row(main, subs)
        except Exception as e:  # noqa: BLE001 - one odd transcript must not stop the daily run
            # The type alone: an exception message can quote transcript content.
            log(f"skipped {Path(main).name}: {type(e).__name__}")
            row = None
        if row is None:
            skipped += 1
        else:
            rows.append(row)
    written, unchanged = upsert(rows, write=not args.dry_run)
    out = {"files_scanned": len(sessions), "sessions_written": written, "sessions_unchanged": unchanged,
           "files_skipped": skipped, "quota_hours_added": rollup_quota(write=not args.dry_run),
           "dry_run": bool(args.dry_run)}
    if args.dry_run:
        emit(out)
        return 0

    out.update(publish(f"collect: {now():%Y-%m-%d}, {written} sessions", push=not args.no_push))
    emit(out)
    return EXIT_FAIL if out["pushed"] is False else 0


def cmd_row(args):
    print(json.dumps(build_row(args.path, subagent_files(args.path)), sort_keys=True))
    return 0


# ── Budget ───────────────────────────────────────────────────────────────────

def budget_config():
    b = load_config("budget.json")
    path = tilde(CONFIG / "budget.json")
    out = {}
    for k in ("plan_pct", "hard_pct", "weekly_quota_cutoff_pct"):
        v = b.get(k)
        if isinstance(v, bool) or not isinstance(v, (int, float)) or not 0 < v <= 100:
            die(EXIT_USAGE, f"{path}: {k} must be a number above 0 and at most 100")
        out[k] = v
    if out["plan_pct"] > out["hard_pct"]:
        die(EXIT_USAGE, f"{path}: plan_pct must not exceed hard_pct")
    return out


def ledger_spent():
    """This calendar month's recorded spend. A line that cannot be read is an
    error: skipping it would under-count and let a spend through."""
    path = month_file("ledger", iso(now().timestamp()))
    if not path.is_file():
        return 0.0
    total = 0.0
    for n, line in enumerate(path.read_text().splitlines(), 1):
        if not line.strip():
            continue
        try:
            usd = json.loads(line)["usd"]
            if not is_amount(usd):
                raise ValueError("usd")
        except (ValueError, KeyError, TypeError):
            die(EXIT_USAGE, f"{tilde(path)} line {n} is not a ledger entry",
                f"Fix or remove the line in {tilde(STORE)}/ledger/{path.name}")
        total += usd
    return total


def baseline(end):
    """Estimated spend of sessions started in the trailing window. A stored
    cost that is not a finite amount is an error: it would turn every
    comparison below into nonsense and let any spend through."""
    lo, hi = iso((end - dt.timedelta(days=BASELINE_DAYS)).timestamp()), iso(end.timestamp())
    total = 0.0
    for path in sorted((STORE / "sessions").glob("*.jsonl")):
        if not lo[:7] <= path.stem <= hi[:7]:
            continue
        for r in read_month(path).values():
            if not is_amount(r.get("cost_usd")):
                die(EXIT_USAGE, f"{tilde(path)}: session {clean_id(r['session_id'])} has no usable cost_usd",
                    f"Fix or remove the row in {tilde(STORE)}/sessions/{path.name}")
            if lo <= r["started_at"] <= hi:
                total += r["cost_usd"]
    return total


def budget_state(need=0.0, critical=False):
    cfg = budget_config()
    end = now()
    base = baseline(end)
    spent = ledger_spent()
    plan, hard = base * cfg["plan_pct"] / 100, base * cfg["hard_pct"] / 100
    q = weekly_quota()
    held = False
    if q and q["seven_day_pct"] >= cfg["weekly_quota_cutoff_pct"]:
        resets = q.get("seven_day_resets_at")
        if is_amount(resets) and resets > 0:
            held = resets > end.timestamp()
        else:
            # No usable reset time: assume the window is still open until the
            # reading is older than the window itself.
            held = end.timestamp() - q["at"] < WEEKLY_WINDOW_S

    total = spent + need
    # Deny is the default; a spend is allowed only by an explicit comparison.
    state, allowed = "stopped", False
    reason = f"${total:.2f} would pass the {cfg['hard_pct']}% hard stop of ${hard:.2f}"
    if not base > 0:
        state = "no-baseline"
        reason = f"the store has no priced sessions in the last {BASELINE_DAYS} days"
    elif held:
        state = "quota-hold"
        reason = (f"weekly plan quota is {q['seven_day_pct']}% used, at or above the "
                  f"{cfg['weekly_quota_cutoff_pct']}% cut-off")
    elif total <= plan:
        state, allowed = "ok", True
        reason = f"${total:.2f} is within the {cfg['plan_pct']}% plan of ${plan:.2f}"
    elif total <= hard:
        state, allowed = "critical-only", bool(critical)
        reason = f"${total:.2f} is over the {cfg['plan_pct']}% plan of ${plan:.2f}; only critical findings may spend"
    out = {"state": state, "allowed": allowed, "reason": reason,
           "base_usd": round(base, 2), "plan_usd": round(plan, 2), "hard_usd": round(hard, 2),
           "spent_usd": round(spent, 2), "need_usd": round(need, 2)}
    if q:
        out["quota"] = {"seven_day_pct": q["seven_day_pct"],
                        "age_hours": round(max(0, end.timestamp() - q["at"]) / 3600, 1)}
    else:
        # Unknown quota does not block: readings exist only while an
        # interactive session is open, and the dollar caps still apply.
        out["quota"] = None
    return out


def cmd_budget(_args):
    require_store()
    out = budget_state()
    out["help"] = ["Run `agent-metrics budget check --need <usd>` before a model call",
                   "Run `agent-metrics budget record --usd <usd> --run <name>` after it"]
    emit(out)
    return 0


def cmd_budget_check(args):
    require_store()
    if not math.isfinite(args.need) or args.need < 0:
        usage_error("--need must be a dollar amount of 0 or more")
    out = budget_state(args.need, args.critical)
    emit(out)
    return 0 if out["allowed"] else EXIT_DENIED


def cmd_budget_record(args):
    require_store()
    if not math.isfinite(args.usd) or args.usd < 0:
        usage_error("--usd must be a dollar amount of 0 or more")
    ledger_spent()
    stamp = iso(now().timestamp())
    path = month_file("ledger", stamp)
    path.parent.mkdir(parents=True, exist_ok=True)
    entry = {"at": stamp, "run": clean_id(args.run), "usd": args.usd, "critical": bool(args.critical)}
    with open(path, "a") as fh:
        fh.write(json.dumps(entry, sort_keys=True, separators=(",", ":")) + "\n")
    emit({"recorded": entry, "spent_usd": round(ledger_spent(), 2),
          "help": ["The entry is committed by the next `agent-metrics collect`"]})
    return 0


# ── Main ─────────────────────────────────────────────────────────────────────

class Parser(argparse.ArgumentParser):
    def error(self, message):
        usage_error(message, f"Run `{self.prog} --help`")


def build_parser():
    p = Parser(prog="agent-metrics", description=__doc__.split("\n\n")[1],
               formatter_class=argparse.RawDescriptionHelpFormatter,
               epilog="examples:\n  agent-metrics collect --since 90      one-time backfill\n"
                      "  agent-metrics collect --dry-run       preview a daily run\n"
                      "  agent-metrics budget check --need 5   exit 0 when $5 may be spent, 3 when not")
    p.set_defaults(func=cmd_home)
    sub = p.add_subparsers(metavar="command", parser_class=Parser)
    sub.add_parser("init", help="clone the store repo into place").set_defaults(func=cmd_init)
    c = sub.add_parser("collect", help="write rows for recently changed sessions, then commit and push")
    c.set_defaults(func=cmd_collect)
    c.add_argument("--since", type=int, default=3, metavar="DAYS")
    c.add_argument("--dry-run", action="store_true")
    c.add_argument("--no-push", action="store_true")
    r = sub.add_parser("row", help="print the row one transcript would produce, as JSON")
    r.add_argument("path")
    r.set_defaults(func=cmd_row)
    b = sub.add_parser("budget", help="show the budget, or check and record a spend")
    b.set_defaults(func=cmd_budget)
    bsub = b.add_subparsers(metavar="action", parser_class=Parser)
    bc = bsub.add_parser("check", help="exit 0 when a spend is allowed, 3 when it is not")
    bc.add_argument("--need", type=float, required=True, metavar="USD")
    bc.add_argument("--critical", action="store_true", help="the spend is for a critical finding")
    bc.set_defaults(func=cmd_budget_check)
    br = bsub.add_parser("record", help="append a model spend to this month's ledger")
    br.add_argument("--usd", type=float, required=True)
    br.add_argument("--run", required=True, metavar="NAME", help="which run spent it, e.g. weekly")
    br.add_argument("--critical", action="store_true")
    br.set_defaults(func=cmd_budget_record)
    return p


def main(argv):
    args = build_parser().parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
