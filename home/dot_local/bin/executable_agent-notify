#!/usr/bin/env python3
"""agent-notify — tells the box's owner about the daily report's flags.

`send` posts one comment per flagged day and `digest` the newest weekly
report's summary to every configured channel (by default a tracking issue in
the metrics store's GitHub repo), `shell` prints a one-line nudge at shell
start, and `show` prints the flags in full and acknowledges them.
Agent-facing: stdout is TOON, diagnostics go to stderr.
"""
import argparse
import base64
import datetime as dt
import fcntl
import json
import os
import re
import stat
import subprocess
import sys
import tempfile
import time
import unicodedata
import urllib.error
import urllib.request
from urllib.parse import urlsplit
from pathlib import Path

VERSION = "1.0.0"
ISSUE_TITLE = "Agent metrics: flagged days"
DIGEST_TITLE = "Agent metrics: weekly digest"
DATE_RE = re.compile(r"[0-9]{4}-[0-9]{2}-[0-9]{2}")
IDENT_RE = re.compile(r"[A-Za-z0-9:_.@/-]{1,64}")
# GitHub's own limits, tightened: the name is later part of a command line.
REPO_RE = re.compile(r"[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})/(?!\.{1,2}$)[A-Za-z0-9._-]{1,100}")
LOCK_WAIT_S = 120
SEVERITIES = ("info", "warn", "critical")
# A flags file is a few hundred bytes; this bounds a corrupt or hostile one.
MAX_FLAGS_BYTES = 64 << 10
KEEP_DATES = 90
MESSAGE_MAX = 300
USAGE_SHORT = "agent-notify [send | digest [--dry-run] [--force] | shell | show] [--help]"


def state_dir():
    # Mirrors agent-metrics so `shell` can answer without loading it: this
    # path runs at every interactive shell start.
    explicit = os.environ.get("AGENT_METRICS_STATE")
    if explicit:
        return Path(explicit)
    xdg = os.environ.get("XDG_STATE_HOME") or str(Path.home() / ".local/state")
    return Path(xdg) / "agent-metrics"


def read_regular(path, limit=MAX_FLAGS_BYTES):
    """Bytes of a small regular file, or None for anything else. The open is
    non-blocking and the size is checked on the descriptor, so a FIFO, a
    device or a huge file can neither hang nor flood a shell start."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
    except OSError:
        return None
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_size > limit:
            return None
        data = os.read(fd, limit + 1)
        return data if len(data) <= limit else None
    except OSError:
        return None
    finally:
        os.close(fd)


def read_small_json(path):
    """Parsed JSON object, or None when absent, not a small regular file, or
    not an object."""
    raw = read_regular(path)
    if raw is None:
        return None
    try:
        data = json.loads(raw)
    except ValueError:
        return None
    return data if isinstance(data, dict) else None


def valid_date(d):
    if not isinstance(d, str) or not DATE_RE.fullmatch(d):
        return False
    try:
        dt.date.fromisoformat(d)
    except ValueError:
        return False
    return True


def printable(text, limit):
    """Text with every control, format, separator and unassigned character
    replaced by a space, so nothing from a file can steer a terminal, flip
    text direction or break markdown."""
    text = "".join(c if unicodedata.category(c)[0] not in "CZ" else " " for c in str(text))
    text = " ".join(text.split()).replace("`", "")
    return text if len(text) <= limit else text[:limit - 1] + "…"


def ident(v):
    """An identifier as-is, or `_invalid` whole: a partial clean would let a
    crafted value look like a different one."""
    return v if isinstance(v, str) and IDENT_RE.fullmatch(v) else "_invalid"


def worst_count(flags):
    """(severity, count of flags at that severity) for the worst present."""
    for sev in reversed(SEVERITIES):
        n = sum(1 for f in flags if f["severity"] == sev)
        if n:
            return sev, n
    return "info", 0


def valid_flags(data):
    """Normalized flags of a parsed flags.json, or None when it is not one.
    The Go status line applies the same rules."""
    if not data or not valid_date(data.get("date")):
        return None
    raw = data.get("flags")
    if not isinstance(raw, list):
        return None
    flags = []
    for f in raw:
        if not isinstance(f, dict):
            return None
        sev = f.get("severity")
        if sev is not None and not isinstance(sev, str):
            return None
        flags.append({"id": ident(f.get("id")), "severity": sev if sev in SEVERITIES else "info",
                      "message": printable(f.get("message", ""), MESSAGE_MAX)})
    return flags


def pending_line(flags, date):
    sev, n = worst_count(flags)
    total = len(flags)
    return f"agent-metrics: {total} flag{'s' if total != 1 else ''} for {date} ({n} {sev}): run agent-notify show"


def shell_main():
    """The shell-start nudge. Stdlib only, no network, no git, silent on any
    problem: a broken state file must never get in the way of a prompt."""
    try:
        sdir = state_dir()
        data = read_small_json(sdir / "flags.json")
        flags = valid_flags(data)
        if not flags:
            return 0
        acked = read_small_json(sdir / "acked.json") or {}
        if data["date"] in (acked.get("dates") or []):
            return 0
        print(pending_line(flags, data["date"]))
    except Exception:
        pass
    return 0


if __name__ == "__main__" and len(sys.argv) == 2 and sys.argv[1] in ("-v", "-V", "--version"):
    print(VERSION)
    sys.exit(0)

if __name__ == "__main__" and sys.argv[1:] == ["shell"]:
    sys.exit(shell_main())

from importlib.machinery import SourceFileLoader  # noqa: E402

_here = Path(__file__).resolve().parent
am = SourceFileLoader("agent_metrics", str(next(p for p in (_here / "agent-metrics", _here / "executable_agent-metrics") if p.exists()))).load_module()

STATE = state_dir()


def log(msg):
    print(f"agent-notify: {msg}", file=sys.stderr)


def usage_error(msg, help_line=None):
    am.die(am.EXIT_USAGE, msg, help_line or USAGE_SHORT)


def load_flags():
    """(date, flags) from flags.json, or None when there is no file. A file
    that cannot be read as flags is a setup error: a day's flags must never
    be dropped silently."""
    path = STATE / "flags.json"
    if not os.path.lexists(path):
        return None
    where = am.tilde(path)
    raw = read_regular(path)
    if raw is None:
        am.die(am.EXIT_USAGE, f"{where} is not a regular file under {MAX_FLAGS_BYTES} bytes",
               "It is rewritten by the next daily report")
    try:
        data = json.loads(raw)
    except ValueError as e:
        am.die(am.EXIT_USAGE, f"{where} cannot be read: {e}", "It is rewritten by the next daily report")
    flags = valid_flags(data if isinstance(data, dict) else None)
    if flags is None:
        am.die(am.EXIT_USAGE, f"{where} needs a date (YYYY-MM-DD) and a list of flags",
               "It is rewritten by the next daily report")
    return data["date"], flags


def read_dates(name):
    data = read_small_json(STATE / name) or {}
    dates = data.get("dates")
    return [d for d in dates if valid_date(d)] if isinstance(dates, list) else []


def write_state(name, obj):
    STATE.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=STATE, prefix=name + ".")
    try:
        with os.fdopen(fd, "w") as fh:
            json.dump(obj, fh)
        os.replace(tmp, STATE / name)
    except OSError:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def add_date(name, date):
    dates = [d for d in read_dates(name) if d != date] + [date]
    write_state(name, {"dates": sorted(dates)[-KEEP_DATES:]})


def remove_date(name, date):
    write_state(name, {"dates": [d for d in read_dates(name) if d != date]})


def remembered_target(fname):
    """(repo, number) last used in `fname`, or None."""
    data = read_small_json(STATE / fname) or {}
    r, n = data.get("repo"), data.get("number")
    if isinstance(r, str) and REPO_RE.fullmatch(r) and isinstance(n, int) and not isinstance(n, bool) and n > 0:
        return r, n
    return None


def remembered_issue(repo, fname):
    """Number last used in `fname` for `repo`. A value remembered for any
    other repository is ignored: numbers mean nothing across repos."""
    t = remembered_target(fname)
    return t[1] if t and t[0] == repo else None


def remember_issue(repo, number, fname):
    write_state(fname, {"repo": repo, "number": number})


def forget_issue(fname):
    try:
        (STATE / fname).unlink()
    except OSError:
        pass


class SendLock:
    """One send at a time, covering check, comment and record, so a timer
    firing during a manual run cannot post the same date twice."""

    def __enter__(self):
        STATE.mkdir(parents=True, exist_ok=True)
        self.fh = open(STATE / "notify.lock", "w")
        deadline = time.monotonic() + LOCK_WAIT_S
        while True:
            try:
                fcntl.flock(self.fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return self
            except OSError:
                if time.monotonic() >= deadline:
                    am.die(am.EXIT_FAIL, f"another send still holds the lock after {LOCK_WAIT_S}s")
                time.sleep(0.2)

    def __exit__(self, *_exc):
        self.fh.close()


def code(text, limit=MESSAGE_MAX):
    """Inline code with nothing in it for markdown to interpret."""
    return f"`{printable(text, limit) or '(empty)'}`"


def report_path(date):
    return f"reports/{date}-daily.json"


def comment_body(date, flags):
    lines = [f"Flags for {code(date)}", ""]
    lines += [f"- {code(f['severity'])} {code(f['id'])}: {code(f['message'])}" for f in flags]
    lines += ["", f"Daily report: {code(report_path(date))}"]
    return "\n".join(lines)


# ── Channels ─────────────────────────────────────────────────────────────────
# A channel delivers one message for one topic. Config: the `notify` object in
# config.json. To add a channel type, write a Channel subclass and add it to
# CHANNEL_TYPES; nothing else changes.

REMOTE_RES = (re.compile(r"^git@github\.com:([^/\s]+)/([^/\s]+?)(?:\.git)?/?$"),
              re.compile(r"^(?:https?|ssh|git)://(?:[^@/]+@)?github\.com/([^/\s]+)/([^/\s]+?)(?:\.git)?/?$"))
CHANNEL_KEY_RE = re.compile(r"[a-z0-9][a-z0-9-]{0,31}")
# The legacy state file names belong to the channel every box already has.
LEGACY_KEY = "github-issue"
TOPICS = {
    "flags": {"title": ISSUE_TITLE, "notified": "notified.json", "issue": "notify-issue", "pin": True,
              "intro": "Daily flags from the agent-metrics report, one comment per flagged day. "
                       "Written by `agent-notify send`."},
    "digest": {"title": DIGEST_TITLE, "notified": "digest-notified.json", "issue": "digest-issue", "pin": False,
               "intro": "Weekly summary from the agent-metrics report, one comment per week. "
                        "Written by `agent-notify digest`."},
}


class ChannelError(Exception):
    def __init__(self, what, detail, timed_out=False):
        super().__init__(what)
        self.what, self.detail, self.timed_out = what, detail, timed_out


def store_repo():
    repo = os.environ.get("AGENT_NOTIFY_REPO")
    if not repo:
        remote = am.load_config("config.json").get("store_remote")
        for rx in REMOTE_RES:
            m = rx.match(remote) if isinstance(remote, str) else None
            if m:
                repo = f"{m.group(1)}/{m.group(2)}"
                break
    if not repo:
        am.die(am.EXIT_USAGE, f"store_remote in {am.tilde(am.CONFIG / 'config.json')} is not a GitHub repository",
               "Set AGENT_NOTIFY_REPO=owner/repo or fix store_remote")
    if not REPO_RE.fullmatch(repo):
        am.die(am.EXIT_USAGE, "the store repository is not a valid owner/name", "Fix store_remote or AGENT_NOTIFY_REPO")
    return repo


def gh(*args, stdin=None, token=None):
    """Run gh and return stdout; any failure raises ChannelError. A `token`
    reaches gh only through its environment, never its arguments."""
    env = {**os.environ, "GH_PROMPT_DISABLED": "1", "NO_COLOR": "1"}
    if token:
        env["GH_TOKEN"] = token
    what = f"gh {args[0]} {args[1]}"
    try:
        timeout = float(os.environ.get("AGENT_NOTIFY_GH_TIMEOUT", "60"))
        r = subprocess.run(["gh", *args], input=stdin, capture_output=True, text=True, env=env, timeout=timeout)
    except FileNotFoundError:
        am.die(am.EXIT_USAGE, "gh is not installed", "Install the GitHub CLI and run `gh auth login`")
    except subprocess.TimeoutExpired:
        raise ChannelError(what, "timed out", timed_out=True)
    if r.returncode != 0:
        detail = (r.stderr or r.stdout).strip().splitlines()
        detail = detail[-1] if detail else str(r.returncode)
        raise ChannelError(what, detail.replace(token, "***") if token else detail)
    return r.stdout


# ── GitHub App identity ──────────────────────────────────────────────────────
# GitHub never notifies a user about their own comments, so comments are
# posted as the jdwlabs-agent-bot App. Its credentials are read into memory
# from the cluster, signed into a short-lived JWT, and exchanged for an
# installation token that lives only in this process and one gh environment.
# Nothing derived from the key is printed, stored or put in an argument list,
# so error text below is built from fixed strings and GitHub's own message.

APP_SECRET = ("ai-sre", "ai-sre-relay")
API_URL = "https://api.github.com"
API_TIMEOUT_S = 20
# gh failures that mean "this identity may not do that", not "try again later".
DENIED_RE = re.compile(r"resource not accessible|\b40[134]\b|not found|could not resolve to|forbidden|bad credentials", re.I)


class AppTokenError(Exception):
    pass


def kube_secret(key):
    """Decoded bytes of one key of the App's secret. The name of the key is
    the only thing on the command line; the value arrives on stdout."""
    ns, name = APP_SECRET
    try:
        r = subprocess.run(["kubectl", "-n", ns, "get", "secret", name, "-o", f"jsonpath={{.data.{key}}}"],
                           capture_output=True, text=True, timeout=API_TIMEOUT_S)
    except FileNotFoundError:
        raise AppTokenError("kubectl is not installed") from None
    except subprocess.TimeoutExpired:
        raise AppTokenError("kubectl timed out reading the App credentials") from None
    if r.returncode != 0:
        why = printable((r.stderr.strip().splitlines() or [""])[-1], 120)
        raise AppTokenError(f"kubectl cannot read secret {name} in {ns} (exit {r.returncode}{': ' + why if why else ''})")
    try:
        value = base64.b64decode(r.stdout.strip(), validate=True)
    except ValueError:
        value = b""
    if not value:
        raise AppTokenError(f"secret {name} has no usable {key}")
    return value


def b64url(raw):
    return base64.urlsafe_b64encode(raw).rstrip(b"=").decode()


def sign_jwt(app_id, pem):
    """RS256 JWT for the App. openssl reads the key from a pipe handed to it
    as a file descriptor, so the key never reaches a disk or an argument."""
    now = int(time.time())
    signing_input = ".".join(b64url(json.dumps(part, separators=(",", ":")).encode())
                             for part in ({"alg": "RS256", "typ": "JWT"}, {"iat": now - 60, "exp": now + 540, "iss": app_id}))
    rfd, wfd = os.pipe()
    try:
        # A key is ~2 KB, well inside the pipe buffer, so this cannot block.
        os.write(wfd, pem)
        os.close(wfd)
        wfd = None
        r = subprocess.run(["openssl", "dgst", "-sha256", "-sign", f"/dev/fd/{rfd}"], input=signing_input.encode(),
                           capture_output=True, pass_fds=(rfd,), timeout=API_TIMEOUT_S)
    except FileNotFoundError:
        raise AppTokenError("openssl is not installed") from None
    except (OSError, subprocess.TimeoutExpired):
        raise AppTokenError("openssl could not sign the App token request") from None
    finally:
        os.close(rfd)
        if wfd is not None:
            os.close(wfd)
    if r.returncode != 0 or not r.stdout:
        raise AppTokenError("openssl rejected the App private key")
    return f"{signing_input}.{b64url(r.stdout)}"


def api_base():
    base = os.environ.get("AGENT_NOTIFY_API_URL", API_URL).rstrip("/")  # tests point this at a local server
    u = urlsplit(base)
    if u.scheme != "https" and not (u.scheme == "http" and u.hostname in ("127.0.0.1", "localhost")):
        raise AppTokenError("AGENT_NOTIFY_API_URL must be https")
    return base


def api(method, path, jwt, body=None):
    req = urllib.request.Request(api_base() + path, method=method, data=None if body is None else json.dumps(body).encode(),
                                 headers={"Authorization": f"Bearer {jwt}", "Accept": "application/vnd.github+json",
                                          "X-GitHub-Api-Version": "2022-11-28", "User-Agent": "agent-notify",
                                          "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=API_TIMEOUT_S) as resp:
            data = json.load(resp)
    except urllib.error.HTTPError as e:
        try:
            msg = printable(json.load(e).get("message", ""), 120)
        except (ValueError, AttributeError, OSError):
            msg = ""
        raise AppTokenError(f"GitHub answered {e.code}{': ' + msg if msg else ''} to {method} {path.split('?')[0]}") from None
    except (urllib.error.URLError, OSError, ValueError) as e:
        raise AppTokenError(f"cannot reach the GitHub API ({printable(getattr(e, 'reason', type(e).__name__), 80)})") from None
    if not isinstance(data, dict):
        raise AppTokenError(f"GitHub answered {method} {path.split('?')[0]} with something that is not an object")
    return data


def mint_app_token(repo):
    """A short-lived installation token for `repo`, scoped to that one
    repository and carrying whatever permissions the installation was
    granted. Raises AppTokenError with a reason that is safe to print."""
    app_id = kube_secret("GITHUB_APP_ID").decode(errors="replace").strip()
    if not app_id.isdigit():
        raise AppTokenError("secret ai-sre-relay has no numeric GITHUB_APP_ID")
    pem = kube_secret("GITHUB_APP_PRIVATE_KEY")
    jwt = sign_jwt(app_id, pem)
    try:
        inst = api("GET", f"/repos/{repo}/installation", jwt)
    except AppTokenError as e:
        if " 404" in str(e):
            raise AppTokenError(f"the jdwlabs-agent-bot App is not installed on {repo} (404)") from None
        raise
    inst_id = inst.get("id")
    if not isinstance(inst_id, int) or isinstance(inst_id, bool):
        raise AppTokenError("GitHub returned an installation without an id")
    # Repository scope only: asking for permissions the App was never granted
    # would fail the exchange, while a missing one shows when gh comments.
    tok = api("POST", f"/app/installations/{inst_id}/access_tokens", jwt, {"repositories": [repo.split("/", 1)[1]]})
    token = tok.get("token")
    if not (isinstance(token, str) and re.fullmatch(r"[A-Za-z0-9_]{8,255}", token)):
        raise AppTokenError("GitHub returned no usable installation token")
    return token


class Channel:
    """One destination. `prepare` finds or creates whatever `post` needs and
    may fail without having notified anyone; `post` delivers and returns a
    result dict (identity, issue, fallback, help, as the channel sees fit)."""
    type = None

    def __init__(self, key, cfg):
        self.key = key

    def state_file(self, topic, kind):
        base = TOPICS[topic][kind]
        return base if self.key == LEGACY_KEY else f"{self.key}.{base}"

    def target(self, topic):
        """Dry-run row: where `post` would go."""
        raise NotImplementedError

    def prepare(self, topic):
        pass

    def post(self, topic, body):
        raise NotImplementedError


class GithubIssueChannel(Channel):
    type = "github-issue"

    def __init__(self, key, cfg):
        super().__init__(key, cfg)
        repo = cfg.get("repo")
        if repo is not None and not (isinstance(repo, str) and REPO_RE.fullmatch(repo)):
            config_error(f"channel {key}: repo must be owner/name")
        self.identity = cfg.get("identity", "gh")
        if self.identity not in ("gh", "app"):
            config_error(f"channel {key}: identity must be gh or app")
        self.repo = repo or store_repo()
        self.issue = None
        self.from_memory = False
        self.token = self.fallback = None
        self.minted = False

    def target(self, topic):
        n = remembered_issue(self.repo, self.state_file(topic, "issue"))
        return {"channel": self.key, "identity": self.identity, "repo": self.repo, "issue": n or "found or created on send"}

    def find_or_create_issue(self, topic):
        t = TOPICS[topic]
        listing = gh("issue", "list", "--repo", self.repo, "--state", "open", "--search", f'in:title "{t["title"]}"',
                     "--json", "number,title", "--limit", "100")
        try:
            found = [i["number"] for i in json.loads(listing) if i.get("title") == t["title"]]
        except (ValueError, TypeError, KeyError, AttributeError):
            # Raised, not fatal: nothing was posted, so the caller undoes the date it recorded.
            raise ChannelError("gh issue list returned something that is not a list of issues", "")
        fname = self.state_file(topic, "issue")
        if found:
            remember_issue(self.repo, min(found), fname)
            return min(found)
        out = gh("issue", "create", "--repo", self.repo, "--title", t["title"], "--body", t["intro"])
        m = re.search(r"/issues/(\d+)", out)
        if not m:
            raise ChannelError("gh issue create did not print an issue URL", "")
        number = int(m.group(1))
        # Remembered before the comment so a failed comment retries on this issue.
        remember_issue(self.repo, number, fname)
        if t["pin"]:
            try:
                gh("issue", "pin", str(number), "--repo", self.repo)
            except ChannelError:
                log("could not pin the tracking issue; pin it by hand if you want it on top")
        return number

    def issue_unusable(self, number):
        """True when the issue is closed or no longer exists. Any other failure
        to ask means we cannot tell, which is not a reason to open another."""
        try:
            state = json.loads(gh("issue", "view", str(number), "--repo", self.repo, "--json", "state")).get("state")
        except ChannelError as e:
            return bool(re.search(r"could not resolve|not found|404|deleted|transferred", e.detail, re.I))
        except (ValueError, AttributeError):
            return False
        return state == "CLOSED"

    def prepare(self, topic):
        n = remembered_issue(self.repo, self.state_file(topic, "issue"))
        self.from_memory = bool(n)
        self.issue = n or self.find_or_create_issue(topic)

    def comment(self, topic, body, token):
        """Comment, replacing a closed or deleted remembered issue once."""
        try:
            gh("issue", "comment", str(self.issue), "--repo", self.repo, "--body-file", "-", stdin=body, token=token)
        except ChannelError as e:
            if e.timed_out or not self.from_memory or not self.issue_unusable(self.issue):
                raise
            forget_issue(self.state_file(topic, "issue"))
            self.issue, self.from_memory = self.find_or_create_issue(topic), False
            gh("issue", "comment", str(self.issue), "--repo", self.repo, "--body-file", "-", stdin=body, token=token)

    def comment_token(self):
        """The App token for this run, minted on first use; None means post
        as gh, with `fallback` saying why when the App was asked for."""
        if self.identity == "app" and not self.minted:
            self.minted = True
            try:
                self.token = mint_app_token(self.repo)
            except AppTokenError as e:
                self.fallback = str(e)
            except Exception as e:  # never let a surprise carry key material into a traceback
                self.fallback = f"unexpected {type(e).__name__} while minting the App token"
        return self.token

    def post(self, topic, body):
        # Only the comment is made as the App: the issue itself stays the
        # human's, so GitHub notifies its author of the App's comments.
        token = self.comment_token()
        try:
            self.comment(topic, body, token)
        except ChannelError as e:
            if not token or e.timed_out or not DENIED_RE.search(e.detail):
                raise
            self.token, self.fallback = None, f"the App was refused: {e.detail}"
            self.comment(topic, body, None)
        remember_issue(self.repo, self.issue, self.state_file(topic, "issue"))
        out = {"identity": "app" if self.token else "gh", "issue": self.issue, "fallback": self.fallback}
        if self.fallback:
            out["help"] = (f"Install the jdwlabs-agent-bot GitHub App on the account that owns {self.repo}, with access to that "
                           "repository and the Issues: read & write permission; until then comments post as your gh login")
        return out


CHANNEL_TYPES = {GithubIssueChannel.type: GithubIssueChannel}
DEFAULT_NOTIFY = {"channels": [{"type": "github-issue"}]}


def config_error(msg):
    am.die(am.EXIT_USAGE, f"{am.tilde(am.CONFIG / 'config.json')}: notify {msg}",
           f"Channel types: {', '.join(sorted(CHANNEL_TYPES))}; see docs/agent-notify.md")


def notify_cfg():
    """The validated `notify` object; absent means the default channel. Read
    only when a command needs it, so `shell` and `show` never depend on the
    config."""
    path = am.CONFIG / "config.json"
    cfg = am.load_config("config.json").get("notify") if os.path.lexists(path) else None
    if cfg is None:
        cfg = {}
    if not isinstance(cfg, dict):
        config_error("must be an object")
    url = cfg.get("dashboard_url")
    if url is not None and not (isinstance(url, str) and re.fullmatch(r"https?://[^\s<>()\[\]`\\]+", url)):
        config_error("dashboard_url must be an http(s) URL")
    return {"dashboard_url": url.rstrip("/") + "/" if url else None,
            "channels": cfg.get("channels", DEFAULT_NOTIFY["channels"])}


def build_channels():
    """Channel instances from the `notify` config; bad config exits 2 before
    anything is sent."""
    raw = notify_cfg()["channels"]
    if not isinstance(raw, list) or not raw or not all(isinstance(c, dict) for c in raw):
        config_error("channels must be a non-empty list of objects")
    channels, seen = [], set()
    for c in raw:
        ctype = c.get("type")
        cls = CHANNEL_TYPES.get(ctype) if isinstance(ctype, str) else None
        if cls is None:
            config_error(f"channel type {printable(ctype, 40)!r} is unknown")
        key = c.get("name", ctype)
        if not (isinstance(key, str) and CHANNEL_KEY_RE.fullmatch(key)):
            config_error("channel names must match [a-z0-9-], 1 to 32 characters")
        if key in seen:
            config_error(f"channel name {key} is used twice; give each channel of one type a distinct name")
        seen.add(key)
        channels.append(cls(key, c))
    return channels


def deliver_one(ch, topic, date, body, force):
    """One channel's turn, as a result row. At most one message per date is
    the side to err on: the date is recorded before posting, a definite
    failure rolls it back, and an unknown outcome (a timeout) keeps it."""
    row = {"channel": ch.key, "status": "failed", "identity": None, "issue": None, "fallback": None, "detail": None}
    notified = ch.state_file(topic, "notified")
    if date in read_dates(notified) and not force:
        return {**row, "status": "skipped", "detail": f"already notified for {date}"}
    try:
        ch.prepare(topic)
    except ChannelError as e:
        return {**row, "detail": f"{e.what} failed: {e.detail}" if e.detail else e.what}
    try:
        add_date(notified, date)
    except OSError as e:
        return {**row, "detail": f"cannot record {date} in {am.tilde(STATE / notified)}: {e.strerror}; nothing was posted"}
    try:
        result = ch.post(topic, body)
    except ChannelError as e:
        if e.timed_out:
            return {**row, "detail": f"{e.what} timed out: the comment may have been posted, so {date} stays recorded and is not retried"}
        try:
            remove_date(notified, date)
        except OSError:
            return {**row, "detail": f"{e.what} failed ({e.detail}) and {date} could not be unrecorded, so it will not be retried"}
        return {**row, "detail": f"{e.what} failed: {e.detail}" if e.detail else e.what}
    return {**row, **result, "status": "sent"}


def deliver(topic, date, body, args, summary):
    """Send `body` to every configured channel and print the outcome; exit 1
    if any channel failed, after all have had their turn."""
    channels = build_channels()
    if args.dry_run:
        am.emit({"dry_run": True, **summary, "channels": [ch.target(topic) for ch in channels], "comment": body.split("\n")})
        return
    with SendLock():
        rows = [deliver_one(ch, topic, date, body, args.force) for ch in channels]
    helps = []
    for r in rows:
        h = r.pop("help", None)
        if h and h not in helps:
            helps.append(h)
        if r["status"] == "failed":
            log(f"{r['channel']}: {r['detail']}")
    failed = [r for r in rows if r["status"] == "failed"]
    sent = any(r["status"] == "sent" for r in rows)
    out = {"sent": sent, **summary}
    if not sent and not failed:
        out["reason"] = f"already notified for {date}"
    if failed:
        out["error"] = f"{len(failed)} of {len(rows)} channels failed"
        helps.append("The date stays unnotified on a definite failure and the next run retries; "
                     "`gh auth status` shows the gh login")
    out["channels"] = rows
    if helps:
        out["help"] = helps
    am.emit(out)
    if failed:
        sys.exit(am.EXIT_FAIL)


# ── Commands ─────────────────────────────────────────────────────────────────

def cmd_home(_args):
    loaded = load_flags()
    pending = "none"
    if loaded and loaded[1] and loaded[0] not in read_dates("acked.json"):
        pending = pending_line(loaded[1], loaded[0]).removeprefix("agent-metrics: ")
    notified = read_dates("notified.json")
    issue = remembered_target(TOPICS["flags"]["issue"])
    am.emit({"pending": pending,
             "last_notified": notified[-1] if notified else "none",
             "last_digest": (read_dates(TOPICS["digest"]["notified"]) or ["none"])[-1],
             "issue": f"{issue[0]}#{issue[1]}" if issue else "not created yet",
             "help": ["agent-notify show: print the flags and acknowledge them",
                      "agent-notify send --dry-run: preview the issue comment",
                      "agent-notify digest --dry-run: preview the weekly digest"]})


def cmd_send(args):
    loaded = load_flags()
    if loaded is None or not loaded[1]:
        am.emit({"sent": False, "reason": "nothing to send: no flags file" if loaded is None else "nothing to send: no flags"})
        return
    date, flags = loaded
    deliver("flags", date, comment_body(date, flags), args, {"date": date, "flags": len(flags)})


# ── Weekly digest ────────────────────────────────────────────────────────────

MAX_REPORT_BYTES = 16 << 20
MAX_DIGEST_FLAGS = 15
WEEKLY_RE = re.compile(r"([0-9]{4}-[0-9]{2}-[0-9]{2})-weekly\.json")


def read_report(name):
    raw = read_regular(am.STORE / "reports" / name, MAX_REPORT_BYTES)
    try:
        data = json.loads(raw) if raw is not None else None
    except ValueError:
        return None
    return data if isinstance(data, dict) else None


def latest_weekly(date=None):
    """(label date, parsed report) of the newest weekly report in the store,
    or of `date` when given; None when there is none that reads."""
    found = sorted((m.group(1) for m in (WEEKLY_RE.fullmatch(p.name) for p in (am.STORE / "reports").glob("*-weekly.json"))
                    if m and valid_date(m.group(1))), reverse=True)
    for d in ([date] if date else found):
        data = read_report(f"{d}-weekly.json") if d in found else None
        if data is not None:
            return d, data
    return None


def number(d, *path):
    for k in path:
        d = d.get(k) if isinstance(d, dict) else None
    return d if am.is_amount(d) else None


def change(cur, prev):
    if cur is None or prev is None or prev == 0:
        return "n/a"
    return f"{(cur - prev) / prev * 100:+.0f}%"


def window_days(report):
    """The dates from start up to, not including, end; empty when either is
    not a date or the span is not a plausible window."""
    start, end = report.get("start"), report.get("end")
    if not (valid_date(start) and valid_date(end)):
        return []
    a, b = dt.date.fromisoformat(start), dt.date.fromisoformat(end)
    return [(a + dt.timedelta(days=i)).isoformat() for i in range((b - a).days)] if 0 < (b - a).days <= 31 else []


def week_flags(report):
    """(date, flag) for every flag the daily reports of the window raised."""
    out = []
    for d in window_days(report):
        flags = valid_flags({"date": d, "flags": (read_report(f"{d}-daily.json") or {}).get("flags", [])})
        out += [(d, f) for f in flags or []]
    return out


def digest_body(label, report, dashboard_url):
    cur, prev = report.get("current"), report.get("previous")
    days = window_days(report)
    fmt_usd = lambda v: "n/a" if v is None else f"${v:,.2f}"
    fmt_int = lambda v: "n/a" if v is None else f"{v:,.0f}"
    fmt_pct = lambda v: "n/a" if v is None else f"{v:g}%"
    metrics = (("Estimated spend", fmt_usd, ("populations", "interactive", "cost_usd")),
               ("Sessions", fmt_int, ("populations", "interactive", "sessions")),
               ("Linked PRs", fmt_int, ("populations", "interactive", "output", "linked_prs")),
               ("Cost per linked PR", fmt_usd, ("populations", "interactive", "linked_pr_cost", "cost_per_linked_pr_usd")),
               ("Peak weekly quota", fmt_pct, ("quota", "peak_seven_day_pct")))
    lines = [f"Weekly digest for {code(days[0] + ' to ' + days[-1] if days else label)}", "",
             "Interactive sessions, this week against the one before:", "",
             "| Metric | This week | Previous | Change |", "|---|---|---|---|"]
    for name, fmt, path in metrics:
        a, b = number(cur, *path), number(prev, *path)
        lines.append(f"| {name} | {fmt(a)} | {fmt(b)} | {change(a, b)} |")
    flags = week_flags(report)
    lines += ["", f"Flags raised ({len(flags)}):", ""]
    lines += [f"- {code(d)} {code(f['severity'])} {code(f['id'])}: {code(f['message'])}" for d, f in flags[:MAX_DIGEST_FLAGS]]
    if len(flags) > MAX_DIGEST_FLAGS:
        lines.append(f"- and {len(flags) - MAX_DIGEST_FLAGS} more in the daily reports")
    if not flags:
        lines.append("- none")
    if dashboard_url:
        lines += ["", f"Dashboard: {dashboard_url}", f"This report: {dashboard_url}reports/{label}-weekly.html"]
    return "\n".join(lines)


def cmd_digest(args):
    if args.date and not valid_date(args.date):
        usage_error("--date must be YYYY-MM-DD", "agent-notify digest [--dry-run] [--force] [--date YYYY-MM-DD]")
    found = latest_weekly(args.date)
    if found is None:
        what = f"for {args.date}" if args.date else "yet"
        am.emit({"sent": False, "reason": f"nothing to send: no weekly report {what} in {am.tilde(am.STORE / 'reports')}",
                 "help": "agent-report --window weekly writes one; the Monday 08:40 timer does it too"})
        return
    label, report = found
    body = digest_body(label, report, notify_cfg()["dashboard_url"])
    deliver("digest", label, body, args, {"report": label})


def cmd_show(_args):
    loaded = load_flags()
    if loaded is None or not loaded[1]:
        am.emit({"flags": "no flags to show"})
        return
    date, flags = loaded
    add_date("acked.json", date)
    am.emit({"date": date, "report": report_path(date),
             "flags": [{"severity": f["severity"], "id": f["id"], "message": f["message"]} for f in flags],
             "acknowledged": True})


class Parser(argparse.ArgumentParser):
    def error(self, message):
        usage_error(message)


def build_parser():
    p = Parser(prog="agent-notify", description="Daily metric flags: tracking-issue comment, shell nudge, review.")
    p.add_argument("-v", "--version", action="version", version=VERSION)
    sub = p.add_subparsers(dest="cmd", parser_class=Parser)
    s = sub.add_parser("send", help="comment today's flags on the tracking issue, once per date")
    s.add_argument("--dry-run", action="store_true", help="show the comment; call nothing, remember nothing")
    s.add_argument("--force", action="store_true", help="post even if this date is already recorded as notified")
    d = sub.add_parser("digest", help="comment the newest weekly report's summary on the digest issue, once per report")
    d.add_argument("--dry-run", action="store_true", help="show the comment; call nothing, remember nothing")
    d.add_argument("--force", action="store_true", help="post even if this report is already recorded as notified")
    d.add_argument("--date", help="the weekly report's date (YYYY-MM-DD) instead of the newest")
    sub.add_parser("shell", help="print a one-line nudge when flags are unacknowledged")
    sub.add_parser("show", help="print the flags in full and acknowledge them")
    return p


def main(argv):
    args = build_parser().parse_args(argv)
    {None: cmd_home, "send": cmd_send, "digest": cmd_digest, "show": cmd_show, "shell": lambda _a: shell_main()}[args.cmd](args)


if __name__ == "__main__":
    main(sys.argv[1:])
