#!/usr/bin/env python3
"""agent-report — periodic engineering-metrics reports from the agent-metrics store.

Turns the store's session rows, quota readings and ledger into a daily,
weekly, biweekly, monthly, quarterly or yearly report with deltas, flags and,
for longer windows, delivery metrics from GitHub and no-mistakes. Weekly and
monthly reports add one capped model call for commentary.
Agent-facing: stdout is TOON, diagnostics go to stderr.
"""
import argparse
import datetime as dt
import json
import math
import os
import re
import shutil
import sqlite3
import subprocess
import sys
import tempfile
import time
import urllib.parse
from pathlib import Path
from importlib.machinery import SourceFileLoader

VERSION = "1.0.0"

if __name__ == "__main__" and len(sys.argv) == 2 and sys.argv[1] in ("-v", "-V", "--version"):
    print(VERSION)
    sys.exit(0)

_here = Path(__file__).resolve().parent
# The deployed file is agent-metrics; in the source tree it carries chezmoi's prefix.
am = SourceFileLoader("agent_metrics", str(next(p for p in (_here / "agent-metrics", _here / "executable_agent-metrics")
                                                if p.exists()))).load_module()

EXIT_FAIL, EXIT_USAGE, EXIT_DENIED = am.EXIT_FAIL, am.EXIT_USAGE, am.EXIT_DENIED
emit, die, tilde = am.emit, am.die, am.tilde

WINDOWS = ("daily", "weekly", "biweekly", "monthly", "quarterly", "yearly")
USAGE_SHORT = "agent-report --window daily|weekly|biweekly|monthly|quarterly|yearly [--end YYYY-MM-DD] [--dry-run]"
# Fortnights are counted from this fixed Monday, the grid agent-audit uses.
FORTNIGHT_ANCHOR = dt.date(1970, 1, 5)
SCHEMA = 1
HOME_REPORTS = 8
THRESHOLD_KEYS = ("spend_warn_multiple", "spend_critical_multiple", "session_warn_usd",
                  "runaway_session_usd", "runaway_session_calls", "weekly_quota_warn_pct")


def log(msg):
    print(f"agent-report: {msg}", file=sys.stderr)


# ── Windows ──────────────────────────────────────────────────────────────────

def add_months(d, n):
    m = d.year * 12 + d.month - 1 + n
    return dt.date(m // 12, m % 12 + 1, 1)


def compute_windows(window, end):
    """((start, end), (prev_start, prev_end)) as dates, end exclusive. `end` is
    the day the run is anchored to: the window is the last complete one
    before it."""
    one = dt.timedelta
    if window in ("daily", "weekly", "biweekly"):
        monday = end - one(days=end.weekday())
        if window == "daily":
            e, span = end, one(days=1)
        elif window == "weekly":
            e, span = monday, one(days=7)
        else:
            # Snapping back to a grid Monday, not ISO-week parity: a 53-week
            # year puts two odd weeks back to back and parity would skip a
            # fortnight.
            e = monday - one(days=7 * (((monday - FORTNIGHT_ANCHOR).days // 7) % 2))
            span = one(days=14)
        return (e - span, e), (e - 2 * span, e - span)
    months = {"monthly": 1, "quarterly": 3, "yearly": 12}[window]
    first = dt.date(end.year, end.month, 1)
    if window == "quarterly":
        first = add_months(first, -((end.month - 1) % 3))
    elif window == "yearly":
        first = dt.date(end.year, 1, 1)
    return (add_months(first, -months), first), (add_months(first, -2 * months), add_months(first, -months))


# ── Config ───────────────────────────────────────────────────────────────────

def load_thresholds():
    cfg = am.load_config("thresholds.json")
    path = tilde(am.CONFIG / "thresholds.json")
    out = {}
    for k in THRESHOLD_KEYS:
        v = cfg.get(k)
        if not am.is_amount(v) or v <= 0:
            die(EXIT_USAGE, f"{path}: {k} must be a number above 0")
        out[k] = v
    if out["spend_warn_multiple"] > out["spend_critical_multiple"]:
        die(EXIT_USAGE, f"{path}: spend_warn_multiple must not exceed spend_critical_multiple")
    return out


# ── Store data ───────────────────────────────────────────────────────────────

POPULATIONS = ("interactive", "scripted")
TOP_N = 10
STAMP = re.compile(r"\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ")
FRICTION = ("tool_errors", "denials", "rate_limits", "api_errors", "compactions", "interrupts")
OUTPUT = ("commits", "pushes", "prs_created")
TIME = ("active_s", "idle_s", "wait_human_s")
TOKEN_FIELDS = ("input", "cache_read", "cache_write_5m", "cache_write_1h")
TOP_FIELDS = (("skills", "skills"), ("tools", "tools"), ("mcp", "mcp"), ("subagent_types", "subagent_types"))


def bad(path, what):
    die(EXIT_USAGE, f"{tilde(path)}: {what}", f"Fix or remove the line in {tilde(path)}")


def check_row(r, path):
    """A row that cannot be read as numbers stops the run: summing around it
    would report a quiet day that was not quiet."""
    sid = am.clean_id(r["session_id"])
    if not STAMP.fullmatch(r["started_at"]):
        bad(path, f"session {sid} has no usable started_at")
    if r.get("population") not in POPULATIONS:
        bad(path, f"session {sid} has no usable population")
    for k in ("cost_usd", *FRICTION, *OUTPUT, *TIME):
        if not am.is_amount(r.get(k)):
            bad(path, f"session {sid} has no usable {k}")
    for k in ("pipeline", "repo"):
        if r.get(k) is not None and not isinstance(r[k], str):
            bad(path, f"session {sid} has no usable {k}")
    models = r.get("models")
    if not isinstance(models, dict):
        bad(path, f"session {sid} has no usable models")
    for part in ("main", "subagent"):
        if not isinstance(models.get(part), dict):
            bad(path, f"session {sid} has no usable models.{part}")
        for name, m in models[part].items():
            ok = isinstance(m, dict) and all(am.is_amount(m.get(k)) for k in ("calls", *TOKEN_FIELDS)) \
                and (m.get("cost_usd") is None or am.is_amount(m["cost_usd"]))
            if not ok:
                bad(path, f"session {sid} has no usable usage for model {am.clean_id(name)}")
    for k, _ in TOP_FIELDS:
        d = r.get(k)
        if not isinstance(d, dict) or not all(am.is_amount(v) for v in d.values()):
            bad(path, f"session {sid} has no usable {k}")
    links = r.get("pr_links")
    if not isinstance(links, list) or not all(
            isinstance(x, dict) and isinstance(x.get("repo"), str) and isinstance(x.get("number"), int) for x in links):
        bad(path, f"session {sid} has no usable pr_links")
    if not isinstance(r.get("unpriced_models"), list):
        bad(path, f"session {sid} has no usable unpriced_models")


def series(kind, lo, hi, key, check):
    """Rows of a month-file series whose `key` stamp falls in [lo, hi). A line
    that is not a usable row names its file, because a gap would read as a
    quiet period."""
    rows = []
    for path in sorted((am.STORE / kind).glob("*.jsonl")):
        if not lo[:7] <= path.stem <= hi[:7]:
            continue
        for n, line in enumerate(path.read_text().splitlines(), 1):
            if not line.strip():
                continue
            try:
                r = json.loads(line)
                if not isinstance(r, dict):
                    raise ValueError
                stamp = r.get(key)
                if not (isinstance(stamp, str) and STAMP.fullmatch(stamp)):
                    raise ValueError
                check(r)
            except ValueError:
                die(EXIT_USAGE, f"{tilde(path)} line {n} is not a usable {kind} entry",
                    f"Fix or remove the line in {tilde(path)}")
            if lo <= stamp < hi:
                rows.append(r)
    return rows


def check_quota(r):
    for k in ("five_hour_pct", "seven_day_pct"):
        if r.get(k) is not None and not am.is_amount(r[k]):
            raise ValueError


def check_ledger(r):
    if not am.is_amount(r.get("usd")):
        raise ValueError


def load_sessions(lo, hi):
    rows = []
    for path in sorted((am.STORE / "sessions").glob("*.jsonl")):
        if not lo[:7] <= path.stem <= hi[:7]:
            continue
        for r in am.read_month(path).values():
            if lo <= r["started_at"] < hi:
                check_row(r, path)
                rows.append(r)
    return rows


def stamp(d):
    return f"{d.isoformat()}T00:00:00Z"


# ── Metrics ──────────────────────────────────────────────────────────────────

def top(rows, field):
    counts = {}
    for r in rows:
        for name, n in r[field].items():
            counts[am.clean_id(name)] = counts.get(am.clean_id(name), 0) + n
    return [{"name": k, "count": v} for k, v in sorted(counts.items(), key=lambda kv: (-kv[1], kv[0]))[:TOP_N]]


def ratio(num, den, digits=4):
    return round(num / den, digits) if den > 0 else None


def summarize_population(rows):
    cost = sum(r["cost_usd"] for r in rows)
    by_pipeline, models, tokens = {}, {}, dict.fromkeys(TOKEN_FIELDS, 0)
    for r in rows:
        key = am.clean_id(r["pipeline"]) if r["pipeline"] else "none"
        by_pipeline[key] = by_pipeline.get(key, 0) + r["cost_usd"]
        for part in ("main", "subagent"):
            for name, m in r["models"][part].items():
                agg = models.setdefault(am.clean_id(name), {"main_calls": 0, "main_cost_usd": 0.0,
                                                            "subagent_calls": 0, "subagent_cost_usd": 0.0})
                agg[f"{part}_calls"] += m["calls"]
                agg[f"{part}_cost_usd"] += m.get("cost_usd") or 0
                for t in TOKEN_FIELDS:
                    tokens[t] += m[t]
    linked = [r for r in rows if r["pr_links"]]
    distinct = {(x["repo"], x["number"]) for r in linked for x in r["pr_links"]}
    covered = sum(r["cost_usd"] for r in linked)
    write_total = tokens["cache_write_5m"] + tokens["cache_write_1h"]
    ordered = sorted(models.items(), key=lambda kv: (-(kv[1]["main_cost_usd"] + kv[1]["subagent_cost_usd"]), kv[0]))
    return {
        "sessions": len(rows),
        "cost_usd": round(cost, 4),
        "cost_by_pipeline": {k: round(v, 4) for k, v in sorted(by_pipeline.items())},
        "models": [{"model": k, **{f: round(v, 4) if isinstance(v, float) else v for f, v in agg.items()}}
                   for k, agg in ordered],
        "cache_read_share": ratio(tokens["cache_read"], tokens["cache_read"] + write_total + tokens["input"]),
        "friction": {k: sum(r[k] for r in rows) for k in FRICTION},
        "output": {**{k: sum(r[k] for r in rows) for k in OUTPUT}, "linked_prs": len(distinct)},
        "linked_pr_cost": {"covered_cost_usd": round(covered, 4),
                           "cost_per_linked_pr_usd": ratio(covered, len(distinct)),
                           "share_of_spend": ratio(covered, cost)},
        "time": {k: sum(r[k] for r in rows) for k in TIME},
        "top": {name: top(rows, field) for name, field in TOP_FIELDS},
    }


def peak(readings, key):
    vals = [r[key] for r in readings if r.get(key) is not None]
    return max(vals) if vals else None


def summarize_window(start, end):
    lo, hi = stamp(start), stamp(end)
    rows = load_sessions(lo, hi)
    readings = series("quota", lo, hi, "hour", check_quota)
    spend = series("ledger", lo, hi, "at", check_ledger)
    return {
        "populations": {p: summarize_population([r for r in rows if r["population"] == p]) for p in POPULATIONS},
        "unpriced_models": sorted({am.clean_id(m) for r in rows for m in r["unpriced_models"]}),
        "quota": {"peak_five_hour_pct": peak(readings, "five_hour_pct"),
                  "peak_seven_day_pct": peak(readings, "seven_day_pct"), "readings": len(readings)},
        "ledger": {"usd": round(sum(r["usd"] for r in spend), 4), "entries": len(spend)},
    }


def trend(window, label):
    """Up to six earlier reports of this window, oldest first."""
    rows = []
    for path in sorted((am.STORE / "reports").glob(f"*-{window}.json")):
        j = load_json_file(path)
        if not isinstance(j.get("label_date"), str):
            die(EXIT_USAGE, f"{tilde(path)} has no label_date")
        if j["label_date"] >= label:
            continue
        try:
            pops = j["current"]["populations"]
            entry = {"label_date": j["label_date"],
                     **{p: {"sessions": pops[p]["sessions"], "cost_usd": pops[p]["cost_usd"]} for p in POPULATIONS}}
            if not all(am.is_amount(v) for p in POPULATIONS for v in entry[p].values()):
                raise ValueError
        except (KeyError, TypeError, ValueError):
            die(EXIT_USAGE, f"{tilde(path)} has no usable populations", "Fix or remove the stored report")
        rows.append(entry)
    return sorted(rows, key=lambda r: r["label_date"])[-6:]


# ── Flags ────────────────────────────────────────────────────────────────────

TREND_DAYS = 7
SEVERITY_ORDER = {"critical": 0, "warn": 1}


def flag(fid, severity, metric, message, value, baseline):
    return {"id": fid, "severity": severity, "metric": metric, "message": message,
            "value": value, "baseline": baseline}


def daily_flags(rows, trailing_usd, peak_weekly, label, th):
    """Flags for one day. Messages are built from numbers and store
    identifiers only, so a flag can be shown anywhere without leaking text."""
    out = []
    spend = sum(r["cost_usd"] for r in rows)
    avg = trailing_usd / TREND_DAYS
    # With no spend in the trailing week there is no multiple to take.
    if avg > 0:
        x = spend / avg
        level = "critical" if x > th["spend_critical_multiple"] else "warn" if x > th["spend_warn_multiple"] else None
        if level:
            out.append(flag("day-spend", level, "day_spend_usd",
                            f"day spend ${spend:.2f} is {x:.1f}x the trailing {TREND_DAYS}-day daily average of ${avg:.2f}",
                            round(spend, 4), round(avg, 4)))
    for r in rows:
        sid = am.clean_id(r["session_id"])
        who = f"session {sid} ({am.clean_id(r['repo']) if r['repo'] else 'no repo'}, " \
              f"{am.clean_id(r['pipeline']) if r['pipeline'] else 'no pipeline'})"
        cost = r["cost_usd"]
        if cost > th["runaway_session_usd"]:
            out.append(flag(f"runaway-cost:{sid}", "critical", "session_cost_usd",
                            f"{who} cost ${cost:.2f}, above ${th['runaway_session_usd']:g}", round(cost, 4),
                            th["runaway_session_usd"]))
        elif cost > th["session_warn_usd"]:
            out.append(flag(f"session-cost:{sid}", "warn", "session_cost_usd",
                            f"{who} cost ${cost:.2f}, above ${th['session_warn_usd']:g}", round(cost, 4),
                            th["session_warn_usd"]))
        calls = sum(m["calls"] for part in r["models"].values() for m in part.values())
        if calls > th["runaway_session_calls"]:
            out.append(flag(f"runaway-calls:{sid}", "critical", "session_api_calls",
                            f"{who} made {calls:g} API calls, above {th['runaway_session_calls']:g}", calls,
                            th["runaway_session_calls"]))
    if peak_weekly is not None and peak_weekly >= th["weekly_quota_warn_pct"]:
        out.append(flag("weekly-quota", "warn", "weekly_quota_pct",
                        f"peak weekly plan quota {peak_weekly:g}% on {label}, at or above {th['weekly_quota_warn_pct']:g}%",
                        peak_weekly, th["weekly_quota_warn_pct"]))
    return sorted(out, key=lambda f: (SEVERITY_ORDER[f["severity"]], f["id"]))


def write_flags_file(report):
    """Other tools read this file, so it holds the newest daily run only and
    is removed when that run found nothing."""
    path = am.STATE / "flags.json"
    if report["flags"]:
        write_text(path, json.dumps({"date": report["label_date"], "window": "daily", "flags": report["flags"]}, indent=1) + "\n")
    else:
        path.unlink(missing_ok=True)


# ── Config inventory ─────────────────────────────────────────────────────────

AUDIT_WINDOWS = ("weekly", "biweekly", "monthly", "quarterly")


def audit_dir():
    return Path(os.environ.get("AGENT_REPORT_AUDIT_DIR")
                or Path(os.environ.get("XDG_DATA_HOME", am.HOME / ".local/share")) / "agent-audit/reports")


def scrub(v):
    """The audit's sections carry hook names that can be a fragment of
    injected text; only identifier-shaped strings pass into a report."""
    if isinstance(v, dict):
        return {scrub(k): scrub(x) for k, x in v.items()}
    if isinstance(v, list):
        return [scrub(x) for x in v]
    if not isinstance(v, str) or v == "":
        return v
    if v.startswith("unattributed"):
        return "unattributed"
    if v.startswith("~/"):
        rest = am.clean_id(v[2:])
        return "_invalid" if rest == "_invalid" else v
    return am.clean_id(v)


def embed_audit(window, label):
    if window not in AUDIT_WINDOWS:
        return None
    path = audit_dir() / f"{label}-{window}.json"
    if not path.exists():
        return None
    j = load_json_file(path)
    cur = j.get("current")
    hooks = cur.get("hooks") if isinstance(cur, dict) else None
    if not (isinstance(hooks, list) and isinstance(j.get("disable_candidates"), dict)
            and isinstance(j.get("instructions"), dict)):
        die(EXIT_USAGE, f"{tilde(path)} lacks the hooks, disable_candidates or instructions sections")
    return {"source": path.name, "hooks": scrub(hooks), "disable_candidates": scrub(j["disable_candidates"]),
            "instructions": scrub(j["instructions"])}


# ── Thresholds review ────────────────────────────────────────────────────────

# Each threshold maps to the flag metric it raises, and the severity that
# separates its own level from a neighbour's on the same metric.
FLAG_OF = {"spend_warn_multiple": ("day_spend_usd", None), "spend_critical_multiple": ("day_spend_usd", "critical"),
           "session_warn_usd": ("session_cost_usd", None), "runaway_session_usd": ("session_cost_usd", "critical"),
           "runaway_session_calls": ("session_api_calls", None), "weekly_quota_warn_pct": ("weekly_quota_pct", None)}
BUDGET_STATES_OF = {"plan_pct": ("critical-only", "stopped"), "hard_pct": ("stopped",),
                    "weekly_quota_cutoff_pct": ("quota-hold",)}


def thresholds_review(start, end, th):
    """How often each threshold fired in the month, counted from the stored
    daily reports. With no daily report the count is unknown, never zero."""
    daily = []
    for path in sorted((am.STORE / "reports").glob("*-daily.json")):
        j = load_json_file(path)
        label = j.get("label_date")
        if not isinstance(label, str) or not isinstance(j.get("flags"), list):
            die(EXIT_USAGE, f"{tilde(path)} has no label_date or flags")
        if start.isoformat() <= label < end.isoformat():
            daily.append(j)
    known = bool(daily)
    rows = []
    for key, value in th.items():
        metric, severity = FLAG_OF[key]
        n = sum(1 for j in daily for f in j["flags"] if f.get("metric") == metric and severity in (None, f.get("severity")))
        rows.append({"source": "thresholds.json", "key": key, "value": value, "fired": n if known else None})
    for key, value in am.budget_config().items():
        states = [((j.get("current") or {}).get("budget") or {}).get("state") for j in daily]
        seen = [x for x in states if x]
        rows.append({"source": "budget.json", "key": key, "value": value,
                     "fired": sum(1 for x in seen if x in BUDGET_STATES_OF[key]) if seen else None})
    return {"daily_reports": len(daily), "thresholds": rows}


# ── Delivery ─────────────────────────────────────────────────────────────────

GH_MAX_REQUESTS = int(os.environ.get("AGENT_REPORT_GH_MAX_REQUESTS", "60"))
GH_MAX_SECONDS = float(os.environ.get("AGENT_REPORT_GH_MAX_SECONDS", "300"))
# GitHub allows 30 search requests a minute; the gap keeps a run under it.
GH_GAP_S = float(os.environ.get("AGENT_REPORT_GH_GAP", "2.1"))
GH_PAGE = int(os.environ.get("AGENT_REPORT_GH_PAGE", "20"))
GH_CALL_TIMEOUT_S = 60
GH_SEARCH_CAP = 1000
GH_RATE_LIMITED = re.compile(r"rate limit|HTTP 403|HTTP 429|secondary", re.I)
FOLLOWUP_DAYS = (7, 14)
FOLLOWUP_OVERLAP = 0.5
FOLLOWUP_REF = re.compile(r"(fix/|revert)", re.I)
FOLLOWUP_TITLE = re.compile(r"revert", re.I)
NOISE_FILE = re.compile(r"(\.lock|\.lockb|\.md|\.mdx|\.markdown|package-lock\.json|npm-shrinkwrap\.json|go\.sum)$", re.I)
RED = ("FAILURE", "ERROR")

PR_QUERY = """query($q: String!, $first: Int!, $after: String) {
  search(query: $q, type: ISSUE, first: $first, after: $after) {
    issueCount
    pageInfo { hasNextPage endCursor }
    nodes { ... on PullRequest {
      number createdAt mergedAt additions deletions changedFiles
      repository { nameWithOwner }
      files(first: 100) { nodes { path } }
      allCommits: commits(first: 100) { totalCount nodes { commit { statusCheckRollup { state } } } }
      head: commits(last: 1) { nodes { commit { statusCheckRollup { state } } } }
    } }
  }
}"""

FOLLOWUP_QUERY = """query($q: String!, $first: Int!, $after: String) {
  search(query: $q, type: ISSUE, first: $first, after: $after) {
    issueCount
    pageInfo { hasNextPage endCursor }
    nodes { ... on PullRequest {
      number mergedAt headRefName title changedFiles
      files(first: 100) { nodes { path } }
    } }
  }
}"""


class DeliveryError(RuntimeError):
    pass


class Gh:
    """Every GitHub call of a run, counted and paced against the caps."""

    def __init__(self):
        self.requests = 0
        self.started = time.monotonic()
        self.next_at = 0.0

    def call(self, args):
        if not shutil.which("gh"):
            raise DeliveryError("gh is not installed")
        if self.requests >= GH_MAX_REQUESTS:
            raise DeliveryError(f"request cap of {GH_MAX_REQUESTS} reached")
        left = GH_MAX_SECONDS - (time.monotonic() - self.started)
        if left <= 0:
            raise DeliveryError(f"wall time cap of {GH_MAX_SECONDS:g}s reached")
        gap = self.next_at - time.monotonic()
        if gap > 0:
            time.sleep(min(gap, left))
        env = {k: v for k, v in os.environ.items()
               if k in ("GH_TOKEN", "GITHUB_TOKEN", "GH_ENTERPRISE_TOKEN") or not am.CRED_ENV.search(k)}
        env.update(GH_PROMPT_DISABLED="1", NO_COLOR="1")
        self.requests += 1
        try:
            r = subprocess.run(["gh", *args], capture_output=True, text=True, env=env,
                               timeout=max(1, min(GH_CALL_TIMEOUT_S, left)))
        except subprocess.TimeoutExpired:
            raise DeliveryError("a GitHub request timed out")
        self.next_at = time.monotonic() + GH_GAP_S
        if r.returncode != 0:
            first = (r.stderr.strip().splitlines() or ["unknown error"])[0][:160]
            raise DeliveryError(f"GitHub rate limited: {first}" if GH_RATE_LIMITED.search(r.stderr)
                                else f"GitHub request failed: {first}")
        return r.stdout

    def search(self, query, q):
        """Pages of one search: (nodes, issueCount). Stops at the search cap."""
        nodes, after, count = [], "", 0
        while True:
            args = ["api", "graphql", "-f", f"query={query}", "-f", f"q={q}", "-F", f"first={GH_PAGE}"]
            if after:
                args += ["-f", f"after={after}"]
            try:
                data = json.loads(self.call(args))
                if data.get("errors"):
                    raise DeliveryError("GitHub query failed: " + str(data["errors"][0].get("message"))[:160])
                result = data["data"]["search"]
                count = result["issueCount"]
                nodes += [n for n in result["nodes"] if isinstance(n, dict) and n]
                more, after = result["pageInfo"]["hasNextPage"], result["pageInfo"]["endCursor"] or ""
            except (ValueError, KeyError, TypeError, AttributeError):
                raise DeliveryError("GitHub returned an unexpected response")
            if not more or len(nodes) >= GH_SEARCH_CAP:
                return nodes, count


def stream_owners():
    """Owners to measure, from the stream map. A partial list would be
    reported as if it covered every stream, so a bad map fails the section."""
    path = am.HOME / ".config/streams.json"
    try:
        streams = json.loads(path.read_text())["streams"]
    except (OSError, ValueError, KeyError, TypeError) as e:
        raise DeliveryError(f"stream map {tilde(path)} unreadable: {type(e).__name__}")
    if not isinstance(streams, dict) or not streams or not all(re.fullmatch(r"[A-Za-z0-9-]+", o) for o in streams):
        raise DeliveryError(f"stream map {tilde(path)} has no usable owners")
    return list(streams)


def merged_prs(gh, query, base, start, end):
    """PRs matching `base` merged in [start, end), complete despite the
    1000-result search cap: a range whose count exceeds it is halved until it
    fits. Returns (nodes, truncated); truncated means one day alone exceeds it."""
    nodes, count = gh.search(query, f"{base} merged:{start.isoformat()}..{(end - dt.timedelta(days=1)).isoformat()}")
    days = (end - start).days
    if count <= GH_SEARCH_CAP:
        return nodes, False
    if days <= 1:
        return nodes, True
    mid = start + dt.timedelta(days=days // 2)
    a, ta = merged_prs(gh, query, base, start, mid)
    b, tb = merged_prs(gh, query, base, mid, end)
    return a + b, ta or tb


def ts(s):
    return dt.datetime.fromisoformat(s.replace("Z", "+00:00"))


def percentile(xs, q):
    xs = sorted(xs)
    return xs[max(0, math.ceil(q * len(xs)) - 1)]


def median(xs):
    xs = sorted(xs)
    n = len(xs)
    return xs[n // 2] if n % 2 else (xs[n // 2 - 1] + xs[n // 2]) / 2


def pr_files(node):
    return {n["path"] for n in node["files"]["nodes"] if not NOISE_FILE.search(n["path"])}


def followups(gh, prs, now_ts):
    """Share of merged PRs followed by a fix or revert PR in the same repo that
    touched at least half of their files, within 7 and 14 days. Only PRs old
    enough to have been watched that long count."""
    by_repo = {}
    for p in prs:
        by_repo.setdefault(p["repository"]["nameWithOwner"], []).append(p)
    out = {f"d{n}": {"eligible": 0, "followed_up": 0} for n in FOLLOWUP_DAYS}
    for repo, group in sorted(by_repo.items()):
        watch = [p for p in group if pr_files(p) and now_ts - ts(p["mergedAt"]) >= dt.timedelta(days=FOLLOWUP_DAYS[0])]
        if not watch:
            continue
        lo = min(ts(p["mergedAt"]) for p in watch).date()
        hi = min(max(ts(p["mergedAt"]) for p in watch) + dt.timedelta(days=FOLLOWUP_DAYS[-1]), now_ts).date()
        later, count = gh.search(FOLLOWUP_QUERY, f"repo:{repo} is:pr is:merged merged:{lo.isoformat()}..{hi.isoformat()}")
        if count > GH_SEARCH_CAP:
            raise DeliveryError(f"{repo} has more than {GH_SEARCH_CAP} merged PRs in the follow-up range")
        fixes = [c for c in later if c.get("mergedAt") and (FOLLOWUP_REF.match(c.get("headRefName") or "")
                                                          or FOLLOWUP_TITLE.match(c.get("title") or ""))]
        for p in watch:
            mine, merged = pr_files(p), ts(p["mergedAt"])
            for n in FOLLOWUP_DAYS:
                if now_ts - merged < dt.timedelta(days=n):
                    continue
                key = out[f"d{n}"]
                key["eligible"] += 1
                if any(c["number"] != p["number"] and merged < ts(c["mergedAt"]) <= merged + dt.timedelta(days=n)
                       and len(mine & pr_files(c)) / len(mine) >= FOLLOWUP_OVERLAP for c in fixes):
                    key["followed_up"] += 1
    for v in out.values():
        v["rate"] = ratio(v["followed_up"], v["eligible"])
    return out


def github_delivery(start, end):
    gh = Gh()
    try:
        owners = stream_owners()
        login = gh.call(["api", "user", "--jq", ".login"]).strip()
        if not re.fullmatch(r"[A-Za-z0-9-]+", login):
            raise DeliveryError("could not resolve the GitHub login")
        base = f"is:pr is:merged author:{login} " + " ".join(f"user:{o}" for o in owners)
        prs, truncated = merged_prs(gh, PR_QUERY, base, start, end)
        hours = [(ts(p["mergedAt"]) - ts(p["createdAt"])).total_seconds() / 3600 for p in prs]
        lines = [p["additions"] + p["deletions"] for p in prs]
        failed = [any(((c["commit"].get("statusCheckRollup") or {}).get("state") in RED) for c in p["allCommits"]["nodes"]) for p in prs]
        red = [any(((c["commit"].get("statusCheckRollup") or {}).get("state") in RED) for c in p["head"]["nodes"]) for p in prs]
        out = {"available": True, "owners": owners, "truncated": truncated, "merged": len(prs),
               "open_to_merge_hours": {"median": round(median(hours), 2) if hours else None,
                                       "p90": round(percentile(hours, 0.9), 2) if hours else None},
               "lines_changed_median": round(median(lines), 1) if lines else None,
               "failed_check_share": ratio(sum(failed), len(prs)), "red_head_share": ratio(sum(red), len(prs)),
               "commits_truncated": sum(1 for p in prs if p["allCommits"]["totalCount"] > len(p["allCommits"]["nodes"])),
               "files_truncated": sum(1 for p in prs if p["changedFiles"] > len(p["files"]["nodes"]))}
    except (DeliveryError, KeyError, TypeError, ValueError) as e:
        return {"errored": True, "reason": (str(e) if isinstance(e, DeliveryError) else f"unexpected GitHub data: {type(e).__name__}")[:200]}
    try:
        out["followup"] = followups(gh, prs, am.now())
    except (DeliveryError, KeyError, TypeError, ValueError) as e:
        out["followup"] = {"errored": True,
                           "reason": (str(e) if isinstance(e, DeliveryError) else f"unexpected GitHub data: {type(e).__name__}")[:200]}
    return out


def no_mistakes_delivery(start, end):
    path = Path(os.environ.get("AGENT_REPORT_NM_DB") or am.HOME / ".no-mistakes/state.sqlite")
    if not path.is_file():
        return {"errored": True, "reason": f"{tilde(path)} not found"}
    lo = int(dt.datetime.combine(start, dt.time(), dt.timezone.utc).timestamp())
    hi = int(dt.datetime.combine(end, dt.time(), dt.timezone.utc).timestamp())
    try:
        conn = sqlite3.connect(f"file:{urllib.parse.quote(str(path))}?mode=ro", uri=True, timeout=5)
        try:
            rows = conn.execute(
                "select r.status, (select count(*) from step_rounds sr join step_results s on s.id = sr.step_result_id "
                "where s.run_id = r.id and sr.trigger_type = 'auto_fix') from runs r "
                "where r.created_at >= ? and r.created_at < ?", (lo, hi)).fetchall()
        finally:
            conn.close()
    except sqlite3.Error as e:
        return {"errored": True, "reason": f"{tilde(path)} unreadable: {type(e).__name__}"}
    terminal = [r for r in rows if r[0] in ("completed", "failed", "cancelled")]
    first_pass = sum(1 for status, fixes in terminal if status == "completed" and fixes == 0)
    count = lambda s: sum(1 for r in rows if r[0] == s)
    # Runs still going cannot have passed first time yet, so they stay out of the rate.
    return {"available": True, "runs": len(terminal), "completed": count("completed"), "failed": count("failed"),
            "cancelled": count("cancelled"), "in_progress": len(rows) - len(terminal), "first_pass_runs": first_pass,
            "first_pass_rate": ratio(first_pass, len(terminal))}


def delivery(opts, cs, ce):
    if opts.window == "daily":
        return {"skipped": "daily window"}
    github = {"skipped": "--no-github"} if opts.no_github else github_delivery(cs, ce)
    return {"github": github, "no_mistakes": no_mistakes_delivery(cs, ce)}


# ── Insights (one capped model call) ─────────────────────────────────────────

INSIGHTS_WINDOWS = ("weekly", "monthly")
INSIGHTS_MODEL = "sonnet"
INSIGHTS_BUDGET_USD = "0.50"
INSIGHTS_NEED_USD = 0.5
INSIGHTS_WORDS = 250
INSIGHTS_TIMEOUT_S = int(os.environ.get("AGENT_REPORT_INSIGHTS_TIMEOUT", "240"))
LIST_CAP = 40

INSIGHTS_PROMPT = """You review one developer's AI coding-agent usage. Below is a metrics JSON for the
current window and the previous equal window, plus earlier history and, when
present, delivery metrics and the config inventory. Write at most {words} words
of markdown with three short bullet groups: **Trends**, **Anomalies**,
**Suggested changes**. Be concrete: name the model, pipeline, skill, hook or
flag, and quantify with the numbers given. Scripted and interactive sessions
are separate populations: never blend them. Dollar figures are list-price
estimates, not bills. Never report "hours saved" or any other self-estimated
time saving; state only what the numbers measure. A delivery section marked
errored is unknown, not zero. No preamble, no closing line.

METRICS:
"""


def capped(v):
    if isinstance(v, dict):
        return {k: capped(x) for k, x in v.items()}
    if isinstance(v, list):
        out = [capped(x) for x in v[:LIST_CAP]]
        return out + [f"... {len(v) - LIST_CAP} more"] if len(v) > LIST_CAP else out
    return v


def insights_input(report):
    return json.dumps(capped({k: v for k, v in report.items() if k != "insights"}), separators=(",", ":"))


def record_spend(run, usd):
    """Append to the ledger exactly as `agent-metrics budget record` does."""
    am.ledger_spent()
    at = am.iso(am.now().timestamp())
    path = am.month_file("ledger", at)
    path.parent.mkdir(parents=True, exist_ok=True)
    entry = {"at": at, "run": am.clean_id(run), "usd": usd, "critical": False}
    with open(path, "a") as fh:
        fh.write(json.dumps(entry, sort_keys=True, separators=(",", ":")) + "\n")


def first_words(text, n):
    words = list(re.finditer(r"\S+", text))
    return text if len(words) <= n else text[:words[n - 1].end()] + " …"


def run_insights(report):
    claude = shutil.which("claude") or str(am.HOME / ".local/bin/claude")
    if not os.access(claude, os.X_OK):
        return {"error": "claude CLI not found"}
    # An empty working directory and project-only settings load no user
    # plugins, hooks or MCP servers, so the call costs what its prompt costs.
    # No persisted session keeps it out of the next collect's numbers.
    cmd = [claude, "-p", "--model", INSIGHTS_MODEL, "--tools", "", "--strict-mcp-config", "--setting-sources", "project",
           "--max-turns", "1", "--max-budget-usd", INSIGHTS_BUDGET_USD, "--no-session-persistence",
           "--output-format", "json"]
    prompt = INSIGHTS_PROMPT.format(words=INSIGHTS_WORDS) + insights_input(report)
    with tempfile.TemporaryDirectory(prefix="agent-report-insights-") as cwd:
        try:
            r = subprocess.run(cmd, input=prompt, capture_output=True, text=True, timeout=INSIGHTS_TIMEOUT_S,
                               cwd=cwd, env=am.child_env())
        except subprocess.TimeoutExpired:
            return {"error": f"timed out after {INSIGHTS_TIMEOUT_S}s"}
        except OSError as e:
            return {"error": f"could not start claude: {e.strerror}"}
    try:
        j = json.loads(r.stdout)
    except ValueError:
        j = None
    j = j if isinstance(j, dict) else {}
    cost = j.get("total_cost_usd")
    # Money the call spent is recorded whether or not it produced text.
    if am.is_amount(cost) and cost > 0:
        record_spend(f"report-{report['window']}", cost)
    if r.returncode != 0:
        return {"error": f"claude exited {r.returncode}"}
    if not j:
        return {"error": "claude returned non-JSON output"}
    if j.get("is_error") or not isinstance(j.get("result"), str) or not j["result"].strip():
        return {"error": f"claude reported an error ({j.get('subtype') or j.get('terminal_reason') or 'no result'})"}
    return {"text": first_words(j["result"].strip(), INSIGHTS_WORDS), "cost_usd": round(cost, 4) if am.is_amount(cost) else None}


def insights(opts, report):
    if opts.window not in INSIGHTS_WINDOWS:
        return {"skipped": "window"}
    if opts.no_insights:
        return {"skipped": "--no-insights"}
    if opts.dry_run:
        return {"skipped": "dry-run"}
    state = am.budget_state(need=INSIGHTS_NEED_USD)
    if not state["allowed"]:
        return {"skipped": "budget", "state": state}
    log("requesting insights (one capped claude call)")
    out = run_insights(report)
    if "error" in out:
        log(f"insights failed: {out['error']}")
    return out


# ── Report ───────────────────────────────────────────────────────────────────

def build_report(opts, w, th):
    (cs, ce), (ps, pe) = w
    label = (ce - dt.timedelta(days=1)).isoformat()
    current = summarize_window(cs, ce)
    flags = []
    if opts.window == "daily":
        flags = daily_flags(load_sessions(stamp(cs), stamp(ce)),
                            sum(r["cost_usd"] for r in load_sessions(stamp(cs - dt.timedelta(days=TREND_DAYS)), stamp(cs))),
                            current["quota"]["peak_seven_day_pct"], label, th)
        # The gate's state when the day was reported, which the monthly
        # thresholds review counts.
        current["budget"] = am.budget_state()
    if opts.window == "monthly":
        current["thresholds_review"] = thresholds_review(cs, ce, th)
    return {
        "schema": SCHEMA, "window": opts.window, "start": cs.isoformat(), "end": ce.isoformat(),
        "label_date": label, "generated_at": am.iso(am.now().timestamp()),
        "current": current,
        "previous": {"start": ps.isoformat(), "end": pe.isoformat(), **summarize_window(ps, pe)},
        "trend": trend(opts.window, label),
        "flags": flags, "delivery": delivery(opts, cs, ce), "audit": embed_audit(opts.window, label), "insights": None,
    }


def write_text(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(text)
    os.replace(tmp, path)


# ── Markdown ─────────────────────────────────────────────────────────────────

def usd(v):
    return "n/a" if v is None else f"${v:,.2f}"


def num(v):
    return "n/a" if v is None else f"{v:,}" if isinstance(v, int) else f"{v:,.4g}"


def pct_share(v):
    return "n/a" if v is None else f"{v * 100:.1f}%"


def change(cur, prev):
    if cur is None or prev is None:
        return "n/a"
    if prev == 0:
        return "0" if cur == 0 else "new"
    return f"{(cur - prev) / prev * 100:+.0f}%"


def table(headers, rows):
    lines = ["| " + " | ".join(headers) + " |", "|" + "|".join("---" for _ in headers) + "|"]
    lines += ["| " + " | ".join(str(c) for c in row) + " |" for row in rows]
    return lines


LABELS = {"api_errors": "API errors", "prs_created": "PRs created", "linked_prs": "Linked PRs", "wait_human_s": "Waiting on a human",
          "active_s": "Active", "idle_s": "Idle"}


def label(key):
    return LABELS.get(key) or key.replace("_", " ").capitalize()


def population_rows(c, p):
    f, o, t, lp = c["friction"], c["output"], c["time"], c["linked_pr_cost"]
    pf, po, pt, plp = p["friction"], p["output"], p["time"], p["linked_pr_cost"]
    rows = [("Sessions", num(c["sessions"]), num(p["sessions"]), change(c["sessions"], p["sessions"])),
            ("Estimated cost (list price)", usd(c["cost_usd"]), usd(p["cost_usd"]), change(c["cost_usd"], p["cost_usd"])),
            ("Cache read share", pct_share(c["cache_read_share"]), pct_share(p["cache_read_share"]), "")]
    rows += [(label(k), num(f[k]), num(pf[k]), change(f[k], pf[k])) for k in FRICTION]
    rows += [(label(k), num(o[k]), num(po[k]), change(o[k], po[k])) for k in (*OUTPUT, "linked_prs")]
    rows += [("Cost per linked PR (list price)", usd(lp["cost_per_linked_pr_usd"]), usd(plp["cost_per_linked_pr_usd"]), ""),
             ("Spend covered by linked PRs", pct_share(lp["share_of_spend"]), pct_share(plp["share_of_spend"]), "")]
    rows += [(f"{label(k)} (h)", f"{t[k] / 3600:.1f}", f"{pt[k] / 3600:.1f}", change(t[k], pt[k])) for k in TIME]
    return rows


def render_population(name, c, p):
    lines = [f"## {name.capitalize()}", ""]
    lines += table(["Metric", "This window", "Previous", "Change"], population_rows(c, p))
    if c["cost_by_pipeline"]:
        lines += ["", "Cost by pipeline (list price): " + ", ".join(f"{k} {usd(v)}" for k, v in c["cost_by_pipeline"].items())]
    if c["models"]:
        lines += [""] + table(["Model", "Main calls", "Main cost", "Subagent calls", "Subagent cost"],
                              [(m["model"], num(m["main_calls"]), usd(m["main_cost_usd"]), num(m["subagent_calls"]),
                                usd(m["subagent_cost_usd"])) for m in c["models"]])
    for label, key in (("Skills", "skills"), ("Tools", "tools"), ("MCP servers", "mcp"), ("Subagent types", "subagent_types")):
        if c["top"][key]:
            lines += ["", f"{label}: " + ", ".join(f"{x['name']} {x['count']}" for x in c["top"][key])]
    return lines + [""]


def render_flags(flags):
    if not flags:
        return ["## Flags", "", "None.", ""]
    return ["## Flags", ""] + [f"- **{f['severity']}** `{f['id']}`: {f['message']}" for f in flags] + [""]


def render_quota_ledger(cur, prev):
    q, pq = cur["quota"], prev["quota"]
    lines = ["## Plan quota and audit spend", ""]
    lines += table(["Metric", "This window", "Previous"],
                   [("Peak five-hour quota used", num(q["peak_five_hour_pct"]) + ("%" if q["peak_five_hour_pct"] is not None else ""),
                     num(pq["peak_five_hour_pct"]) + ("%" if pq["peak_five_hour_pct"] is not None else "")),
                    ("Peak weekly quota used", num(q["peak_seven_day_pct"]) + ("%" if q["peak_seven_day_pct"] is not None else ""),
                     num(pq["peak_seven_day_pct"]) + ("%" if pq["peak_seven_day_pct"] is not None else "")),
                    ("Hourly readings", num(q["readings"]), num(pq["readings"])),
                    ("Audit model spend (list price)", usd(cur["ledger"]["usd"]), usd(prev["ledger"]["usd"]))])
    return lines + [""]


def render_trend(rows):
    if not rows:
        return []
    lines = ["## Trend", "", "Earlier reports of this window, oldest first.", ""]
    lines += table(["Label date", "Interactive sessions", "Interactive cost", "Scripted sessions", "Scripted cost"],
                   [(r["label_date"], num(r["interactive"]["sessions"]), usd(r["interactive"]["cost_usd"]),
                     num(r["scripted"]["sessions"]), usd(r["scripted"]["cost_usd"])) for r in rows])
    return lines + [""]


def errored(section):
    return f"Errored, so unknown rather than zero: {section.get('reason')}."


def render_delivery(r):
    d = r["delivery"]
    if not d or "skipped" in d:
        return []
    lines = ["## Delivery", ""]
    g = d["github"]
    if "skipped" in g:
        lines += [f"GitHub metrics skipped ({g['skipped']}).", ""]
    elif g.get("errored"):
        lines += ["### Merged PRs", "", errored(g), ""]
    else:
        h, f = g["open_to_merge_hours"], g["followup"]
        rows = [("Merged PRs", num(g["merged"])), ("Open to merge, median (h)", num(h["median"])), ("Open to merge, p90 (h)", num(h["p90"])),
                ("Lines changed per PR, median", num(g["lines_changed_median"])),
                ("Merged with a failed-check commit", pct_share(g["failed_check_share"])),
                ("Merged with a red head commit", pct_share(g["red_head_share"]))]
        for n in FOLLOWUP_DAYS:
            k = f"d{n}"
            rows.append((f"Follow-up fix within {n} days", errored(f) if f.get("errored") else
                         f"{pct_share(f[k]['rate'])} ({f[k]['followed_up']} of {f[k]['eligible']} watched that long)"))
        lines += ["### Merged PRs", ""] + table(["Metric", "Value"], rows)
        if g["truncated"] or g["commits_truncated"] or g["files_truncated"]:
            lines += ["", f"Incomplete: search truncated {g['truncated']}, PRs with over 100 commits {g['commits_truncated']}, "
                      f"PRs with over 100 files {g['files_truncated']}."]
        lines.append("")
    n = d["no_mistakes"]
    lines += ["### no-mistakes", ""]
    if n.get("errored"):
        lines += [errored(n)]
    else:
        lines += table(["Metric", "Value"], [("Finished runs", num(n["runs"])), ("Completed", num(n["completed"])),
                                              ("Failed", num(n["failed"])), ("Cancelled", num(n["cancelled"])),
                                              ("Still running", num(n["in_progress"])),
                                              ("First-pass rate", pct_share(n["first_pass_rate"]))])
    return lines + [""]


def render_audit(r):
    if r["window"] not in AUDIT_WINDOWS:
        return []
    a = r["audit"]
    lines = ["## Config inventory", ""]
    if not a:
        return lines + [f"The config inventory was not available: no audit report for {r['label_date']} {r['window']}.", ""]
    hooks = sorted(a["hooks"], key=lambda h: -(h.get("bytes") or 0))[:10]
    lines += [f"From `{a['source']}`.", "", "Injected context by hook:", ""]
    lines += table(["Plugin", "Event", "Fires", "Bytes"], [(h.get("plugin"), h.get("event"), num(h.get("fires")), num(h.get("bytes")))
                                                          for h in hooks])
    dc = a["disable_candidates"]
    lines += ["", "Disable candidates: "
              + ", ".join(f"{k} {len(dc.get(k) or [])}" for k in ("plugins", "mcp_servers", "skills", "agents"))]
    for p in dc.get("plugins") or []:
        lines.append(f"- plugin {p.get('plugin')}: {num(p.get('hook_bytes'))} hook bytes")
    files = (a["instructions"].get("files") or [])
    if files:
        lines += ["", "Instruction files:", ""]
        lines += table(["Path", "Lines", "Bytes", "Flag"], [(f.get("path"), num(f.get("lines")), num(f.get("bytes")), f.get("flag") or "")
                                                            for f in files])
    return lines + [""]


def render_thresholds(r):
    t = r["current"].get("thresholds_review")
    if not t:
        return []
    lines = ["## Thresholds review", "",
             f"Counted from {t['daily_reports']} stored daily reports in the month; n/a means there was nothing to count.", ""]
    lines += table(["File", "Threshold", "Value", "Fired"], [(x["source"], x["key"], num(x["value"]), num(x["fired"])) for x in t["thresholds"]])
    return lines + [""]


def render_insights(r):
    i = r["insights"]
    if i.get("text"):
        return ["## Insights", "", "Written by a model from the numbers above; check them before acting.", "", i["text"], ""]
    if i.get("skipped") == "window":
        return []
    why = f"skipped ({i['skipped']})" if "skipped" in i else f"failed ({i.get('error')})"
    return ["## Insights", "", f"Not generated: {why}.", ""]


SECTION_RENDERERS = [render_delivery, render_audit, render_thresholds, render_insights]


def render(r):
    cur, prev = r["current"], r["previous"]
    lines = [f"# Agent report: {r['window']} {r['start']} to {r['label_date']}", "",
             f"Generated {r['generated_at']}. All windows are UTC. Dollar figures are list-price estimates, not bills: "
             "on a subscription they are an index of relative use, and the quota percentages are the real limit. "
             f"Scripted (pipeline-launched) and interactive sessions are reported separately. "
             f"Previous window: {prev['start']} to {prev['end']} (end exclusive).", ""]
    if cur["unpriced_models"]:
        lines += [f"Models without a price, left out of cost: {', '.join(cur['unpriced_models'])}.", ""]
    lines += render_flags(r["flags"])
    for name in POPULATIONS:
        lines += render_population(name, cur["populations"][name], prev["populations"][name])
    lines += render_quota_ledger(cur, prev)
    lines += render_trend(r["trend"])
    for fn in SECTION_RENDERERS:
        lines += fn(r)
    return "\n".join(lines).rstrip() + "\n"


def write_outputs(report, directory):
    stem = f"{report['label_date']}-{report['window']}"
    paths = {"json": directory / f"{stem}.json", "md": directory / f"{stem}.md"}
    write_text(paths["json"], json.dumps(report, indent=1) + "\n")
    write_text(paths["md"], render(report))
    return paths


# ── Commands ─────────────────────────────────────────────────────────────────

def load_json_file(path):
    try:
        data = json.loads(path.read_text())
    except (OSError, ValueError) as e:
        die(EXIT_USAGE, f"cannot read {tilde(path)}: {getattr(e, 'strerror', None) or e}")
    if not isinstance(data, dict):
        die(EXIT_USAGE, f"{tilde(path)} must hold a JSON object")
    return data


def total_cost(rep):
    pops = ((rep.get("current") or {}).get("populations")) or {}
    return round(sum(p.get("cost_usd", 0) for p in pops.values()), 4)


def cmd_home():
    out = {"bin": tilde(Path(sys.argv[0]).resolve()),
           "description": "Periodic engineering-metrics reports from the agent-metrics store; writes JSON and Markdown under the store's reports/",
           "store": tilde(am.STORE)}
    if not am.store_exists():
        out["status"] = "store not cloned"
        out["help"] = ["Run `agent-metrics init` to clone the store"]
        emit(out)
        return 0
    files = sorted((am.STORE / "reports").glob("*.json"), reverse=True)
    rows = []
    for p in files[:HOME_REPORTS]:
        j = load_json_file(p)
        rows.append({"report": p.stem, "cost_usd": total_cost(j), "flags": len(j.get("flags") or [])})
    out["count"] = f"{len(rows)} of {len(files)} reports"
    out["reports"] = rows if rows else "0 reports yet"
    out["help"] = ["Run `agent-report --window daily --dry-run` to preview a report",
                   "Run `agent-report --window weekly` to write and publish one",
                   "Run `agent-report --help` for all flags"]
    emit(out)
    return 0


def cmd_run(args):
    try:
        end = dt.date.fromisoformat(args.end) if args.end else am.now().date()
    except ValueError:
        am.usage_error(f"--end must be YYYY-MM-DD, got {args.end}", USAGE_SHORT)
    am.require_store()
    th = load_thresholds()
    w = compute_windows(args.window, end)
    if args.dry_run:
        report = build_report(args, w, th)
        report["insights"] = insights(args, report)
        paths = write_outputs(report, Path(tempfile.mkdtemp(prefix="agent-report-")))
        result = {"dry_run": True}
    else:
        with am.Lock():
            report = build_report(args, w, th)
            report["insights"] = insights(args, report)
            paths = write_outputs(report, am.STORE / "reports")
            if args.window == "daily":
                write_flags_file(report)
            try:
                result = {"dry_run": False, **am.publish(f"report: {report['label_date']} {report['window']}")}
            except RuntimeError as e:
                die(EXIT_FAIL, str(e), f"Inspect with `git -C {tilde(am.STORE)} status`")
    emit({**result, "window": report["window"], "start": report["start"], "end": report["end"],
          "label_date": report["label_date"], "previous_start": report["previous"]["start"],
          "flags": len(report["flags"]), **{k: str(v) for k, v in paths.items()}})
    return EXIT_FAIL if result.get("pushed") is False else 0


class Parser(argparse.ArgumentParser):
    def error(self, message):
        am.usage_error(message, f"Run `{self.prog} --help`")


def build_parser():
    p = Parser(prog="agent-report", description=__doc__.split("\n\n")[1],
               formatter_class=argparse.RawDescriptionHelpFormatter,
               epilog="examples:\n  agent-report --window daily --dry-run            preview yesterday's report\n"
                      "  agent-report --window weekly --end 2026-10-05    the week before that Monday\n"
                      "  agent-report --window monthly --no-github        skip GitHub delivery metrics")
    p.add_argument("--window", required=True, choices=WINDOWS)
    p.add_argument("--end", metavar="YYYY-MM-DD", help="report the window ending before this date (default: today, UTC)")
    p.add_argument("--dry-run", action="store_true", help="write to a temp dir; touch no store, flag file or ledger; no model call")
    p.add_argument("--no-insights", action="store_true", help="skip the model commentary")
    p.add_argument("--no-github", action="store_true", help="skip the GitHub delivery metrics")
    return p


def main(argv):
    if not argv:
        return cmd_home()
    return cmd_run(build_parser().parse_args(argv))


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
