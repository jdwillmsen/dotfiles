#!/usr/bin/env bash
# agent-secrets-sync — write the API keys agent CLIs read from the environment
# into ~/.config/agent-secrets.env (mode 600), sourced by exports.sh and loaded
# into t3code.service by a drop-in. Values never reach stdout or git.
# Vault is the source of truth; the cluster's ExternalSecret copy is the
# fallback because this box usually holds a kubeconfig but no Vault token.
# Usage: agent-secrets-sync [--check]
#   --check — report which keys are present in the file; change nothing.
set -euo pipefail

out="${AGENT_SECRETS_FILE:-$HOME/.config/agent-secrets.env}"

# env var | Vault kv path/field | k8s namespace/secret/key
keys=(
  "PLATFORMCTL_JDWLABS_NVIDIA_API_KEY|litellm/nvidia_api_key|ai-sre/litellm-secrets/NVIDIA_NIM_API_KEY"
)

if [ "${1:-}" = "--check" ]; then
  echo "file: $out"
  for row in "${keys[@]}"; do
    var="${row%%|*}"
    if [ -r "$out" ] && grep -q "^${var}=." "$out"; then echo "  $var: present"; else echo "  $var: missing"; fi
  done
  exit 0
fi

fetch() {
  local vault_ref="$1" k8s_ref="$2" val=""
  if command -v vault >/dev/null && vault token lookup >/dev/null 2>&1; then
    val="$(vault kv get -field="${vault_ref#*/}" "kv/${vault_ref%%/*}" 2>/dev/null || true)"
    [ -n "$val" ] && { printf '%s' "$val"; echo vault >&3; return; }
  fi
  if command -v kubectl >/dev/null; then
    local ns="${k8s_ref%%/*}" rest="${k8s_ref#*/}"
    val="$(kubectl get secret --request-timeout=10s -n "$ns" "${rest%%/*}" -o "jsonpath={.data.${rest#*/}}" 2>/dev/null | base64 -d 2>/dev/null || true)"
    [ -n "$val" ] && { printf '%s' "$val"; echo kubectl >&3; return; }
  fi
  return 0
}

mkdir -p "$(dirname "$out")"
tmp="$(mktemp "${out}.XXXXXX")"
trap 'rm -f "$tmp" "$tmp.src"' EXIT
chmod 600 "$tmp"
failed=0
for row in "${keys[@]}"; do
  IFS='|' read -r var vault_ref k8s_ref <<< "$row"
  val="$(fetch "$vault_ref" "$k8s_ref" 3>"$tmp.src")"
  # The file is both sourced as shell and parsed by systemd's EnvironmentFile=;
  # this character set means the same thing to both, so a value outside it is
  # refused rather than quoted.
  if [ -n "$val" ] && ! [[ $val =~ ^[A-Za-z0-9._~+/=-]+$ ]]; then
    echo "  ✖ $var: value has characters unsafe to source — check the stored secret"
    failed=1
  elif [ -n "$val" ]; then
    printf '%s=%s\n' "$var" "$val" >> "$tmp"
    echo "  ✔ $var (from $(cat "$tmp.src"))"
  else
    echo "  ✖ $var: not found in Vault (kv/$vault_ref) or the cluster ($k8s_ref) — run 'vault login' or check kubectl access"
    failed=1
  fi
done
[ "$failed" = 0 ] || exit 1
mv "$tmp" "$out"
echo "wrote $out — restart t3code.service to load it: systemctl --user restart t3code"
