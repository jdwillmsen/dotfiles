#!/usr/bin/env python3
"""agent-trends — a static site of the metrics store's trends and reports.

Reads sessions, quota and provider-limit readings and stored reports from the store and writes
`site/index.html` and a `site/reports/<date>-<window>.html` page per stored
report into it: inline CSS and SVG, no external request of any kind. Dollar
figures are list-price estimates, not a bill. Agent-facing: stdout is TOON,
diagnostics go to stderr.
"""
import argparse
import datetime as dt
import html
import json
import math
import re
import sys
import tempfile
from importlib.machinery import SourceFileLoader
from pathlib import Path

VERSION = "1.0.0"

if __name__ == "__main__" and len(sys.argv) == 2 and sys.argv[1] in ("-v", "-V", "--version"):
    print(VERSION)
    sys.exit(0)

_here = Path(__file__).resolve().parent
am = SourceFileLoader("agent_metrics", str(next(p for p in (_here / "agent-metrics", _here / "executable_agent-metrics") if p.exists()))).load_module()

USAGE_SHORT = "agent-trends [build [--days N] [--delivery-only] [--dry-run] [--out DIR]] [--help]"
DAY = 86400
DEFAULT_DAYS = 90
FAMILIES = ("opus", "sonnet", "haiku", "other")
POPULATIONS = ("interactive", "scripted")
REPORT_NAME = re.compile(r"([0-9]{4}-[0-9]{2}-[0-9]{2})-(daily|weekly|biweekly|monthly|quarterly|yearly)\.json", re.ASCII)
REPORT_MD = re.compile(r"([0-9]{4}-[0-9]{2}-[0-9]{2})-(daily|weekly|biweekly|monthly|quarterly|yearly)\.md", re.ASCII)
WINDOW_ORDER = ("daily", "weekly", "biweekly", "monthly", "quarterly", "yearly")
MAX_FLAG_ROWS = 30
TOP_N = 8
MAX_DAYS = 180
# Past this age a provider reading no longer says where the limit stands now.
STALE_S = 36 * 3600
HEADLINE_IDS = ("totalPercentUsed", "seven_day", "primary")
MAX_PROVIDER_LINES = 4
# Nothing in the store is anywhere near this; a larger value is corruption, and
# summing two of them would overflow a float.
PLAUSIBLE_MAX = 1e15
ID_SHOW = 64


def usage_error(msg, help_line=None):
    am.die(am.EXIT_USAGE, msg, help_line or USAGE_SHORT)


def esc(x):
    return html.escape(str(x), quote=True)


# ── Reading the store ────────────────────────────────────────────────────────

def unreadable(path, why):
    am.die(am.EXIT_USAGE, f"{am.tilde(path)} cannot be read: {why}",
           "Fix or remove the file; a page built around it would show wrong numbers")


def load_json_lines(path):
    """Every line of a JSONL file as an object. Unlike the collector's lenient
    reader, a bad line fails the build: a dropped line is a silent undercount."""
    out = []
    try:
        lines = path.read_text().splitlines()
    except (OSError, UnicodeDecodeError) as e:
        unreadable(path, getattr(e, "strerror", None) or "not text")
    for n, line in enumerate(lines, 1):
        if not line.strip():
            continue
        try:
            d = json.loads(line)
        except ValueError:
            unreadable(path, f"line {n} is not JSON")
        if not isinstance(d, dict):
            unreadable(path, f"line {n} is not an object")
        out.append(d)
    return out


def month_files(kind, lo_month):
    d = am.STORE / kind
    return sorted(p for p in d.glob("*.jsonl") if p.stem >= lo_month) if d.is_dir() else []


def amount(d, key, path, default=0.0):
    v = d.get(key)
    if v is None:
        return default
    if not am.is_amount(v) or v > PLAUSIBLE_MAX:
        unreadable(path, f"{key} is {v!r}, not a plausible non-negative number")
    return float(v)


def family(model_id):
    m = str(model_id).lower()
    return next((f for f in FAMILIES[:-1] if f in m), "other")


def load_sessions(lo_month):
    sessions = []
    for path in month_files("sessions", lo_month):
        for sid, r in am.read_month(path).items():
            ts = am.parse_ts(r["started_at"])
            if ts is None:
                unreadable(path, f"session {sid} has started_at {r['started_at']!r}")
            models = []
            for part in ("main", "subagent"):
                group = r.get("models", {}).get(part, {}) if isinstance(r.get("models"), dict) else {}
                if not isinstance(group, dict):
                    unreadable(path, f"session {sid} has malformed models")
                for mid, u in group.items():
                    if not isinstance(u, dict):
                        unreadable(path, f"session {sid} has malformed usage for {mid}")
                    models.append({"id": str(mid), "family": family(mid),
                                   "cost": amount(u, "cost_usd", path),
                                   "input": amount(u, "input", path), "cache_read": amount(u, "cache_read", path),
                                   "cw": amount(u, "cache_write_5m", path) + amount(u, "cache_write_1h", path)})
            links = r.get("pr_links") if isinstance(r.get("pr_links"), list) else []
            prs = set()
            for x in links:
                if not isinstance(x, dict) or isinstance(x.get("number"), bool) or not isinstance(x.get("number"), int):
                    unreadable(path, f"session {sid} has a pr_links entry without an integer number")
                prs.add((str(x.get("repo")), x["number"]))
            pop = r.get("population")
            sessions.append({"ts": ts, "date": dt.datetime.fromtimestamp(ts, dt.timezone.utc).date(),
                             "pop": pop if pop in POPULATIONS else "scripted",
                             "cost": amount(r, "cost_usd", path), "models": models, "prs": prs,
                             "repo": r.get("repo") if isinstance(r.get("repo"), str) else None,
                             "pipeline": r.get("pipeline") if isinstance(r.get("pipeline"), str) else None})
    return sessions


def load_quota(lo_month):
    readings = []
    for path in month_files("quota", lo_month):
        for r in load_json_lines(path):
            ts = am.parse_ts(r.get("hour"))
            if ts is None:
                unreadable(path, f"reading has hour {r.get('hour')!r}")
            readings.append({"ts": ts, "five": amount(r, "five_hour_pct", path, None), "seven": amount(r, "seven_day_pct", path, None)})
    return readings


def load_providers(lo_month):
    """Provider-limit readings: the store's hourly rows, then the newer ones
    still in the local log. A stored row that is malformed fails the build."""
    readings = []
    for path in month_files("providers", lo_month):
        for r in load_json_lines(path):
            ts = am.parse_ts(r.get("hour"))
            if ts is None or not isinstance(r.get("provider"), str) or not isinstance(r.get("windows"), list):
                unreadable(path, "a provider reading lacks a valid hour, provider or windows")
            windows = []
            for w in r["windows"]:
                if not isinstance(w, dict):
                    unreadable(path, "a provider window is not an object")
                windows.append({**w, "used_pct": amount(w, "used_pct", path)})
            readings.append({**r, "ts": ts, "windows": windows})
    stored = {(x["provider"], int(x["ts"]) // 3600) for x in readings}
    for r in am.local_providers():
        # An hour already folded into the store is represented there, per provider.
        if (r["provider"], int(r["at"]) // 3600) not in stored and isinstance(r.get("windows"), list):
            readings.append({**r, "ts": r["at"], "windows": [w for w in r["windows"] if isinstance(w, dict) and am.is_amount(w.get("used_pct"))]})
    return readings


def load_reports():
    reports = []
    d = am.STORE / "reports"
    for path in sorted(d.glob("*.json")) if d.is_dir() else []:
        m = REPORT_NAME.fullmatch(path.name)
        if not m:
            continue
        try:
            data = json.loads(path.read_text())
        except (OSError, ValueError, UnicodeDecodeError) as e:
            unreadable(path, getattr(e, "strerror", None) or "not valid JSON")
        if not isinstance(data, dict):
            unreadable(path, "not a JSON object")
        reports.append({"date": m.group(1), "window": m.group(2), "data": data})
    return reports


def load_report_markdown():
    """Stored report Markdown as (date, window, text), newest first."""
    d = am.STORE / "reports"
    out = []
    for path in d.glob("*.md") if d.is_dir() else []:
        m = REPORT_MD.fullmatch(path.name)
        if not m:
            continue
        try:
            out.append((m.group(1), m.group(2), path.read_text(encoding="utf-8")))
        except (OSError, UnicodeDecodeError) as e:
            unreadable(path, getattr(e, "strerror", None) or "not valid UTF-8")
    return sorted(out, reverse=True)


# ── Numbers ──────────────────────────────────────────────────────────────────

def money(v):
    return f"${v:,.2f}"


def pct(v):
    return f"{v * 100:.1f}%"


def plain(v):
    return ("%.2f" % v).rstrip("0").rstrip(".")


def number(v):
    """A report figure fit to draw: finite and not absurdly large."""
    ok = isinstance(v, (int, float)) and not isinstance(v, bool) and math.isfinite(v) and abs(v) <= PLAUSIBLE_MAX
    return v if ok else None


def change(cur, prev):
    if cur is None or prev is None or prev == 0:
        return "no prior figure"
    d = (cur - prev) / prev * 100
    return f"{'▲' if d >= 0 else '▼'} {abs(d):.0f}% vs the 7 days before" if round(d) else "unchanged vs the 7 days before"


def tile_change(cur, prev):
    text = change(cur, prev)
    if text.startswith(("▲", "▼")):
        sign = "+" if text.startswith("▲") else "-"
        return text.replace(text[2:text.index("%") + 1], f"{sign}{text[2:text.index('%') + 1]}", 1)
    return text


def nice_ceiling(v):
    if v <= 0:
        return 1.0, 1.0
    raw = v / 4
    mag = 10 ** math.floor(math.log10(raw))
    step = next(m * mag for m in (1, 2, 2.5, 5, 10) if m * mag >= raw)
    return math.ceil(v / step) * step, step


def window_sums(sessions, now_ts):
    def agg(lo, hi):
        rows = [s for s in sessions if lo < s["ts"] <= hi]
        prs = set().union(*[s["prs"] for s in rows]) if rows else set()
        spend = sum(s["cost"] for s in rows)
        return {"spend": spend, "sessions": len(rows), "prs": len(prs), "per_pr": spend / len(prs) if prs else None}
    return agg(now_ts - 7 * DAY, now_ts), agg(now_ts - 14 * DAY, now_ts - 7 * DAY)


# ── SVG ──────────────────────────────────────────────────────────────────────

W, H = 720, 240
ML, MR, MT, MB = 52, 16, 12, 28


def thin(labels, limit=8):
    step = max(1, math.ceil(len(labels) / limit))
    return {i for i in range(len(labels)) if i % step == 0}


def axes(labels, ymax, step, fmt):
    plot_h = H - MT - MB
    parts = []
    t = 0.0
    while t <= ymax + step / 1000:
        y = MT + plot_h - t / ymax * plot_h
        parts.append(f'<line class="grid" x1="{ML}" x2="{W - MR}" y1="{y:.1f}" y2="{y:.1f}"/>'
                     f'<text class="tick" x="{ML - 6}" y="{y + 4:.1f}" text-anchor="end">{esc(fmt(t))}</text>')
        t += step
    n = len(labels)
    slot = (W - ML - MR) / max(n, 1)
    for i in thin(labels):
        parts.append(f'<text class="tick" x="{ML + slot * (i + .5):.1f}" y="{H - 8}" text-anchor="middle">{esc(labels[i])}</text>')
    return "".join(parts)


def stacked_bars(labels, series, matrix, tips, fmt_axis):
    """Columns stacked in series order; matrix[s][i] is series s at column i."""
    totals = [sum(matrix[s][i] for s in range(len(series))) for i in range(len(labels))]
    ymax, step = nice_ceiling(max(totals))
    n = len(labels)
    slot = (W - ML - MR) / n
    bw = max(1.0, min(24.0, slot - 2))
    plot_h = H - MT - MB
    out = [axes(labels, ymax, step, fmt_axis)]
    for i in range(n):
        x = ML + slot * i + (slot - bw) / 2
        y = MT + plot_h
        top = max((s for s in range(len(series)) if matrix[s][i] > 0), default=None)
        for s in range(len(series)):
            v = matrix[s][i]
            if v <= 0:
                continue
            h = v / ymax * plot_h
            y -= h
            # The gap is drawn by shortening the segment; skipped when it would erase it.
            hh = h - 2 if h > 3 else h
            r = min(2.0, bw / 2) if s == top else 0
            if r and hh > r:
                d = f"M{x:.1f},{y + 2 if hh != h else y:.1f}v{hh - r:.1f}h{bw:.1f}v{-(hh - r):.1f}a{r},{r} 0 0 0 {-r},{-r}h{-(bw - 2 * r):.1f}a{r},{r} 0 0 0 {-r},{r}z"
                out.append(f'<path class="s{series[s][1]}" d="{d}"/>')
            else:
                out.append(f'<rect class="s{series[s][1]}" x="{x:.1f}" y="{y + (2 if hh != h else 0):.1f}" width="{bw:.1f}" height="{max(hh, 0.5):.1f}"/>')
    for i in range(n):
        out.append(f'<rect class="hit" x="{ML + slot * i:.1f}" y="{MT}" width="{slot:.1f}" height="{plot_h}" data-tip="{esc(tips[i])}"/>')
    return "".join(out)


def line_chart(labels, series, ymax, step, fmt_axis, tips, end_label=None):
    """series: list of (name, slot, values); None breaks the line."""
    n = len(labels)
    slot = (W - ML - MR) / max(n, 1)
    plot_h = H - MT - MB
    px = lambda i: ML + slot * (i + .5)
    py = lambda v: MT + plot_h - v / ymax * plot_h
    out = [axes(labels, ymax, step, fmt_axis)]
    for _name, color, values in series:
        run = []
        for i, v in enumerate(values + [None]):
            if v is not None:
                run.append((i, v))
                continue
            if len(run) > 1:
                pts = " ".join(f"{px(i):.1f},{py(v):.1f}" for i, v in run)
                out.append(f'<polyline class="l{color}" points="{pts}"/>')
            run = []
        marks = [(i, v) for i, v in enumerate(values) if v is not None]
        shown = marks if n <= 31 else marks[-1:]
        for i, v in shown:
            out.append(f'<circle class="d{color}" cx="{px(i):.1f}" cy="{py(v):.1f}" r="4"/>')
        if end_label and marks:
            i, v = marks[-1]
            out.append(f'<text class="endlabel" x="{min(px(i), W - MR - 2):.1f}" y="{py(v) - 9:.1f}" text-anchor="end">{esc(end_label(v))}</text>')
    for i in range(n):
        out.append(f'<rect class="hit" x="{ML + slot * i:.1f}" y="{MT}" width="{slot:.1f}" height="{plot_h}" data-tip="{esc(tips[i])}"/>')
    return "".join(out)


def figure(title, sub, series, svg, header, rows):
    legend = ""
    if len(series) > 1:
        legend = '<ul class="legend">' + "".join(f'<li><i class="k s{c}"></i>{esc(n)}</li>' for n, c in series) + "</ul>"
    table = ("<details><summary>Data table</summary><div class=\"scroll\"><table><thead><tr>"
             + "".join(f"<th>{esc(h)}</th>" for h in header) + "</tr></thead><tbody>"
             + "".join("<tr>" + "".join(f"<td>{esc(c)}</td>" for c in r) + "</tr>" for r in rows)
             + "</tbody></table></div></details>")
    return (f'<figure class="chart"><figcaption><h3>{esc(title)}</h3><p class="sub">{esc(sub)}</p></figcaption>{legend}'
            f'<svg viewBox="0 0 {W} {H}" role="img" aria-label="{esc(title)}">{svg}</svg>{table}</figure>')


def empty(title, why):
    return f'<section class="chart"><h3>{esc(title)}</h3><p class="empty">No data. {esc(why)}</p></section>'


# ── Report pages ─────────────────────────────────────────────────────────────

INLINE = re.compile(r"`([^`]+)`|\*\*(.+?)\*\*")
TABLE_RULE = re.compile(r"\|?\s*:?-+:?\s*(\|\s*:?-+:?\s*)*\|?")
BULLET = re.compile(r"- (.*)")
HEADING = re.compile(r"(#{1,6}) (.*)")


def inline(text):
    """Code and bold only; every other character, links and HTML included,
    comes out as escaped text."""
    out, pos = [], 0
    for m in INLINE.finditer(text):
        out.append(esc(text[pos:m.start()]))
        out.append(f"<code>{esc(m.group(1))}</code>" if m.group(1) is not None else f"<strong>{esc(m.group(2))}</strong>")
        pos = m.end()
    out.append(esc(text[pos:]))
    return "".join(out)


def table_cells(line):
    cells = re.split(r"(?<!\\)\|", line.strip())
    if cells and cells[0] == "":
        cells = cells[1:]
    if cells and cells[-1] == "":
        cells = cells[:-1]
    return [c.strip().replace("\\|", "|") for c in cells]


def table_html(rows):
    if len(rows) < 2 or not TABLE_RULE.fullmatch(rows[1].strip()):
        return "<pre>" + esc("\n".join(rows)) + "</pre>"
    head = table_cells(rows[0])
    body = "".join("<tr>" + "".join(f"<td>{inline(c)}</td>" for c in table_cells(r)) + "</tr>" for r in rows[2:])
    return ('<div class="scroll"><table><thead><tr>' + "".join(f"<th>{inline(c)}</th>" for c in head)
            + f"</tr></thead><tbody>{body}</tbody></table></div>")


def markdown_html(text):
    """The subset agent-report writes: headings, paragraphs, pipe tables,
    bullet lists, code and bold. Anything else is an escaped paragraph."""
    out, para, items, rows = [], [], [], []

    def flush():
        if para:
            out.append("<p>" + inline(" ".join(para)) + "</p>")
        if items:
            out.append("<ul>" + "".join(f"<li>{inline(i)}</li>" for i in items) + "</ul>")
        if rows:
            out.append(table_html(rows))
        para.clear(), items.clear(), rows.clear()

    for line in text.splitlines():
        line = line.rstrip()
        h, b = HEADING.fullmatch(line), BULLET.fullmatch(line)
        if line.startswith("|"):
            if para or items:
                flush()
            rows.append(line)
            continue
        if b and items:
            items.append(b.group(1))
            continue
        flush()
        if not line.strip():
            continue
        if h:
            level = min(len(h.group(1)), 3)
            out.append(f"<h{level}>{inline(h.group(2))}</h{level}>")
        elif b:
            items.append(b.group(1))
        else:
            para.append(line.strip())
    flush()
    return "\n".join(out)


def report_page(date, window, text):
    return ("<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\">"
            "<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">"
            f"<title>Agent report: {esc(window)} {esc(date)}</title><style>" + css() + "</style></head><body><main>"
            '<p><a href="../">Back to trends</a></p>'
            + markdown_html(text)
            + "</main></body></html>\n")


def reports_section(report_pages):
    if not report_pages:
        return empty("Reports", "No stored reports yet.")
    cols = []
    for window in WINDOW_ORDER:
        names = [d for d, w, _ in report_pages if w == window]
        if names:
            links = "".join(f'<li><a href="reports/{esc(d)}-{window}.html">{esc(d)}</a></li>' for d in names)
            cols.append(f'<div class="chart"><h3>{esc(window.capitalize())}</h3><ul class="links">{links}</ul></div>')
    return '<div class="cols">' + "".join(cols) + "</div>"


# ── Provider limits ──────────────────────────────────────────────────────────

def headline(windows):
    """The window that best says how close a provider is to being cut off: the
    plan-wide figure when one is named, else the longest window."""
    for wanted in HEADLINE_IDS:
        for w in windows:
            if w.get("id") == wanted:
                return w
    return max(windows, key=lambda w: (w.get("minutes") or 0, w["used_pct"])) if windows else None


def window_name(w):
    return str(w.get("label") or w.get("id") or "window")[:ID_SHOW]


def bar(v):
    level = "hot" if v >= 90 else "warm" if v >= 70 else "ok"
    return f'<span class="bar {level}"><i style="width:{min(v, 100):.0f}%"></i></span>'


def providers_section(readings, day_list, today, now_ts, days):
    if not readings:
        return empty("Provider limits", "No readings yet; run `agent-metrics providers snapshot` while T3 Code is running.")
    latest = {}
    for r in readings:
        if r["ts"] >= latest.get(r["provider"], {"ts": -1})["ts"]:
            latest[r["provider"]] = r
    rows = []
    for name in sorted(latest):
        r = latest[name]
        age = now_ts - r["ts"]
        shown = esc(str(r.get("name") or name)[:ID_SHOW])
        plan = esc(str(r.get("plan") or "unknown")[:ID_SHOW])
        note = "" if age <= STALE_S else f' <span class="muted">(reading is {age / 86400:.0f} days old)</span>'
        if not r.get("signed_in", True):
            rows.append(f'<tr><td>{shown}</td><td>{plan}</td><td colspan="3">not signed in{note}</td></tr>')
        elif not r["windows"]:
            why = "limits not reported by the provider" if r.get("unavailable") else "no quota window reported"
            rows.append(f'<tr><td>{shown}</td><td>{plan}</td><td colspan="3">{esc(why)}{note}</td></tr>')
        for w in sorted(r["windows"], key=lambda w: (-(w.get("minutes") or 0), w.get("id", ""))):
            reset = am.parse_ts(w.get("resets_at"))
            if reset is None:
                when = "no reset time"
            elif reset <= now_ts:
                when = "has reset since"
            else:
                left = reset - now_ts
                when = f"in {left / 86400:.1f} days" if left >= 2 * 86400 else f"in {left / 3600:.1f} hours"
            used = f"{w['used_pct']:g}%"
            rows.append(f'<tr><td>{shown}</td><td>{plan}</td><td>{esc(window_name(w))}</td>'
                        f'<td>{bar(w["used_pct"])} {esc(used)}</td><td>{esc(when)}{note}</td></tr>')
            shown = plan = ""
    asof = am.iso(max(r["ts"] for r in latest.values()))
    out = ['<section class="chart"><h3>Where each plan stands</h3>'
           f'<p class="sub">Newest reading per provider, as of {esc(asof)}. Providers report a percent of the plan limit, '
           'not tokens or dollars; only Claude has a dollar estimate (below).</p>'
           '<div class="scroll"><table><thead><tr><th>Provider</th><th>Plan</th><th>Window</th><th>Used</th><th>Resets</th></tr></thead>'
           f'<tbody>{"".join(rows)}</tbody></table></div></section>']

    per_day = {}
    for r in readings:
        d = dt.datetime.fromtimestamp(r["ts"], dt.timezone.utc).date()
        w = headline(r["windows"])
        if w and day_list[0] <= d <= today:
            slot = per_day.setdefault(r["provider"], {})
            slot[d] = max(w["used_pct"], slot.get(d, 0.0))
    names = sorted(per_day)[:MAX_PROVIDER_LINES]
    if not names:
        out.append(empty("Plan limit used per day", f"No provider readings with a quota window in the last {days} days."))
        return "".join(out)
    labels = [d.strftime("%b %d") for d in day_list]
    lines = [(latest[n].get("name") or n, i + 1, [per_day[n].get(d) for d in day_list]) for i, n in enumerate(names)]
    top = max(v for _n, _c, vs in lines for v in vs if v is not None)
    ymax, step = nice_ceiling(max(top, 10))
    ymax = min(ymax, 100.0) if top <= 100 else ymax
    step = min(step, ymax / 2) if ymax < 100 else step
    show = lambda v: "no reading" if v is None else f"{v:g}%"
    tips = [f"{d.isoformat()}: " + " · ".join(f"{n} {show(vs[i])}" for n, _c, vs in lines) for i, d in enumerate(day_list)]
    series = [(str(n)[:ID_SHOW], c) for n, c, _v in lines]
    out.append(figure("Plan limit used per day", "Highest reading each day (UTC) of each provider's headline window, percent of the plan limit",
                      series, line_chart(labels, [(str(n)[:ID_SHOW], c, v) for n, c, v in lines], ymax, step, lambda v: f"{v:g}%", tips),
                      ["Date"] + [n for n, _c in series], [[d.isoformat()] + [show(vs[i]) for _n, _c, vs in lines] for i, d in enumerate(day_list)]))
    return "".join(out)


# ── Page ─────────────────────────────────────────────────────────────────────

LIGHT = {"surface": "#fcfcfb", "page": "#f9f9f7", "ink": "#0b0b0b", "ink2": "#52514e", "muted": "#898781",
         "grid": "#e1e0d9", "axis": "#c3c2b7", "s1": "#2a78d6", "s2": "#eb6834", "s3": "#1baf7a", "s4": "#eda100",
         "other": "#898781", "ring": "rgba(11,11,11,0.10)"}
DARK = {"surface": "#1a1a19", "page": "#0d0d0d", "ink": "#ffffff", "ink2": "#c3c2b7", "muted": "#898781",
        "grid": "#2c2c2a", "axis": "#383835", "s1": "#3987e5", "s2": "#d95926", "s3": "#199e70", "s4": "#c98500",
        "other": "#898781", "ring": "rgba(255,255,255,0.10)"}


