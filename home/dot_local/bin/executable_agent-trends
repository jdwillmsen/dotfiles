    block = lambda pal: "".join(f"--{k}:{v};" for k, v in pal.items())
    return f"""
:root{{color-scheme:light;{block(LIGHT)}}}
@media (prefers-color-scheme: dark){{:root:where(:not([data-theme="light"])){{color-scheme:dark;{block(DARK)}}}}}
:root[data-theme="dark"]{{color-scheme:dark;{block(DARK)}}}
*{{box-sizing:border-box}}
body{{margin:0;background:var(--page);color:var(--ink);font:15px/1.45 system-ui,-apple-system,"Segoe UI",sans-serif}}
main{{max-width:880px;margin:0 auto;padding:24px 16px 48px}}
h1{{font-size:22px;margin:0 0 4px}} h2{{font-size:16px;margin:32px 0 12px;color:var(--ink)}}
h3{{font-size:14px;margin:0;font-weight:600}}
.lede,.sub,footer{{color:var(--ink2);font-size:13px;margin:2px 0 8px}}
.tiles{{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:12px}}
