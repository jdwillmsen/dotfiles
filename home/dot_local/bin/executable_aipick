#!/usr/bin/env bash
# aipick — pick a provider/model and launch Aider or Qwen Code wired to it.
#
# Both tools speak OpenAI format natively, so they connect straight to the
# provider. This used to read CCR's config.json and offer a "Claude Code via
# CCR" option; CCR is gone, and the provider list it was borrowing now lives
# in its own registry that nothing else owns.
# Usage: aipick
set -euo pipefail

registry="${AIPICK_PROVIDERS:-$HOME/.config/aipick/providers.json}"
[ -f "$registry" ] || { echo "no provider registry at $registry" >&2; exit 1; }

command -v node >/dev/null 2>&1 ||
    { echo "  ✖ node not found — aipick needs it to read $registry" >&2; exit 1; }

mapfile -t routes < <(node -e '
  const c = require(process.argv[1]);
  for (const p of (c.providers || [])) for (const m of (p.models || [])) console.log(p.name + "," + m);
' "$registry")
[ "${#routes[@]}" -gt 0 ] || { echo "no models in $registry" >&2; exit 1; }

echo ""
echo "  aipick — choose a tool:"
echo "  ────────────────────────"
echo "   1) Aider"
echo "   2) Qwen Code"
echo "   q) cancel"
echo ""
read -rp "  tool # > " tool
case "$tool" in
  q) echo "  cancelled"; exit 0 ;;
  1|2) ;;
  *) echo "  not a valid choice" >&2; exit 1 ;;
esac

echo ""
echo "  pick a model:"
echo "  ─────────────"
for i in "${!routes[@]}"; do
  printf "    %2d) %s\n" "$((i+1))" "${routes[$i]}"
done
echo "           q) cancel"
echo ""
read -rp "  pick # > " n
[ "$n" = "q" ] && { echo "  cancelled"; exit 0; }
case "$n" in *[!0-9]*|"") echo "  not a number" >&2; exit 1;; esac
sel="${routes[$((n-1))]:-}"
[ -n "$sel" ] || { echo "  out of range" >&2; exit 1; }

provider="${sel%%,*}"
model="${sel#*,}"

# key<TAB>base — api_key is a literal string, or "$ENV_VAR" naming an env var.
# shellcheck disable=SC2016  # the node script is a literal; $-refs are its own
resolved="$(node -e '
  const c = require(process.argv[1]);
  const p = (c.providers || []).find(p => p.name === process.argv[2]);
  if (!p) process.exit(1);
  // "$VAR" names an env var; anything else is a literal key. An unset $VAR
  // resolves to empty so the caller warns, rather than shipping the literal
  // string "$VAR" upstream as if it were a credential.
  const raw = p.api_key || "";
  const key = raw.startsWith("$") ? (process.env[raw.slice(1)] || "") : raw;
  const base = p.api_base_url.replace(/\/chat\/completions$/, "").replace(/\/+$/, "");
  process.stdout.write(key + "\t" + base);
' "$registry" "$provider")"
key="${resolved%%$'\t'*}"
base="${resolved#*$'\t'}"

[ -n "$key" ] || echo "  ⚠ no api key resolved for $provider — launching anyway (dummy-key tolerant providers only)" >&2

# ── Reachability gate ────────────────────────────────────────────────────────
# A provider listed in the registry is not a provider that is running. A
# stopped ollama or a powered-off LAN box surfaces inside aider as a retry
# ladder of "InternalServerError - Connection error", naming neither the host
# nor the cause, and inside qwen as a bare hang. Nine retries later you still
# do not know which of the two it was.
#
# Any HTTP answer counts as reachable — 401/404 are normal, since providers
# gate or omit /models — so only a transport failure is conclusive. Called
# after each dry run exits, so printing a command never needs the network.
require_reachable() {
    [ "${AIPICK_SKIP_PROBE:-}" = "1" ] && return 0
    curl -s -o /dev/null --max-time "${AIPICK_PROBE_TIMEOUT:-4}" "$base/models" && return 0
    echo "  ✖ provider unreachable: $base" >&2
    case "$provider" in
        ollama)    echo "    ollama is not answering — is it installed and running?" >&2 ;;
        gpu-stack) echo "    the LAN GPU box is not answering — is 192.168.1.50 powered on?" >&2 ;;
    esac
    # Not a tty (tests, scripts): fail rather than hang on a prompt nobody sees.
    [ -t 0 ] || exit 1
    read -rp "  launch anyway? [y/N] " yn
    case "$yn" in [yY]*) return 0 ;; *) echo "  cancelled"; exit 1 ;; esac
}

case "$tool" in
  1)
    if [ "${AIPICK_DRY_RUN:-}" = "1" ]; then
      echo "  DRY-RUN OPENAI_API_KEY=*** OPENAI_API_BASE=\"$base\" aider --model \"openai/$model\""
      exit 0
    fi
    require_reachable
    if ! command -v aider >/dev/null 2>&1; then
      echo "  aider not found — installing..." >&2
      if command -v pipx >/dev/null 2>&1; then
        pipx install aider-chat
      elif command -v pip >/dev/null 2>&1; then
        pip install --user aider-chat
      else
        echo "  ✖ neither pipx nor pip found — install pipx first: https://pipx.pypa.io" >&2
        exit 1
      fi
      hash -r
      command -v aider >/dev/null 2>&1 || { echo "  ✖ aider installed but not on PATH — open a new shell or add its install dir to PATH" >&2; exit 1; }
    fi
    export OPENAI_API_KEY="$key"
    export OPENAI_API_BASE="$base"
    echo "  → launching aider on: $sel"
    exec aider --model "openai/$model"
    ;;
  2)
    if [ "${AIPICK_DRY_RUN:-}" = "1" ]; then
      echo "  DRY-RUN OPENAI_API_KEY=*** OPENAI_BASE_URL=\"$base\" OPENAI_MODEL=\"$model\" qwen"
      exit 0
    fi
    require_reachable
    if ! command -v qwen >/dev/null 2>&1; then
      echo "  qwen not found — installing..." >&2
      if command -v npm >/dev/null 2>&1; then
        npm i -g @qwen-code/qwen-code
      else
        echo "  ✖ npm not found — install Node.js/npm first" >&2
        exit 1
      fi
      hash -r
      command -v qwen >/dev/null 2>&1 || { echo "  ✖ qwen installed but not on PATH — open a new shell or add its install dir to PATH" >&2; exit 1; }
    fi
    export OPENAI_API_KEY="$key"
    export OPENAI_BASE_URL="$base"
    export OPENAI_MODEL="$model"
    echo "  → launching qwen on: $sel"
    exec qwen
    ;;
esac
