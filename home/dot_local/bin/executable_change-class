#!/usr/bin/env python3
"""change-class — classify a change as risk R0–R3 from paths, content and plan.

Reads the change-risk policy, matches file paths and changed lines plus any
plan text, and prints the tier, tags, merge rule and the reasons that decided
them. Calls no model itself. Agent-facing: stdout is TOON, diagnostics go to
stderr.
"""
import argparse
import json
import os
import re
import stat
import subprocess
import sys
import tempfile
import time
import tomllib
from pathlib import Path

VERSION = "1.0.0"
EXIT_FAIL, EXIT_USAGE, EXIT_DENIED = 1, 2, 3
TIERS = ("R0", "R1", "R2", "R3")
TIER_INDEX = {t: i for i, t in enumerate(TIERS)}
CONTENT_SCAN_CAP = 2 * 1024 * 1024
UNTRACKED_FILE_CAP = 1024 * 1024
EMPTY_TREE = "4b825dc642cb6eb9a060e54bf8d69288fbee4904"
# Regexes can go quadratic on long input, so every scan is bounded; a clipped
# scan is reported as a reason to look harder, never passed quietly.
LINE_SCAN_CAP = 4000
PLAN_SCAN_CAP = 100 * 1024
FILE_LINES_SCAN_CAP = 20000


def _budget():
    try:
        return float(os.environ.get("CHANGE_CLASS_SCAN_BUDGET", "20"))
    except ValueError:
        return 20.0


SCAN_BUDGET_SECONDS = _budget()

# Fast path before any real work: harnesses probe --version constantly.
if __name__ == "__main__" and len(sys.argv) == 2 and sys.argv[1] in ("-v", "-V", "--version"):
    print(VERSION)
    sys.exit(0)


def fail(msg):
    print(f"error: {msg}")
    print("code: 1")
    sys.exit(EXIT_FAIL)


def usage_error(msg):
    print(f"error: {msg}")
    print("code: 2")
    sys.exit(EXIT_USAGE)


# ── TOON output ──────────────────────────────────────────────────────────────

def toon_scalar(v):
    if v is None:
        return "null"
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, (int, float)):
        return str(v)
    s = str(v)
    if s == "" or s != s.strip() or re.search(r'[,:"\\\n\r\t\[\]{}]', s) or s in ("true", "false", "null") \
            or re.fullmatch(r"-?\d+(\.\d+)?", s):
        return json.dumps(s, ensure_ascii=False)
    return s


def emit_result(result):
    tags = result["tags"]
    labels = result["labels"]
    reasons = result["reasons"]
    out = [
        f"tier: {result['tier']}",
        f"tags[{len(tags)}]: {','.join(tags)}" if tags else "tags[0]:",
        f"merge: {result['merge']}",
        f"reviewer: {result['reviewer']}",
        f"human: {toon_scalar(result['human'])}",
        f"interview: {toon_scalar(result['interview'])}",
        f"labels[{len(labels)}]: {','.join(labels)}" if labels else "labels[0]:",
        f"reasons[{len(reasons)}]{{rule,tier,where}}:",
    ]
    for row in reasons:
        out.append("  " + ",".join(toon_scalar(row[k]) for k in ("rule", "tier", "where")))
    out.append(f"files: {result['files']}")
    out.append(f"lines: {result['lines']}")
    if result.get("content_scanned") is False:
        out.append("content_scanned: false")
    elif result.get("content_scanned") == "partial":
        out.append("content_scanned: partial")
    warnings = result.get("warnings") or []
    if warnings:
        out.append(f"warnings[{len(warnings)}]: {','.join(warnings)}")
    print("\n".join(out))


# ── Glob matching ────────────────────────────────────────────────────────────

def _segment_regex(segment):
    out = []
    i = 0
    while i < len(segment):
        c = segment[i]
        if c == "*":
            out.append("[^/]*")
        elif c == "?":
            out.append("[^/]")
        elif c == "[":
            end = segment.find("]", i + 1)
            if end == -1:
                out.append(re.escape(c))
            else:
                cls = segment[i:end + 1]
                if cls.startswith("[!"):
                    cls = "[^" + cls[2:]
                out.append(cls)
                i = end
        else:
            out.append(re.escape(c))
        i += 1
    return "".join(out)


def glob_regex(pattern):
    pattern = pattern.replace("\\", "/")
    parts = pattern.split("/")
    while len(parts) > 1 and parts[0] == "":
        parts.pop(0)
    out = []
    for i, part in enumerate(parts):
        last = i == len(parts) - 1
        if part == "**":
            out.append(".*" if last else "(?:[^/]+/)*")
        else:
            out.append(_segment_regex(part))
            if not last:
                out.append("/")
    try:
        return re.compile("^" + "".join(out) + "$")
    except re.error as e:
        fail(f"invalid glob {pattern!r}: {e}")


def glob_list(value, where):
    if value is None:
        return []
    if not isinstance(value, list) or not all(isinstance(p, str) for p in value):
        fail(f"rules {where}: globs must be a list of strings")
    return [glob_regex(p) for p in value]


def regex_list(value, where):
    if value is None:
        return []
    if not isinstance(value, list) or not all(isinstance(p, str) for p in value):
        fail(f"rules {where}: expressions must be a list of strings")
    try:
        return [re.compile(p) for p in value]
    except re.error as e:
        fail(f"rules {where}: invalid expression: {e}")


def repo_list(value, where):
    if value is None:
        return []
    if not isinstance(value, list) or not value or not all(isinstance(p, str) and p.strip() for p in value):
        fail(f"rules {where}: repos must be a non-empty list of strings")
    return [p.strip().lower() for p in value]


def matches(patterns, path):
    return any(p.match(path) for p in patterns)


def normalize_path(path):
    # Rules are written against clean repo-relative paths, so every spelling of
    # the same file (leading or doubled slashes, ./ and ../ segments, backslashes)
    # must collapse to one key or a rule can be dodged by respelling the path.
    parts = []
    for seg in path.strip().replace("\\", "/").split("/"):
        if seg in ("", "."):
            continue
        if seg == "..":
            if parts:
                parts.pop()
            continue
        parts.append(seg)
    return "/".join(parts)


def canon(raw, bad):
    """The one canonical key for a path; records names that are not valid UTF-8 in `bad`."""
    key = normalize_path(raw.encode("utf-8", "surrogateescape").decode("utf-8", "replace"))
    if key and re.search("[\udc80-\udcff]", raw):
        bad.add(key)
    return key


# ── Policy ───────────────────────────────────────────────────────────────────

def _tier(value, where):
    if value not in TIER_INDEX:
        fail(f"rules {where}: tier {value!r} is not one of {', '.join(TIERS)}")
    return value


def _positive_int(value, where):
    if not isinstance(value, int) or isinstance(value, bool) or value <= 0:
        fail(f"rules {where}: must be a positive integer")
    return value


def load_policy(path):
    try:
        raw = path.read_text(encoding="utf-8")
    except OSError as e:
        fail(f"cannot read rules {path}: {e.strerror}")
    try:
        data = tomllib.loads(raw)
    except tomllib.TOMLDecodeError as e:
        fail(f"rules {path} is not valid TOML: {e}")
    if not isinstance(data, dict):
        fail(f"rules {path} must hold a table")

    tiers = data.get("tiers")
    if not isinstance(tiers, dict):
        fail(f"rules {path}: missing [tiers]")
    clean_tiers = {}
    for tier in TIERS:
        entry = tiers.get(tier)
        if not isinstance(entry, dict):
            fail(f"rules {path}: missing [tiers.{tier}]")
        for key in ("merge", "reviewer"):
            if not isinstance(entry.get(key), str):
                fail(f"rules {path}: [tiers.{tier}] needs a string {key}")
        for key in ("human", "interview"):
            if not isinstance(entry.get(key), bool):
                fail(f"rules {path}: [tiers.{tier}] needs a boolean {key}")
        clean_tiers[tier] = {
            "merge": entry["merge"], "reviewer": entry["reviewer"],
            "human": entry["human"], "interview": entry["interview"],
        }

    size = data.get("size")
    if not isinstance(size, dict):
        fail(f"rules {path}: missing [size]")
    clean_size = {
        "files": _positive_int(size.get("files"), f"{path}: [size].files"),
        "lines": _positive_int(size.get("lines"), f"{path}: [size].lines"),
        "cap": _tier(size.get("cap"), f"{path}: [size].cap"),
    }

    default = data.get("default")
    if not isinstance(default, dict):
        fail(f"rules {path}: missing [default]")
    clean_default = {
        "tier": _tier(default.get("tier"), f"{path}: [default].tier"),
        "tag": default.get("tag"),
    }
    if not isinstance(clean_default["tag"], str):
        fail(f"rules {path}: [default].tag must be a string")

    floors = []
    raw_floors = data.get("floor", [])
    if not isinstance(raw_floors, list):
        fail(f"rules {path}: [[floor]] must be a list of tables")
    for i, floor in enumerate(raw_floors):
        where = f"{path}: floor {i + 1}"
        if not isinstance(floor, dict):
            fail(f"rules {where}: must be a table")
        if not isinstance(floor.get("repo"), str) or not floor["repo"]:
            fail(f"rules {where}: repo must be a non-empty string")
        if not isinstance(floor.get("tag"), str):
            fail(f"rules {where}: tag must be a string")
        floors.append({"repo": floor["repo"], "tier": _tier(floor.get("tier"), where),
                       "tag": floor["tag"]})

    rules = []
    raw_rules = data.get("rule", [])
    if not isinstance(raw_rules, list):
        fail(f"rules {path}: [[rule]] must be a list of tables")
    for i, rule in enumerate(raw_rules):
        where = f"{path}: rule {i + 1}"
        if not isinstance(rule, dict):
            fail(f"rules {where}: must be a table")
        rid = rule.get("id")
        if not isinstance(rid, str) or not rid:
            fail(f"rules {where}: id must be a non-empty string")
        where = f"{path}: rule {rid}"
        if not isinstance(rule.get("tag"), str):
            fail(f"rules {where}: tag must be a string")
        paths = glob_list(rule.get("paths"), where)
        exclude = glob_list(rule.get("exclude"), where)
        content = regex_list(rule.get("content"), where)
        plan = regex_list(rule.get("plan"), where)
        repos = repo_list(rule.get("repos"), where)
        if not paths and not content and not plan:
            fail(f"rules {where}: needs paths, content or plan")
        rules.append({
            "id": rid, "tier": _tier(rule.get("tier"), where), "tag": rule["tag"],
            "paths": paths, "exclude": exclude, "content": content, "plan": plan, "repos": repos,
        })

    return {"tiers": clean_tiers, "size": clean_size, "default": clean_default,
            "floors": floors, "rules": rules}


# ── Repository and diff inputs ───────────────────────────────────────────────

def run(cmd, cwd=None):
    try:
        return subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, errors="replace")
    except FileNotFoundError:
        fail(f"{cmd[0]} is not installed")
    except OSError as e:
        fail(f"cannot run {cmd[0]}: {e}")


def git(args, cwd=None):
    return run(["git", *args], cwd)


def git_raw(args, cwd, label):
    try:
        r = subprocess.run(["git", *args], cwd=cwd, capture_output=True)
    except FileNotFoundError:
        fail("git is not installed")
    except OSError as e:
        fail(f"cannot run git: {e}")
    if r.returncode != 0:
        fail(f"{label} failed: {r.stderr.decode('utf-8', 'replace').strip()}")
    return r.stdout


def repo_root():
    r = git(["rev-parse", "--show-toplevel"])
    return Path(r.stdout.strip()) if r.returncode == 0 and r.stdout.strip() else None


def repo_identity(explicit, root):
    """Return (name, known); an unknown name is only the directory name, a weak match."""
    if explicit:
        return explicit.strip().rstrip("/"), True
    if root is None:
        return "", False
    r = git(["remote", "get-url", "origin"], cwd=root)
    if r.returncode != 0 or not r.stdout.strip():
        return root.name, False
    url = r.stdout.strip()
    while url.endswith("/"):
        url = url[:-1]
    if url.endswith(".git"):
        url = url[:-4]
    if url.startswith("file://"):
        return url.rsplit("/", 1)[-1], True
    if url.startswith("git@") and ":" in url:
        path = url.split(":", 1)[1]
    elif "://" in url:
        rest = url.split("://", 1)[1]
        path = rest.split("/", 1)[1] if "/" in rest else rest
    elif re.fullmatch(r"[^/]+/[^/]+", url):
        return url, True
    else:
        return url.rsplit("/", 1)[-1], True
    return ("/".join(path.split("/")[-2:]) if "/" in path else path), True


def empty_tree(root):
    r = git(["hash-object", "-t", "tree", "/dev/null"], cwd=root)
    return r.stdout.strip() if r.returncode == 0 and r.stdout.strip() else EMPTY_TREE


def resolve_base(requested, root):
    if requested:
        r = git(["rev-parse", "--verify", f"{requested}^{{commit}}"], cwd=root)
        if r.returncode != 0:
            fail(f"cannot resolve base {requested!r}")
        return r.stdout.strip()
    if git(["rev-parse", "--verify", "HEAD^{commit}"], cwd=root).returncode != 0:
        return empty_tree(root)
    r = git(["merge-base", "HEAD", "origin/main"], cwd=root)
    if r.returncode == 0 and r.stdout.strip():
        return r.stdout.strip()
    # Guessing a base (such as HEAD~1) would judge a multi-commit branch on its
    # last commit alone, a lower tier than the branch deserves.
    count = git(["rev-list", "--count", "HEAD"], cwd=root)
    if count.returncode == 0 and count.stdout.strip() == "1":
        return empty_tree(root)
    fail("no merge base with origin/main; pass --base REF")


# ── Unified diff parsing ─────────────────────────────────────────────────────

C_ESCAPES = {"a": 7, "b": 8, "f": 12, "n": 10, "r": 13, "t": 9, "v": 11, "\\": 92, '"': 34}
HUNK_HEADER = re.compile(r"@@ -\d+(?:,(\d+))? \+\d+(?:,(\d+))? @@")


def read_quoted(text, start):
    """Decode the C-style quoted token at text[start]; return (value, index after the quote)."""
    out = bytearray()
    i = start + 1
    while i < len(text):
        c = text[i]
        if c == '"':
            return out.decode("utf-8", "surrogateescape"), i + 1
        if c != "\\":
            out += c.encode("utf-8", "surrogateescape")
            i += 1
            continue
        i += 1
        if i >= len(text):
            break
        if text[i] in C_ESCAPES:
            out.append(C_ESCAPES[text[i]])
            i += 1
        elif text[i] in "01234567":
            j = i
            while j < len(text) and j - i < 3 and text[j] in "01234567":
                j += 1
            value = int(text[i:j], 8)
            if value > 255:
                break
            out.append(value)
            i = j
        else:
            break
    raise ValueError("bad quoted path")


def path_token(text):
    """A path field from a diff header; an undecodable quoted one gets a marker byte so it is flagged."""
    if text.startswith('"'):
        try:
            return read_quoted(text, 0)[0]
        except ValueError:
            return text + "\udcff"
    return text.split("\t", 1)[0]


def strip_side(path, side):
    return path[2:] if path.startswith(side + "/") else path


def git_header_paths(rest):
    """Candidate (old, new) pairs from `diff --git` text; ambiguous only for unquoted names with spaces."""
    try:
        if rest.startswith('"'):
            left, end = read_quoted(rest, 0)
            right = rest[end + 1:]
        else:
            quoted = rest.find(' "')
            if quoted != -1:
                left, right = rest[:quoted], rest[quoted + 1:]
            else:
                left = right = None
                first = None
                for i, ch in enumerate(rest):
                    if ch != " ":
                        continue
                    lhs, rhs = rest[:i], rest[i + 1:]
                    if not (lhs.startswith("a/") and rhs.startswith("b/")):
                        continue
                    if lhs[2:] == rhs[2:]:
                        return [(lhs[2:], rhs[2:])]
                    first = first or (lhs, rhs)
                if first is None:
                    return [(rest, rest)]
                left, right = first
        if right.startswith('"'):
            right = read_quoted(right, 0)[0]
        return [(strip_side(left, "a"), strip_side(right, "b"))]
    except ValueError:
        return [(rest + "\udcff", rest)]


class DiffParser:
    """Streams a unified diff into paths and changed lines.

    Lines only count as content while the hunk header's counts say a hunk is
    still open, so an added line that reads `++ b/x` cannot pass as a file header.
    """

    def __init__(self, cap):
        self.cap = cap
        self.paths = []
        self.bad = set()
        self.changed = {}
        self.lines = 0
        self.total = 0
        self.truncated = False
        self._known = set()
        self._file = None
        self._current = None
        self._old_left = 0
        self._new_left = 0

    def consume(self, stream, drain):
        while True:
            raw = stream.readline(self.cap + 1)
            if not raw:
                break
            if not raw.endswith(b"\n") and len(raw) > self.cap:
                # A single line past the cap: discard the rest of it unread.
                self.truncated = True
                while True:
                    more = stream.readline(65536)
                    if not more or more.endswith(b"\n"):
                        break
            self.total += len(raw)
            if self.total > self.cap:
                self.truncated = True
                if not drain:
                    break
            self.feed(raw.decode("utf-8", "surrogateescape").rstrip("\n"))
        self._finish()

    def _add(self, raw):
        key = canon(raw, self.bad)
        if not key:
            return None
        if key not in self._known:
            self._known.add(key)
            self.paths.append(key)
        self.changed.setdefault(key, [])
        return key

    def _begin(self):
        self._finish()
        self._file = {"candidates": [], "sure": False}
        self._current = None

    def _finish(self):
        f = self._file
        if f is not None and not f["sure"]:
            for old, new in f["candidates"]:
                self._add(old)
                self._add(new)
        self._file = None

    def _sure(self, raw):
        if self._file is None:
            self._begin()
        self._file["sure"] = True
        return self._add(raw)

    def _record(self, line):
        self.lines += 1
        if not self.truncated and self._current is not None:
            self.changed[self._current].append(line[1:])

    def feed(self, line):
        if self._old_left > 0 or self._new_left > 0:
            lead = line[:1]
            if lead == "\\":
                return
            if lead == "+":
                self._new_left -= 1
                self._record(line)
            elif lead == "-":
                self._old_left -= 1
                self._record(line)
            else:
                self._old_left -= 1
                self._new_left -= 1
            self._old_left = max(self._old_left, 0)
            self._new_left = max(self._new_left, 0)
            return
        if line.startswith("diff --git "):
            self._begin()
            self._file["candidates"] = git_header_paths(line[len("diff --git "):])
        elif line.startswith("--- "):
            if self._file is not None and self._file.get("plus") is not None:
                self._begin()
            value = path_token(line[4:])
            if self._file is None:
                self._begin()
            self._file["minus"] = None if value == "/dev/null" else strip_side(value, "a")
            if self._file["minus"] is not None:
                self._current = self._sure(self._file["minus"])
        elif line.startswith("+++ "):
            if self._file is None:
                self._begin()
            value = path_token(line[4:])
            self._file["plus"] = None if value == "/dev/null" else strip_side(value, "b")
            if self._file["plus"] is not None:
                self._current = self._sure(self._file["plus"])
        elif line.startswith(("rename from ", "copy from ")):
            self._sure(path_token(line.split(" from ", 1)[1]))
        elif line.startswith(("rename to ", "copy to ")):
            self._current = self._sure(path_token(line.split(" to ", 1)[1]))
        elif line.startswith("@@ "):
            m = HUNK_HEADER.match(line)
            if m:
                self._old_left = 1 if m.group(1) is None else int(m.group(1))
                self._new_left = 1 if m.group(2) is None else int(m.group(2))


def spawn_diff(cmd, cwd):
    errors = tempfile.TemporaryFile()
    try:
        proc = subprocess.Popen(cmd, cwd=cwd, stdout=subprocess.PIPE, stderr=errors)
    except FileNotFoundError:
        fail(f"{cmd[0]} is not installed")
    except OSError as e:
        fail(f"cannot run {cmd[0]}: {e}")
    return proc, errors


def stream_diff(cmd, cwd, drain, label):
    proc, errors = spawn_diff(cmd, cwd)
    parser = DiffParser(CONTENT_SCAN_CAP)
    try:
        parser.consume(proc.stdout, drain)
        if parser.truncated and not drain:
            proc.kill()
        code = proc.wait()
    finally:
        proc.stdout.close()
    if code != 0 and not (parser.truncated and not drain):
        errors.seek(0)
        detail = errors.read().decode("utf-8", "replace").strip()
        errors.close()
        fail(f"{label} failed: {detail}")
    errors.close()
    return parser


def pr_inputs(number, repo):
    cmd = ["gh", "pr", "diff", str(number)]
    if repo:
        cmd += ["--repo", repo]
    parser = stream_diff(cmd, None, True, f"gh pr diff {number}")
    changed = None if parser.truncated else parser.changed
    return parser.paths, parser.bad, parser.lines, changed


def diff_inputs(root, base):
    common = ["-c", "core.quotePath=false", "diff", "--no-renames", "--no-ext-diff"]
    bad = set()
    paths = []
    known = set()

    def add(raw):
        key = canon(raw, bad)
        if key and key not in known:
            known.add(key)
            paths.append(key)
        return key

    names = git_raw([*common, "-z", "--name-only", base, "--"], root, "git diff --name-only")
    for raw in names.split(b"\0"):
        if raw:
            add(raw.decode("utf-8", "surrogateescape"))

    lines = 0
    numstat = git_raw([*common, "-z", "--numstat", base, "--"], root, "git diff --numstat")
    for record in numstat.split(b"\0"):
        parts = record.split(b"\t", 2)
        for value in (parts[:2] if len(parts) >= 2 else ()):
            if value.isdigit():
                lines += int(value)

    parser = stream_diff(["git", *common, "--unified=0", "--src-prefix=a/", "--dst-prefix=b/", base, "--"],
                         root, False, "git diff")
    for key in parser.paths:
        add(key)
    bad |= parser.bad
    changed = None if parser.truncated else parser.changed
    spent = parser.total

    untracked = git_raw(["ls-files", "-o", "--exclude-standard", "-z"], root, "git ls-files")
    for raw in untracked.split(b"\0"):
        if not raw:
            continue
        key = add(raw.decode("utf-8", "surrogateescape"))
        full = os.path.join(os.fsencode(root), raw)
        try:
            if not stat.S_ISREG(os.lstat(full).st_mode):
                continue
            with open(full, "rb") as fh:
                data = fh.read(UNTRACKED_FILE_CAP + 1)
        except OSError:
            changed = None
            continue
        if len(data) > UNTRACKED_FILE_CAP:
            data = data[:UNTRACKED_FILE_CAP]
            changed = None
        spent += len(data)
        if spent > CONTENT_SCAN_CAP:
            changed = None
        text = data.decode("utf-8", "surrogateescape")
        added = text.split("\n")
        if added and added[-1] == "":
            added.pop()
        lines += len(added)
        if changed is not None and key:
            changed.setdefault(key, []).extend(added)
    return paths, bad, lines, changed


def read_paths(value):
    if value == "-":
        data = sys.stdin.buffer.read()
    else:
        try:
            data = Path(value).read_bytes()
        except OSError as e:
            fail(f"cannot read files {value}: {e.strerror}")
    bad = set()
    keys = [canon(line, bad) for line in data.decode("utf-8", "surrogateescape").splitlines() if line.strip()]
    return list(dict.fromkeys(k for k in keys if k)), bad


def read_plan(value):
    if value == "-":
        data = sys.stdin.buffer.read()
    else:
        try:
            data = Path(value).read_bytes()
        except OSError as e:
            fail(f"cannot read plan {value}: {e.strerror}")
    return data.decode("utf-8", "replace")


# ── Classification ───────────────────────────────────────────────────────────

def _repo_matches(wanted, full, bare):
    return bool(full) and wanted.lower() in (full.lower(), bare.lower())


def _floor_matches(floor, full, bare):
    return _repo_matches(floor["repo"], full, bare)


def _rule_applies(rule, full, bare, repo_known):
    # An unidentified repo cannot prove a scoped rule irrelevant, so it applies.
    if not rule["repos"] or not repo_known:
        return True
    return any(_repo_matches(r, full, bare) for r in rule["repos"])


def classify(paths, bad, lines, changed, plan_text, policy, repo, repo_known, content_scanned, explain,
             scan_skipped=False):
    reasons = []
    warnings = []
    tags = set()
    best = -1
    all_docs_r0 = bool(paths) and not bad

    bare = repo.rsplit("/", 1)[-1] if repo else ""
    active = [r for r in policy["rules"] if _rule_applies(r, repo, bare, repo_known)]
    path_rules = [r for r in active if r["paths"]]
    content_rules = [r for r in active if r["content"]]
    plan_rules = [r for r in active if r["plan"]]
    clipped = False

    def clip_reason(where):
        nonlocal clipped
        nonlocal best
        clipped = True
        reasons.append({"rule": "scan-truncated", "tier": "R2", "where": where, "tag": None})
        best = max(best, TIER_INDEX["R2"])

    if scan_skipped:
        # A diff too large to read is a reason to look harder, never a quiet pass.
        clip_reason("diff over the scan cap")

    for path in sorted(bad):
        reasons.append({"rule": "undecodable-path", "tier": "R3", "where": path, "tag": "path"})
        tags.add("path")
        best = max(best, TIER_INDEX["R3"])

    for path in paths:
        matched = [r for r in path_rules if matches(r["paths"], path) and not matches(r["exclude"], path)]
        docs_r0 = any(r["tier"] == "R0" and r["tag"] == "docs" for r in matched)
        if not docs_r0:
            all_docs_r0 = False
        if not matched:
            default = policy["default"]
            reasons.append({"rule": "default", "tier": default["tier"], "where": path,
                            "tag": default["tag"]})
            tags.add(default["tag"])
            best = max(best, TIER_INDEX[default["tier"]])
            continue
        for rule in matched:
            reasons.append({"rule": rule["id"], "tier": rule["tier"], "where": path,
                            "tag": rule["tag"]})
            tags.add(rule["tag"])
            best = max(best, TIER_INDEX[rule["tier"]])

    deadline = time.monotonic() + SCAN_BUDGET_SECONDS
    out_of_time = False
    if changed is not None:
        for path in paths:
            file_rules = [r for r in content_rules if not matches(r["exclude"], path)]
            if not file_rules:
                continue
            if out_of_time or time.monotonic() > deadline:
                out_of_time = True
                clip_reason(path)
                continue
            lines_here = changed.get(path, [])
            if len(lines_here) > FILE_LINES_SCAN_CAP or any(len(ln) > LINE_SCAN_CAP for ln in lines_here):
                clip_reason(path)
            hit = set()
            for line in lines_here[:FILE_LINES_SCAN_CAP]:
                if time.monotonic() > deadline:
                    out_of_time = True
                    clip_reason(path)
                    break
                line = line[:LINE_SCAN_CAP]
                for rule in file_rules:
                    if rule["id"] not in hit and any(rx.search(line) for rx in rule["content"]):
                        hit.add(rule["id"])
            for rule in file_rules:
                if rule["id"] in hit:
                    reasons.append({"rule": rule["id"], "tier": rule["tier"], "where": path,
                                    "tag": rule["tag"]})
                    tags.add(rule["tag"])
                    best = max(best, TIER_INDEX[rule["tier"]])

    if plan_text:
        if len(plan_text) > PLAN_SCAN_CAP:
            plan_text = plan_text[:PLAN_SCAN_CAP]
            clip_reason("plan")
        plan_hit = False
        for rule in plan_rules:
            if time.monotonic() > deadline:
                clip_reason("plan")
                break
            if any(rx.search(plan_text) for rx in rule["plan"]):
                plan_hit = True
                reasons.append({"rule": rule["id"], "tier": rule["tier"], "where": "plan",
                                "tag": rule["tag"]})
                tags.add(rule["tag"])
                best = max(best, TIER_INDEX[rule["tier"]])
        # With no paths to judge, a plan nothing recognised is ordinary code.
        if not plan_hit and not paths:
            default = policy["default"]
            reasons.append({"rule": "default", "tier": default["tier"], "where": "plan",
                            "tag": default["tag"]})
            tags.add(default["tag"])
            best = max(best, TIER_INDEX[default["tier"]])

    if clipped and content_scanned is not False:
        content_scanned = "partial"

    base_tier = TIERS[best] if best >= 0 else "R0"

    floor_tier = None
    if paths and policy["floors"] and not repo_known:
        warnings.append("repo unknown, floors skipped")
    if paths and not (all_docs_r0 and base_tier == "R0"):
        for floor in policy["floors"]:
            if not _floor_matches(floor, repo, bare):
                continue
            rule_name = f"{floor['tag']} floor" if floor["tag"] else "repo floor"
            reasons.append({"rule": rule_name, "tier": floor["tier"],
                            "where": f"repo {floor['repo']}", "tag": floor["tag"]})
            tags.add(floor["tag"])
            if floor_tier is None or TIER_INDEX[floor["tier"]] > TIER_INDEX[floor_tier]:
                floor_tier = floor["tier"]

    size = policy["size"]
    final = TIER_INDEX[base_tier]
    if floor_tier is not None:
        final = max(final, TIER_INDEX[floor_tier])

    if (len(paths) >= size["files"] or lines >= size["lines"]) \
            and base_tier in ("R0", "R1") \
            and TIER_INDEX[size["cap"]] > TIER_INDEX[base_tier]:
        final = max(final, TIER_INDEX[size["cap"]])
        reasons.append({"rule": "size", "tier": size["cap"],
                        "where": f"{len(paths)} files, {lines} lines", "tag": None})

    final_tier = TIERS[final]

    seen = set()
    kept = []
    for row in reasons:
        key = (row["rule"], row["tier"], row["where"])
        if key in seen:
            continue
        seen.add(key)
        kept.append(row)
    deciding_tags = sorted({r["tag"] for r in kept
                            if r["tier"] == final_tier and r["tag"]})
    if not explain:
        kept = [r for r in kept if r["tier"] == final_tier]
    kept.sort(key=lambda r: (-TIER_INDEX[r["tier"]], r["rule"], r["where"]))

    ordered_tags = sorted(tags)
    info = policy["tiers"][final_tier]
    return {
        "tier": final_tier,
        "tags": ordered_tags,
        "merge": info["merge"],
        "reviewer": info["reviewer"],
        "human": info["human"],
        "interview": info["interview"],
        "labels": [f"risk/{final_tier}"] + [f"tag/{t}" for t in deciding_tags],
        "reasons": kept,
        "files": len(paths),
        "lines": lines,
        "content_scanned": content_scanned,
        "warnings": warnings,
    }


# ── Main ─────────────────────────────────────────────────────────────────────

class Parser(argparse.ArgumentParser):
    def error(self, message):
        usage_error(message)


def default_rules():
    return Path.home() / ".config" / "agents" / "change-risk.toml"


def build_parser():
    p = Parser(prog="change-class",
               description="classify a change as risk R0-R3 from paths, changed lines and plan text",
               formatter_class=argparse.RawDescriptionHelpFormatter,
               epilog="examples:\n"
                      "  change-class                          diff HEAD against merge-base origin/main\n"
                      "  change-class --pr 42 --repo o/r       classify a pull request's diff\n"
                      "  change-class --files -                paths on stdin, no content rules\n"
                      "  change-class --plan -                 plan text on stdin\n"
                      "  change-class --fail-at R3             exit 3 when the tier is R3")
    p.add_argument("--rules", metavar="FILE", help="policy file (default ~/.config/agents/change-risk.toml)")
    p.add_argument("--base", metavar="REF", help="diff against another base")
    p.add_argument("--diff", action="store_true", help="with --plan, also classify the working diff")
    p.add_argument("--pr", type=int, metavar="N", help="use gh pr diff for that pull request")
    p.add_argument("--repo", metavar="O/R", help="repository name for floors and gh")
    p.add_argument("--files", metavar="FILE|-", help="newline-separated paths, '-' for stdin")
    p.add_argument("--plan", action="append", default=[], metavar="FILE|-",
                   help="plan, ticket or PR text; '-' for stdin")
    p.add_argument("--fail-at", choices=TIERS, metavar="R0..R3",
                   help="exit 3 when the tier is at or above this")
    p.add_argument("--explain", action="store_true", help="show every matched rule")
    p.add_argument("--version", action="version", version=VERSION)
    return p


def main(argv):
    args = build_parser().parse_args(argv)

    if args.files is not None and args.pr is not None:
        usage_error("--files and --pr cannot be combined")
    if args.base and (args.files is not None or args.pr is not None):
        usage_error("--base is only for diff mode")
    if args.files == "-" and "-" in args.plan:
        usage_error("stdin cannot be both --files - and --plan -")
    for plan in args.plan:
        if plan != "-" and not os.path.exists(plan):
            usage_error(f"--plan takes a file path or '-', not text: pass text on stdin with `--plan -` "
                        f"or give a file path ({plan[:40]!r} is not a file)")

    rules_path = Path(args.rules).expanduser() if args.rules else default_rules()
    policy = load_policy(rules_path)

    plan_text = "\n".join(read_plan(p) for p in args.plan)
    root = repo_root()
    repo, repo_known = repo_identity(args.repo, root)

    bad = set()
    content_scanned = None
    scan_skipped = False
    if args.files is not None:
        paths, bad = read_paths(args.files)
        lines = 0
        changed = None
        content_scanned = False
    elif args.pr is not None:
        paths, bad, lines, changed = pr_inputs(args.pr, args.repo)
        content_scanned = changed is not None
        scan_skipped = changed is None
    elif args.plan and not (args.diff or args.base):
        # A plan is classified before any code exists, so the working tree's
        # diff must not leak into its tier.
        paths, lines, changed, content_scanned = [], 0, None, None
    elif root is None:
        if args.plan:
            paths, lines, changed, content_scanned = [], 0, None, None
        else:
            fail("not a git repository")
    else:
        base = resolve_base(args.base, root)
        paths, bad, lines, changed = diff_inputs(root, base)
        content_scanned = changed is not None
        scan_skipped = changed is None

    result = classify(paths, bad, lines, changed, plan_text, policy, repo, repo_known, content_scanned,
                      args.explain, scan_skipped)
    emit_result(result)

    if args.fail_at and TIER_INDEX[result["tier"]] >= TIER_INDEX[args.fail_at]:
        return EXIT_DENIED
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
