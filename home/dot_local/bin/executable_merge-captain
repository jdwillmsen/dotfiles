# One file per owner, named exactly the owner, holding only that owner's fine-grained token; `<owner>.meta` beside it
# holds what status may show. A fine-grained token is bound to one resource owner, hence one file each.
TOKENS = Path(os.environ.get("MERGE_CAPTAIN_TOKENS")
              or Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config")) / "merge-captain/tokens")
