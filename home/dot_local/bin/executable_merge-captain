#!/usr/bin/python3 -IE
"""merge-captain — classify, review and rebase-merge open pull requests by risk tier.

Walks the configured repositories, classifies each open pull request with
change-class, applies the repository's own gates (checks, review threads,
code scanning), asks the lane agent-pace picks for a review where the tier
needs one, and merges with the head commit pinned. R3 is never merged. Only a
`live` repository is ever written to. Each owner's gh calls use that owner's
fine-grained token when one is saved (`auth`), else the default gh login.
Agent-facing: stdout is TOON, diagnostics go to stderr.
"""
import argparse
import base64
import datetime as dt
