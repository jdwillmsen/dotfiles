# R3 is never mergeable here, so it is not a legal ceiling.
CEILINGS = ("R0", "R1", "R2")
# Anything that moves a tool, a config file or a directory the captain trusts with credentials is an override, so any
# variable with this prefix counts, and so does one added later. Overrides exist for the tests: set in a real run they
# would hand the owner tokens and the App key to whatever they point at, so no credential is loaded.
OVERRIDE_PREFIX = "MERGE_CAPTAIN_"
OVERRIDE_NAMES = ("AGENT_EVAL_STATE", "AGENT_PACE_LANES", "AGENT_EVAL_LANES")
# Default places the XDG variables must not move: they decide where the config, state and tokens are.
XDG_DEFAULTS = (("XDG_CONFIG_HOME", ".config"), ("XDG_STATE_HOME", ".local/state"))
# A test run is one whose tokens and state live under these, never the real home.
TEMP_ROOTS = ("/tmp", "/var/tmp")
# The App that approves on the captain's behalf. Its id, installation id and key sit beside the owner tokens; the
# dots keep these names from ever matching an owner, which cannot contain one.
APPROVER_IDS, APPROVER_KEY = "approver.json", "approver.key"
APPROVER_LOGIN = "merge-captain-approver[bot]"
NO_REVIEW_R0 = "no review required (R0)"
# Providers this tool can run headless. Which of them a review may use is the [reviewers] config.
PROVIDERS = ("claudeAgent", "opencode")
LIMIT_DEFAULTS = {"max_prs_per_run": 20, "max_dry_prs_per_run": 8, "max_prs_per_repo": 4, "max_reviews_per_run": 2,
                  "max_merges_per_hour": 6, "max_approvals_per_hour": 4, "review_timeout_s": 300, "max_diff_bytes": 150000,
                  "max_verifies_per_run": 10, "max_reverts_per_day": 2}
# Below this many calls left in either the REST or the GraphQL budget a run does nothing, so the captain never
# spends the budget other tools on the same login are waiting on.
API_BUDGET_MIN = 500
# Enough for every open pull request of every listed repository many times over; past it the oldest entries go.
EXAMINED_MAX = 2000
