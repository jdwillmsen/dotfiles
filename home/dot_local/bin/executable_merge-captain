MODEL = re.compile(r"[A-Za-z0-9][A-Za-z0-9._:/@-]*")
IDENT = re.compile(r"[A-Za-z0-9][A-Za-z0-9:_.-]{0,63}")
# Trailers that name who wrote a commit: `Assisted-by: <agent>:<model-id> [tools]` and `Co-Authored-By: <name> <mail>`.
ASSISTED_BY = re.compile(r"^\s*assisted-by:\s*[^:\[\]]+?:\s*([A-Za-z0-9][A-Za-z0-9._/@-]*)", re.I)
