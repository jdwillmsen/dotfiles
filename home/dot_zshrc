# Shared config; local.sh is unmanaged machine-local config and stays last
# so its definitions override the managed files.
for f in "$HOME/.config/shell/exports.sh" "$HOME/.config/shell/aliases.sh" "$HOME/.config/shell/functions.sh" "$HOME/.config/shell/local.sh"; do
    [ -r "$f" ] && source "$f"
done

# History
HISTSIZE=10000
SAVEHIST=10000
HISTFILE=~/.zsh_history
setopt HIST_IGNORE_DUPS HIST_IGNORE_SPACE SHARE_HISTORY APPEND_HISTORY

# Completion
autoload -U compinit && compinit
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'

# Directory navigation
setopt AUTO_CD AUTO_PUSHD PUSHD_IGNORE_DUPS

# Prompt — starship supersedes PS1 when present; the literal stays as the fallback
# so a machine without it still gets a readable prompt.
autoload -U colors && colors
PS1="%{$fg[green]%}%n@%m%{$reset_color%}:%{$fg[blue]%}%~%{$reset_color%}%# "
if command -v starship &>/dev/null; then eval "$(starship init zsh)"; fi

# zoxide (provides `z`) registers a chpwd hook, so it needs compinit to have run
if command -v zoxide &>/dev/null; then
    eval "$(zoxide init zsh)"
    # zoxide 0.10.0 emits `cygpath -w "\builtin pwd -L"` in its Windows init: the
    # command substitution is missing, so the hook feeds cygpath a literal and
    # every directory change errors with `not a directory: F:\builtin pwd -L`.
    # Redefining restores the substitution and reseeds the poisoned cached pwd.
    if command -v cygpath >/dev/null 2>&1; then
        __zoxide_pwd() { \command cygpath -w "$(\builtin pwd -L)"; }
        __zoxide_oldpwd="$(__zoxide_pwd)"
    fi
fi

# nvm
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ]          && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# pyenv
if command -v pyenv &>/dev/null; then eval "$(pyenv init -)"; fi

# sdkman (must stay near bottom)
export SDKMAN_DIR="$HOME/.sdkman"
[[ -s "$SDKMAN_DIR/bin/sdkman-init.sh" ]] && source "$SDKMAN_DIR/bin/sdkman-init.sh"

# grok
if [ -d "$HOME/.grok/bin" ]; then
    export PATH="$HOME/.grok/bin:$PATH"
    fpath=(~/.grok/completions/zsh $fpath)
fi
