#!/usr/bin/env bash
set -euo pipefail
# Defaults contributed by dotfiles; existing on-disk (runtime) values win over
# them, except for the ENFORCED keys below.
# env is sized for a 1M-context model: MCP results can be twice the stock 25k
# budget before truncation, and bash gets past the 2min default that long
# builds were clipping. Auto-compact is deliberately left at its ~90% default.
# Subagents default to Sonnet: most fan-out is search and routine edits, and
# this is only the fallback, below the Agent tool's model param and an agent
# definition's own model, so a caller can still ask for Opus.
#
# statusLine defaults only when Go is present — claude-status is built by
# run_onchange_after_20-build-claude-status.sh.tmpl, which needs Go and
# silently no-ops without it. Defaulting to a command that will never exist
# leaves Claude Code pointed at a broken statusline with no obvious signal;
# gating here keeps the two in sync and falls back to Claude Code's own
# default statusline instead. The DOTFILES WARNING prefix is grep-able from
# `chezmoi apply -v` output.
STATUS_LINE_KEYS=""
if command -v go >/dev/null 2>&1; then
    STATUS_LINE_KEYS='
  "statusLine": { "type": "command", "command": "claude-status", "refreshInterval": 10 },
  "subagentStatusLine": { "type": "command", "command": "claude-status -subagents" },'
else
    echo "DOTFILES WARNING: Go not found — claude-status will not be built, leaving statusLine at Claude Code's default" >&2
fi
DEFAULTS='{
  "model": "opus",'"$STATUS_LINE_KEYS"'
  "theme": "dark",
  "cleanupPeriodDays": 90,
  "attribution": { "pr": "" },
  "skipDangerousModePermissionPrompt": true,
  "skipAutoPermissionPrompt": true,
  "env": {
    "MAX_MCP_OUTPUT_TOKENS": "50000",
    "BASH_DEFAULT_TIMEOUT_MS": "180000",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "rtk hook claude" }
        ]
      }
    ]
  }
}'
# ENFORCED keys are the opposite of DEFAULTS: for every sub-key listed here
# the template wins over the on-disk value, so turning a plugin off here
# flips an existing `true` instead of being shadowed by it. Sub-keys not
# listed (plugins installed by hand, the user's own skill overrides) are left
# as they are. Lists are unioned rather than replaced, so a server denied
# locally stays denied. Plugin skills ignore skillOverrides under any key
# spelling, so a single plugin skill is hidden by the skill-trim mod instead.
#
# deniedMcpServers, not disabledMcpServers: the latter is the per-project
# /mcp toggle state Claude Code keeps in ~/.claude.json and is not read from
# settings files. A deny here stops only Claude Code loading the connector;
# it stays connected on claude.ai.
#
# CLAUDE_CODE_PLUGIN_DIRS loads the skill-trim mod in every session, including
# ones started by apps that take no --plugin-dir flag. It is enforced because
# the path is owned here: a stale on-disk value would silently drop the mod.
# Claude Code wants a native path, so Git Bash's /c/... form is converted. The
# path is set inside the python step below so json encodes it, whatever HOME
# contains.
SKILL_TRIM_DIR="$HOME/.claude/mods/skill-trim"
if command -v cygpath >/dev/null 2>&1; then
    SKILL_TRIM_DIR="$(cygpath -w "$SKILL_TRIM_DIR")"
fi
ENFORCED='{
  "deniedMcpServers": [
    { "serverName": "claude.ai Gmail" },
    { "serverName": "claude.ai Atlassian Rovo" }
  ],
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": false,
    "commit-commands@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "gopls-lsp@claude-plugins-official": false,
    "learning-output-style@claude-plugins-official": false,
    "pr-review-toolkit@claude-plugins-official": false,
    "ralph-loop@claude-plugins-official": false,
    "remember@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": false
  },
  "skillOverrides": {
    "lavish": "off"
  }
}'
# REMOVED keys are deleted from the merged result, since the merge otherwise
# keeps every on-disk key forever. These skillOverrides were written to hide
# mattpocock skills before they arrived as a plugin; plugin skills ignore
# skillOverrides, so the entries are dead weight. Only keys listed here go;
# anything else the user added stays.
REMOVED='{
  "skillOverrides": [
    "grill-me", "grill-with-docs", "improve-codebase-architecture",
    "prototype", "setup-matt-pocock-skills", "tdd", "to-issues", "to-prd",
    "triage", "write-a-skill", "zoom-out"
  ]
}'
# chezmoi feeds the current file on our stdin. That stdin is captured here
# (not left connected to python3) because a `python3 - <<PYEOF` heredoc would
# itself occupy stdin as the script source, leaving nothing for the process
# to read the existing file from. Passing the blobs as argv sidesteps that.
EXISTING="$(cat)"
# Windows ships a python3 Store-stub that fails on exec; probe for a real one.
PY=python3
"$PY" -c "" >/dev/null 2>&1 || PY=python
"$PY" -c '
import json, sys
defaults = json.loads(sys.argv[1])
enforced = json.loads(sys.argv[3])
enforced.setdefault("env", {})["CLAUDE_CODE_PLUGIN_DIRS"] = sys.argv[5]
removed = json.loads(sys.argv[4])
raw = sys.argv[2].strip()
existing = json.loads(raw) if raw else {}
def merge(base, override, union_lists=False):
    out = dict(base)
    for k, v in override.items():
        if isinstance(out.get(k), dict) and isinstance(v, dict):
            out[k] = merge(out[k], v, union_lists)
        elif union_lists and isinstance(out.get(k), list) and isinstance(v, list):
            out[k] = out[k] + [x for x in v if x not in out[k]]
        else:
            out[k] = v
    return out
# existing wins over defaults; enforced wins over both
merged = merge(merge(defaults, existing), enforced, union_lists=True)
for section, keys in removed.items():
    for k in keys:
        merged.get(section, {}).pop(k, None)
json.dump(merged, sys.stdout, indent=2)
sys.stdout.write("\n")
' "$DEFAULTS" "$EXISTING" "$ENFORCED" "$REMOVED" "$SKILL_TRIM_DIR"
