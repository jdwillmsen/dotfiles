#!/usr/bin/env bash
set -euo pipefail
# Defaults contributed by dotfiles; existing on-disk (runtime) values always win.
# env is sized for a 1M-context model: MCP results can be twice the stock 25k
# budget before truncation, and bash gets past the 2min default that long
# builds were clipping. Auto-compact is deliberately left at its ~90% default.
#
# statusLine defaults only when Go is present — claude-status is built by
# run_onchange_after_20-build-claude-status.sh.tmpl, which needs Go and
# silently no-ops without it. Defaulting to a command that will never exist
# leaves Claude Code pointed at a broken statusline with no obvious signal;
# gating here keeps the two in sync and falls back to Claude Code's own
# default statusline instead. The DOTFILES WARNING prefix is grep-able from
# `chezmoi apply -v` output.
STATUS_LINE_KEYS=""
if command -v go >/dev/null 2>&1; then
    STATUS_LINE_KEYS='
  "statusLine": { "type": "command", "command": "claude-status", "refreshInterval": 10 },
  "subagentStatusLine": { "type": "command", "command": "claude-status -subagents" },'
else
    echo "DOTFILES WARNING: Go not found — claude-status will not be built, leaving statusLine at Claude Code's default" >&2
fi
DEFAULTS='{
  "model": "opus",'"$STATUS_LINE_KEYS"'
  "theme": "dark",
  "cleanupPeriodDays": 90,
  "skipDangerousModePermissionPrompt": true,
  "skipAutoPermissionPrompt": true,
  "env": {
    "MAX_MCP_OUTPUT_TOKENS": "50000",
    "BASH_DEFAULT_TIMEOUT_MS": "180000"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "rtk hook claude" }
        ]
      }
    ]
  },
  "skillOverrides": {
    "tdd": "off",
    "prototype": "off",
    "grill-me": "off",
    "grill-with-docs": "off",
    "improve-codebase-architecture": "off",
    "to-issues": "off",
    "to-prd": "off",
    "triage": "off",
    "write-a-skill": "off",
    "zoom-out": "off",
    "lavish": "off",
    "setup-matt-pocock-skills": "off"
  }
}'
# chezmoi feeds the current file on our stdin. That stdin is captured here
# (not left connected to python3) because a `python3 - <<PYEOF` heredoc would
# itself occupy stdin as the script source, leaving nothing for the process
# to read the existing file from. Passing both blobs as argv sidesteps that.
EXISTING="$(cat)"
# Windows ships a python3 Store-stub that fails on exec; probe for a real one.
PY=python3
"$PY" -c "" >/dev/null 2>&1 || PY=python
"$PY" -c '
import json, sys
defaults = json.loads(sys.argv[1])
raw = sys.argv[2].strip()
existing = json.loads(raw) if raw else {}
def merge(base, override):
    out = dict(base)
    for k, v in override.items():
        if isinstance(out.get(k), dict) and isinstance(v, dict):
            out[k] = merge(out[k], v)
        else:
            out[k] = v
    return out
# base=defaults, override=existing -> existing keys win, defaults fill gaps
merged = merge(defaults, existing)
json.dump(merged, sys.stdout, indent=2)
sys.stdout.write("\n")
' "$DEFAULTS" "$EXISTING"
