#!/usr/bin/env bash
set -euo pipefail
# Reload trigger — systemd caches unit files, so a chezmoi-applied edit stays
# inert until daemon-reload runs. Re-run whenever a unit or the check changes.
# {{ include "dot_config/systemd/user/t3-session-expiry.service" | sha256sum }}
# {{ include "dot_config/systemd/user/t3-session-expiry.timer" | sha256sum }}
# {{ include "dot_local/bin/executable_t3-session-expiry" | sha256sum }}
if [ "$(uname -s)" != "Linux" ]; then
    echo "t3-session-expiry: not Linux — skipping"
    exit 0
fi
if ! command -v systemctl >/dev/null 2>&1 || ! systemctl --user show-environment >/dev/null 2>&1; then
    echo "t3-session-expiry: no systemd user manager — run ~/.local/bin/t3-session-expiry by hand"
    exit 0
fi

# `systemctl --user` always acts on the real home, never the destination
# chezmoi is applying to, so an apply to a scratch dest (CI, tests/smoke.sh)
# must not reach in and enable a timer for the live user. The user manager
# reports the home it is actually running against; a mismatch means this
# apply is a sandbox one.
manager_home="$(systemctl --user show-environment 2>/dev/null | sed -n 's/^HOME=//p')"
if [ -n "$manager_home" ] && [ "$manager_home" != "$HOME" ]; then
    echo "t3-session-expiry: applying to $HOME, not the user manager's $manager_home — skipping enable"
    exit 0
fi

unit_dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
if [ ! -f "$unit_dir/t3-session-expiry.timer" ]; then
    echo "t3-session-expiry: no unit in $unit_dir — not a home apply, skipping"
    exit 0
fi

systemctl --user daemon-reload
systemctl --user enable --now t3-session-expiry.timer
# Check once now rather than waiting out the first interval: the session this
# was written for may already be inside the window at install time.
systemctl --user start t3-session-expiry.service || true

# Linger is provisioned separately (scripts/provision-persistence.sh) because
# it needs root. Warn rather than duplicate that: without it the user manager
# dies at logout, and a timer that only runs while someone is logged in is
# useless for the case this exists to cover.
if [ "$(loginctl show-user "$USER" -p Linger --value 2>/dev/null)" != "yes" ]; then
    echo "t3-session-expiry: linger is off — the timer stops at logout; run: sudo scripts/provision-persistence.sh"
fi
echo "t3-session-expiry: timer enabled"
