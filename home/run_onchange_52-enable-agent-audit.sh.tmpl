#!/usr/bin/env bash
set -euo pipefail
# Reload trigger — systemd caches unit files, so a chezmoi-applied edit stays
# inert until daemon-reload runs. Re-run whenever a unit changes.
# {{ include "dot_config/systemd/user/agent-audit@.service" | sha256sum }}
# {{ include "dot_config/systemd/user/agent-audit-weekly.timer" | sha256sum }}
# {{ include "dot_config/systemd/user/agent-audit-biweekly.timer" | sha256sum }}
# {{ include "dot_config/systemd/user/agent-audit-monthly.timer" | sha256sum }}
# {{ include "dot_config/systemd/user/agent-audit-quarterly.timer" | sha256sum }}
timers=(agent-audit-weekly.timer agent-audit-biweekly.timer agent-audit-monthly.timer agent-audit-quarterly.timer)

if [ "$(uname -s)" != "Linux" ]; then
    echo "agent-audit: not Linux — skipping"
    exit 0
fi
if ! command -v systemctl >/dev/null 2>&1 || ! systemctl --user show-environment >/dev/null 2>&1; then
    echo "agent-audit: no systemd user manager — run ~/.local/bin/agent-audit by hand"
    exit 0
fi

# `systemctl --user` always acts on the real home, never the destination
# chezmoi is applying to, so a scratch-dest apply (CI, tests/smoke.sh) must
# not enable timers for the live user.
manager_home="$(systemctl --user show-environment 2>/dev/null | sed -n 's/^HOME=//p')"
if [ -n "$manager_home" ] && [ "$manager_home" != "$HOME" ]; then
    echo "agent-audit: applying to $HOME, not the user manager's $manager_home — skipping enable"
    exit 0
fi

unit_dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
if [ ! -f "$unit_dir/agent-audit@.service" ]; then
    echo "agent-audit: no unit in $unit_dir — not a home apply, skipping"
    exit 0
fi

systemctl --user daemon-reload
# Deliberately no immediate start: every run files a Jira task, so the first
# one waits for its calendar slot. Persistent= has no stamp yet on a fresh
# enable, so enabling does not trigger a catch-up run either.
systemctl --user enable --now "${timers[@]}"

if [ "$(loginctl show-user "$USER" -p Linger --value 2>/dev/null)" != "yes" ]; then
    echo "agent-audit: linger is off — timers stop at logout; run: sudo scripts/provision-persistence.sh"
fi
echo "agent-audit: timers enabled"
