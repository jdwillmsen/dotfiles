#!/usr/bin/env bash
set -euo pipefail
# Reload trigger — systemd caches unit files, so a chezmoi-applied edit stays
# inert until daemon-reload runs. Re-run whenever a unit changes.
# {{ include "dot_config/systemd/user/agent-metrics-collect.service" | sha256sum }}
# {{ include "dot_config/systemd/user/agent-metrics-collect.timer" | sha256sum }}

if [ "$(uname -s)" != "Linux" ]; then
    echo "agent-metrics: not Linux — skipping"
    exit 0
fi
if ! command -v systemctl >/dev/null 2>&1 || ! systemctl --user show-environment >/dev/null 2>&1; then
    echo "agent-metrics: no systemd user manager — run ~/.local/bin/agent-metrics collect by hand"
    exit 0
fi

# `systemctl --user` always acts on the real home, never the destination
# chezmoi is applying to, so a scratch-dest apply (CI, tests/smoke.sh) must
# not enable timers for the live user.
manager_home="$(systemctl --user show-environment 2>/dev/null | sed -n 's/^HOME=//p')"
if [ -n "$manager_home" ] && [ "$manager_home" != "$HOME" ]; then
    echo "agent-metrics: applying to $HOME, not the user manager's $manager_home — skipping enable"
    exit 0
fi

unit_dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
if [ ! -f "$unit_dir/agent-metrics-collect.service" ]; then
    echo "agent-metrics: no unit in $unit_dir — not a home apply, skipping"
    exit 0
fi

systemctl --user daemon-reload
# Deliberately no immediate start: the first run should be the manual
# backfill, whose counts are worth reading before the timer takes over.
systemctl --user enable --now agent-metrics-collect.timer

if [ "$(loginctl show-user "$USER" -p Linger --value 2>/dev/null)" != "yes" ]; then
    echo "agent-metrics: linger is off — the timer stops at logout; run: sudo scripts/provision-persistence.sh"
fi
if [ ! -d "${AGENT_METRICS_STORE:-${XDG_DATA_HOME:-$HOME/.local/share}/agent-metrics/store}/.git" ]; then
    echo "agent-metrics: the store is not cloned — run: agent-metrics init && agent-metrics collect --since 90"
fi
echo "agent-metrics: timer enabled"
