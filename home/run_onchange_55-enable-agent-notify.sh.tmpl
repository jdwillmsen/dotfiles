#!/usr/bin/env bash
set -euo pipefail
# Reload trigger — systemd caches unit files, so a chezmoi-applied edit stays
# inert until daemon-reload runs. Re-run whenever a unit changes.
# {{ include "dot_config/systemd/user/agent-notify.service" | sha256sum }}
# {{ include "dot_config/systemd/user/agent-notify.timer" | sha256sum }}
# {{ include "dot_config/systemd/user/agent-trends.service" | sha256sum }}
# {{ include "dot_config/systemd/user/agent-trends.timer" | sha256sum }}

if [ "$(uname -s)" != "Linux" ]; then
    echo "agent-notify: not Linux — skipping"
    exit 0
fi
if ! command -v systemctl >/dev/null 2>&1 || ! systemctl --user show-environment >/dev/null 2>&1; then
    echo "agent-notify: no systemd user manager — run agent-notify send and agent-trends build by hand"
    exit 0
fi

# `systemctl --user` always acts on the real home, never the destination
# chezmoi is applying to, so a scratch-dest apply (CI, tests/smoke.sh) must
# not enable timers for the live user.
manager_home="$(systemctl --user show-environment 2>/dev/null | sed -n 's/^HOME=//p')"
if [ -n "$manager_home" ] && [ "$manager_home" != "$HOME" ]; then
    echo "agent-notify: applying to $HOME, not the user manager's $manager_home — skipping enable"
    exit 0
fi

unit_dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
if [ ! -f "$unit_dir/agent-notify.service" ]; then
    echo "agent-notify: no unit in $unit_dir — not a home apply, skipping"
    exit 0
fi

systemctl --user daemon-reload
# No immediate start: both read the store and the daily report, which may not
# exist yet on a fresh box.
systemctl --user enable --now agent-notify.timer agent-trends.timer

if [ "$(loginctl show-user "$USER" -p Linger --value 2>/dev/null)" != "yes" ]; then
    echo "agent-notify: linger is off — the timers stop at logout; run: sudo scripts/provision-persistence.sh"
fi
echo "agent-notify: notify and trends timers enabled"
