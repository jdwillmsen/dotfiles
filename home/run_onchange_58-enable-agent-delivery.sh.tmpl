#!/usr/bin/env bash
set -euo pipefail
# Reload trigger — systemd caches unit files, so a chezmoi-applied edit stays
# inert until daemon-reload runs. Re-run whenever a unit changes.
# {{ include "dot_config/systemd/user/merge-captain.service" | sha256sum }}
# {{ include "dot_config/systemd/user/merge-captain.timer" | sha256sum }}
# {{ include "dot_config/systemd/user/agent-eval-collect.service" | sha256sum }}
# {{ include "dot_config/systemd/user/agent-eval-collect.timer" | sha256sum }}
timers=(merge-captain.timer agent-eval-collect.timer)

if [ "$(uname -s)" != "Linux" ]; then
    echo "agent-delivery: not Linux — skipping"
    exit 0
fi
if ! command -v systemctl >/dev/null 2>&1 || ! systemctl --user show-environment >/dev/null 2>&1; then
    echo "agent-delivery: no systemd user manager — run ~/.local/bin/merge-captain run by hand"
    exit 0
fi

# `systemctl --user` always acts on the real home, never the destination
# chezmoi is applying to, so a scratch-dest apply (CI, tests/smoke.sh) must
# not enable timers for the live user.
manager_home="$(systemctl --user show-environment 2>/dev/null | sed -n 's/^HOME=//p')"
if [ -n "$manager_home" ] && [ "$manager_home" != "$HOME" ]; then
    echo "agent-delivery: applying to $HOME, not the user manager's $manager_home — skipping enable"
    exit 0
fi

unit_dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
if [ ! -f "$unit_dir/merge-captain.service" ]; then
    echo "agent-delivery: no unit in $unit_dir — not a home apply, skipping"
    exit 0
fi

systemctl --user daemon-reload
# Enabling --now starts the timers, which wait for their calendar slot; no run
# starts until then. merge-captain is live only for the repositories its config
# marks live, and its caps and kill switch (merge-captain pause) bound it.
systemctl --user enable --now "${timers[@]}"

if [ "$(loginctl show-user "$USER" -p Linger --value 2>/dev/null)" != "yes" ]; then
    echo "agent-delivery: linger is off — the timers stop at logout; run: sudo scripts/provision-persistence.sh"
fi
echo "agent-delivery: timers enabled"
