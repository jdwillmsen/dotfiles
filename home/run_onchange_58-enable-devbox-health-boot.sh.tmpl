#!/usr/bin/env bash
set -euo pipefail
# Reload trigger — systemd caches unit files, so a chezmoi-applied edit stays
# inert until daemon-reload runs. Re-run whenever a unit or the check changes.
# {{ include "dot_config/systemd/user/devbox-health-boot.service" | sha256sum }}
# {{ include "dot_config/systemd/user/devbox-health-boot.timer" | sha256sum }}
# {{ include "dot_local/bin/executable_devbox-health-boot" | sha256sum }}
if [ "$(uname -s)" != "Linux" ]; then
    echo "devbox-health-boot: not Linux — skipping"
    exit 0
fi
if ! command -v systemctl >/dev/null 2>&1 || ! systemctl --user show-environment >/dev/null 2>&1; then
    echo "devbox-health-boot: no systemd user manager — run ~/.local/bin/devbox-health-boot by hand"
    exit 0
fi

# `systemctl --user` always acts on the real home, never the destination
# chezmoi is applying to, so an apply to a scratch dest (CI, tests/smoke.sh)
# must not reach in and enable a timer for the live user. The user manager
# reports the home it is actually running against; a mismatch means this
# apply is a sandbox one.
manager_home="$(systemctl --user show-environment 2>/dev/null | sed -n 's/^HOME=//p')"
if [ -n "$manager_home" ] && [ "$manager_home" != "$HOME" ]; then
    echo "devbox-health-boot: applying to $HOME, not the user manager's $manager_home — skipping enable"
    exit 0
fi

unit_dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
if [ ! -f "$unit_dir/devbox-health-boot.timer" ]; then
    echo "devbox-health-boot: no unit in $unit_dir — not a home apply, skipping"
    exit 0
fi

systemctl --user daemon-reload
# enable, not --now: the timer counts from the user manager's start, which on
# a running box is long past, so it first fires at the next boot as intended.
systemctl --user enable devbox-health-boot.timer

# Linger is provisioned separately (scripts/provision-persistence.sh) because
# it needs root. Warn rather than duplicate that: without it the user manager
# does not start at boot until someone logs in, and the check this exists for
# is the one nobody is logged in to see.
if [ "$(loginctl show-user "$USER" -p Linger --value 2>/dev/null)" != "yes" ]; then
    echo "devbox-health-boot: linger is off — the post-boot check never runs unattended; run: sudo scripts/provision-persistence.sh"
fi
echo "devbox-health-boot: timer enabled"
